{
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**"
    }
  },
  "redirects": [
    { "source": "/tool/:slug*", "destination": "/tools/:slug*", "statusCode": 301 },
    { "source": "/zh/tool/:slug*", "destination": "/zh/tools/:slug*", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
