{
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**"
    }
  },
  "redirects": [
    { "source": "https://www.thebestaitoolsreview.com/:path*", "destination": "https://thebestaitoolsreview.com/:path*", "statusCode": 301 },
    { "source": "/tool/:slug*", "destination": "/tools/:slug*", "statusCode": 301 },
    { "source": "/zh/tool/:slug*", "destination": "/zh/tools/:slug*", "statusCode": 301 },
    { "source": "/deep-dive-claude/", "destination": "/blog/claude-vs-gemini-vs-chatgpt-2026/", "statusCode": 301 },
    { "source": "/zh/deep-dive-claude/", "destination": "/zh/blog/claude-vs-gemini-vs-chatgpt-2026/", "statusCode": 301 },
    { "source": "/prompts/any-cicd/", "destination": "/prompts/", "statusCode": 301 },
    { "source": "/prompts/any-etl-spec2/", "destination": "/prompts/", "statusCode": 301 },
    { "source": "/prompts/any-kb-structure/", "destination": "/prompts/", "statusCode": 301 },
    { "source": "/prompts/any-react-pat/", "destination": "/prompts/", "statusCode": 301 },
    { "source": "/prompts/chatgpt-biz-plan/", "destination": "/prompts/", "statusCode": 301 },
    { "source": "/prompts/cursor-worker/", "destination": "/prompts/", "statusCode": 301 },
    { "source": "/prompts/mj-landscape/", "destination": "/prompts/", "statusCode": 301 },
    { "source": "/zh/prompts/any-cicd/", "destination": "/zh/prompts/", "statusCode": 301 },
    { "source": "/zh/prompts/any-etl-spec2/", "destination": "/zh/prompts/", "statusCode": 301 },
    { "source": "/zh/prompts/any-kb-structure/", "destination": "/zh/prompts/", "statusCode": 301 },
    { "source": "/zh/prompts/any-react-pat/", "destination": "/zh/prompts/", "statusCode": 301 },
    { "source": "/zh/prompts/chatgpt-biz-plan/", "destination": "/zh/prompts/", "statusCode": 301 },
    { "source": "/zh/prompts/cursor-worker/", "destination": "/zh/prompts/", "statusCode": 301 },
    { "source": "/zh/prompts/mj-landscape/", "destination": "/zh/prompts/", "statusCode": 301 },
    { "source": "/:path((?!.*\\.)[^?#]+[^/])", "destination": "/:path/", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.svg" },
    { "source": "/favicon.png", "destination": "/favicon.svg" },
    { "source": "/icon/favicon.ico", "destination": "/favicon.svg" },
    { "source": "/static/favicon.ico", "destination": "/favicon.svg" },
    { "source": "/img/favicon.ico", "destination": "/favicon.svg" },
    { "source": "/images/favicon.ico", "destination": "/favicon.svg" },
    { "source": "/assets/favicon.ico", "destination": "/favicon.svg" },
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
