---
const { score, recommendation, title = "Our Verdict" } = Astro.props;
const color = score >= 8 ? "var(--green)" : score >= 6 ? "var(--amber)" : "var(--red)";
---
<div class="verdict-box">
  <h3>{title}</h3>
  <div class="verdict-score" style={`color: ${color}`}>{score}<span>/10</span></div>
  <p>{recommendation}</p>
</div>
<style>
.verdict-box { background: var(--bg-muted); border: 1px solid var(--border); border-radius: 16px; padding: 24px; text-align: center; margin: 24px 0; }
.verdict-box h3 { font-size: 18px; font-weight: 700; margin-bottom: 12px; }
.verdict-score { font-size: 48px; font-weight: 800; line-height: 1; margin-bottom: 12px; }
.verdict-score span { font-size: 20px; color: var(--text-secondary); }
.verdict-box p { font-size: 16px; color: var(--text-secondary); line-height: 1.7; max-width: 600px; margin: 0 auto; }
</style>
