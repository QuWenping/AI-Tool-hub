---
const { heading, content, tools = [] } = Astro.props;
const list = (tools || []).filter(x => x && x.id);
---
<section class="solution-section">
  {heading && <h2 class="solution-section-heading">{heading}</h2>}
  {content && <p class="solution-section-content" set:html={content}></p>}
  {list.length > 0 && (
    <div class="solution-section-tools">
      <span class="solution-section-tools-label">Recommended tools</span>
      <div class="solution-section-tools-list">
        {list.map(t => (
          <a class="solution-section-tool-chip" href={`/tool/${t.id}/`}>
            <i class={`fas ${t.icon || "fa-robot"}`} aria-hidden="true"></i>
            <span>{t.name || t.id}</span>
          </a>
        ))}
      </div>
    </div>
  )}
</section>
