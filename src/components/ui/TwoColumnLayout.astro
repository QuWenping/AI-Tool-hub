---
<div class="layout-two-col">
  <main class="layout-article"><slot /></main>
  <aside class="layout-toc"><slot name="toc" /></aside>
</div>
<style>
.layout-two-col { display: grid; grid-template-columns: var(--w-article) var(--w-toc); gap: var(--gap-layout); max-width: calc(var(--w-article) + var(--w-toc) + var(--gap-layout)); margin: 0 auto; padding: 0 24px; }
.layout-article { min-width: 0; }
.layout-toc { position: sticky; top: 24px; align-self: start; max-height: calc(100vh - 48px); overflow-y: auto; }
@media (max-width: 1023px) { .layout-two-col { grid-template-columns: 1fr; max-width: 760px; } .layout-toc { display: none; } }
</style>
