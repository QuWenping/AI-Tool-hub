---
const { category, title, summary, heroImage, author, date, readTime } = Astro.props;
import MetadataBar from "./ui/MetadataBar.astro";
---
<header class="hero-section">
  {category && <span class="eyebrow">{category}</span>}
  <h1>{title}</h1>
  {summary && <p class="hero-summary">{summary}</p>}
  <MetadataBar author={author} date={date} readTime={readTime} />
  {heroImage && <img src={heroImage} alt={title} class="hero-img" loading="eager" />}
</header>
<style>
.hero-section { padding: 96px 0 72px; }
.eyebrow { display: inline-block; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--brand); margin-bottom: 16px; }
h1 { font-size: var(--fs-h1-d); font-weight: var(--fw-h1); line-height: var(--lh-heading); margin-bottom: 16px; }
.hero-summary { font-size: 22px; color: var(--text-secondary); line-height: var(--lh-body); max-width: 640px; margin-bottom: 24px; }
.hero-img { width: 100%; aspect-ratio: 16/9; border-radius: var(--r-xl); box-shadow: var(--shadow-md); object-fit: cover; margin-top: 32px; }
@media (max-width: 1280px) { h1 { font-size: var(--fs-h1-m); } }
@media (max-width: 768px) { h1 { font-size: var(--fs-h1-m); } .hero-summary { font-size: 18px; } .hero-section { padding: 48px 0 36px; } }
</style>
