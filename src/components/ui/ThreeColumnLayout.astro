---
const { sidebar, toc } = Astro.props;
---
<div class="layout-three-col">
  {sidebar && <aside class="layout-sidebar"><slot name="sidebar" /></aside>}
  <main class="layout-article"><slot /></main>
  {toc && <aside class="layout-toc"><slot name="toc" /></aside>}
</div>
<style>
.layout-three-col { display: grid; grid-template-columns: var(--w-sidebar) var(--w-article) var(--w-toc); gap: var(--gap-layout); max-width: var(--max-w); margin: 0 auto; padding: 0 24px; }
.layout-sidebar { position: sticky; top: 24px; align-self: start; max-height: calc(100vh - 48px); overflow-y: auto; }
.layout-article { min-width: 0; }
.layout-toc { position: sticky; top: 24px; align-self: start; }
@media (max-width: 1279px) { .layout-three-col { grid-template-columns: var(--w-article) var(--w-toc); } .layout-sidebar { display: none; } }
@media (max-width: 1023px) { .layout-three-col { grid-template-columns: 1fr; max-width: 760px; } .layout-sidebar, .layout-toc { display: none; } }
</style>
