---
const { name, avatar = '', bio = '', role = '' } = Astro.props;
---
<div class=\"author-card\">
  <div class=\"author-avatar\">
    {avatar && <img src={avatar} alt={name} class=\"avatar-img\" />}
  </div>
  <div class=\"author-info\">
    <h3 class=\"author-name\">{name}</h3>
    {role && <p class=\"author-role\">{role}</p>}
    {bio && <p class=\"author-bio\">{bio}</p>}
  </div>
</div>
<style>
.author-card {
  display: flex;
  align-items: center;
  gap: var(--s-4);
  background: var(--bg-card);
  border-radius: var(--r-lg);
  padding: var(--s-6);
  box-shadow: var(--shadow-sm);
}
.author-avatar {
  flex-shrink: 0;
}
.avatar-img {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--border);
}
.author-info {
  display: flex;
  flex-direction: column;
}
.author-name {
  margin: 0 0 var(--s-2) 0;
  font-size: var(--fs-h4);
  font-weight: var(--fw-semibold);
  color: var(--text);
}
.author-role {
  margin: 0 0 var(--s-2) 0;
  font-size: var(--fs-body);
  color: var(--text-secondary);
  font-style: italic;
}
.author-bio {
  margin: 0;
  font-size: var(--fs-body);
  color: var(--text);
  line-height: var(--lh-body);
}
</style>
