---
const { workflow } = Astro.props;
if (!workflow || !workflow.slug) return null;
const steps = (workflow.steps && workflow.steps.length) || 0;
---
<a class="workflow-card" href={`/workflows/${workflow.slug}/`}>
  <div class="workflow-card-head">
    <span class="workflow-card-tool">{workflow.tool || "Workflow"}</span>
    {workflow.difficulty && <span class="workflow-card-difficulty">{workflow.difficulty}</span>}
  </div>
  <h3 class="workflow-card-title">{workflow.title}</h3>
  {workflow.description && <p class="workflow-card-desc">{workflow.description}</p>}
  <div class="workflow-card-meta">
    {steps > 0 && <span><i class="fas fa-list-ol" aria-hidden="true"></i> {steps} steps</span>}
    <span class="workflow-card-cta">Open workflow →</span>
  </div>
</a>
