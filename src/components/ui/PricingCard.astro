---
const { title = '', price = '', period = '/mo', features = [], buttonText = 'Choose', buttonUrl = '#', recommended = false } = Astro.props;
---
<div class=\"pricing-card\" class:recommended={recommended}>
  {recommended && <span class=\"badge\">Most Popular</span>}
  <div class=\"pricing-header\">
    <h3 class=\"plan-title\">{title}</h3>
    <div class=\"price\">
      <span class=\"currency\">$</span><span class=\"amount\">{price}</span><span class=\"period\">{period}</span>
    </div>
  </div>
  <ul class=\"features-list\">
    {features.map(f => (
      <li class=\"feature-item\">✅ {f}</li>
    ))}
  </ul>
  <a href={buttonUrl} class=\"btn btn-primary btn-block\">{buttonText}</a>
</div>
<style>
.pricing-card {
  background: var(--bg-card);
  border-radius: var(--r-lg);
  padding: var(--s-6);
  box-shadow: var(--shadow-md);
  text-align: center;
  transition: transform 0.2s, box-shadow 0.2s;
}
.pricing-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
}
.pricing-card.recommended {
  border: 2px solid var(--brand);
}
.badge {
  position: absolute;
  top: -10px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--brand);
  color: #fff;
  font-size: var(--fs-xs);
  padding: var(--s-1) var(--s-3);
  border-radius: var(--r-sm);
  font-weight: var(--fw-bold);
}
.pricing-header {
  margin-bottom: var(--s-4);
}
.plan-title {
  margin: 0;
  font-size: var(--fs-h4);
  font-weight: var(--fw-semibold);
  color: var(--text);
}
.price {
  display: inline-flex;
  align-items: baseline;
  gap: var(--s-1);
  margin-bottom: var(--s-4);
}
.currency {
  font-size: var(--fs-sm);
  font-weight: var(--fw-normal);
}
.amount {
  font-size: var(--fs-h2);
  font-weight: var(--fw-bold);
  color: var(--brand);
}
.period {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}
.features-list {
  list-style: none;
  padding: 0;
  margin: 0 0 var(--s-6) 0;
  text-align: left;
}
.feature-item {
  margin: var(--s-2) 0;
  font-size: var(--fs-body);
  color: var(--text);
  display: flex;
  align-items: center;
  gap: var(--s-2);
}
.feature-item::before {
  content: '✅';
}
.btn-primary {
  background: var(--brand);
  color: #fff;
  border: none;
  padding: var(--s-3) var(--s-6);
  font-size: var(--fs-body);
  font-weight: var(--fw-semibold);
  border-radius: var(--r-md);
  cursor: pointer;
  text-decoration: none;
  display: inline-block;
  width: 100%;
  box-sizing: border-box;
}
.btn-primary:hover {
  background: var(--brand-dark);
}
.btn-block {
  width: 100%;
}
</style>
