---
const { pros = [], cons = [] } = Astro.props;
---
<div class="pros-cons">
  <div class="pros-box">
    <h4>Pros</h4>
    <ul>{pros.map(p => <li>{p}</li>)}</ul>
  </div>
  <div class="cons-box">
    <h4>Cons</h4>
    <ul>{cons.map(c => <li>{c}</li>)}</ul>
  </div>
</div>
<style>
.pros-cons { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 24px 0; }
.pros-box { background: var(--green-bg); border: 1px solid var(--green-border); border-radius: 12px; padding: 16px; }
.cons-box { background: var(--red-bg); border: 1px solid var(--red-border); border-radius: 12px; padding: 16px; }
.pros-box h4 { color: var(--green); margin-bottom: 8px; font-size: 15px; }
.cons-box h4 { color: var(--red); margin-bottom: 8px; font-size: 15px; }
.pros-box ul, .cons-box ul { list-style: none; padding: 0; }
.pros-box li, .cons-box li { font-size: 14px; color: var(--text-secondary); padding: 4px 0; display: flex; gap: 8px; align-items: start; }
.pros-box li::before { content: "✅"; font-size: 14px; flex-shrink: 0; }
.cons-box li::before { content: "❌"; font-size: 14px; flex-shrink: 0; }
@media (max-width: 768px) { .pros-cons { grid-template-columns: 1fr; } }
</style>
