---
const { name, category, icon = 'fa-robot', rating = 0, pricing = '', desc = '', href = '#' } = Astro.props;
---
<a href={href} class=\"tool-card\" data-category={category}>
  <div class=\"card-content\">
    <div class=\"tool-icon\">
      <i class={icon} aria-hidden=\"true\"></i>
    </div>
    <div class=\"tool-info\">
      <h3 class=\"tool-title\">{name}</h3>
      <p class=\"tool-desc\">{desc}</p>
      <div class=\"tool-meta\">
        <span class=\"tag tag-category\">{category}</span>
        {rating > 0 && (
          <span class=\"rating\">
            <span class=\"stars\" aria-label=\"Rating {rating} out of 5\">
              {'★'.repeat(Math.floor(rating))}
            </span>
            <span class=\"rating-number\" aria-hidden=\"true\">({rating.toFixed(1)})</span>
          </span>
        )}
        {pricing && <span class=\"price-tag\">{pricing}</span>}
      </div>
    </div>
    <div class=\"tool-action\">
      <span class=\"arrow\">→</span>
    </div>
  </div>
</a>
<style>
.tool-card {
  display: block;
  text-decoration: none;
  color: inherit;
  background: var(--bg-card);
  border-radius: var(--r-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  height: 100%;
  display: flex;
  flex-direction: column;
}
.tool-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
  border-color: var(--brand);
}
.card-content {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  padding: var(--s-6);
}
.tool-icon {
  flex-shrink: 0;
  width: 48px;
  height: 48px;
  margin-bottom: var(--s-4);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-bg);
  border-radius: var(--r-sm);
}
.tool-icon i {
  font-size: 1.5rem;
  color: var(--brand);
}
.tool-info {
  flex: 1 1 auto;
}
.tool-title {
  margin: 0 0 var(--s-2) 0;
  font-size: var(--fs-h4);
  font-weight: var(--fw-bold);
  color: var(--text);
  line-height: 1.3;
}
.tool-desc {
  margin: 0 0 var(--s-4) 0;
  font-size: var(--fs-body);
  color: var(--text-secondary);
  line-height: var(--lh-body);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.tool-meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-3);
  margin-bottom: var(--s-4);
  align-items: center;
}
.tag-category {
  background: var(--bg-muted);
  color: var(--text);
  padding: var(--s-1) var(--s-3);
  border-radius: var(--r-sm);
  font-size: var(--fs-xs);
  font-weight: var(--fw-medium);
}
.rating {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  font-size: var(--fs-xs);
}
.stars {
  color: var(--amber);
  font-size: var(--fs-sm);
}
.rating-number {
  color: var(--text);
}
.price-tag {
  background: var(--green-bg);
  color: var(--green);
  padding: var(--s-1) var(--s-3);
  border-radius: var(--r-sm);
  font-size: var(--fs-xs);
  font-weight: var(--fw-medium);
  border: 1px solid var(--green-border);
}
.tool-action {
  margin-top: auto;
  padding-top: var(--s-3);
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: var(--s-2);
}
.arrow {
  font-size: var(--fs-lg);
  color: var(--brand);
  transition: transform 0.2s;
}
.tool-card:hover .arrow {
  transform: translateX(4px);
}
</style>
