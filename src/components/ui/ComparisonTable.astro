---
const { headers = [], rows = [] } = Astro.props;
---
<table class=\"comparison-table\">
  <thead>
    <tr>
      <th></th>
      {headers.map(h => (<th>{h}</th>))}
    </tr>
  </thead>
  <tbody>
    {rows.map((row, rowIdx) => (
      <tr>
        <th class=\"row-label\">{row[0]}</th>
        {row.slice(1).map((cell, colIdx) => (<td>{cell}</td>))}
      </tr>
    ))}
  </tbody>
</table>
<style>
.comparison-table {
  width: 100%;
  border-collapse: collapse;
  margin: var(--s-4) 0;
  font-size: var(--fs-body);
}
.comparison-table th,
.comparison-table td {
  padding: var(--s-3) var(--s-4);
  border: 1px solid var(--border);
  text-align: left;
}
.comparison-table th {
  background: var(--bg-muted);
  font-weight: var(--fw-bold);
  color: var(--text);
}
.comparison-table td {
  background: var(--bg);
}
.comparison-table th.row-label {
  background: var(--bg-muted);
  font-weight: var(--fw-mid);
  text-align: left;
}
.comparison-table tbody tr:nth-child(even) td {
  background: var(--bg-muted);
}
</style>
