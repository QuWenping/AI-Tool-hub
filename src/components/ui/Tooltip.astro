---
const { children, placement = 'top' } = Astro.props;
---
<div class="tooltip-wrapper" data-placement={placement}>
  <span class="tooltip-trigger">{children}</span>
  <span class="tooltip-text">{children}</span>
</div>
<style>
.tooltip-wrapper {
  position: relative;
  display: inline-block;
}
.tooltip-trigger {
  cursor: help;
  border-bottom: 1px dotted var(--text-secondary);
}
.tooltip-text {
  visibility: hidden;
  width: max-content;
  max-width: 200px;
  background: var(--bg-card);
  color: var(--text);
  text-align: center;
  border-radius: var(--r-sm);
  padding: var(--s-2) var(--s-4);
  position: absolute;
  z-index: 10;
  bottom: 125%;
  left: 50%;
  transform: translateX(-50%);
  opacity: 0;
  transition: opacity 0.2s;
  font-size: var(--fs-xs);
  line-height: var(--lh-tight);
  box-shadow: var(--shadow-md);
}
.tooltip-wrapper:hover .tooltip-text {
  visibility: visible;
  opacity: 1;
}
/* Arrow */
.tooltip-text::after {
  content: "";
  position: absolute;
  top: 100%;
  left: 50%;
  margin-left: -5px;
  border-width: 5px;
  border-style: solid;
  border-color: var(--bg-card) transparent transparent transparent;
}
</style>
