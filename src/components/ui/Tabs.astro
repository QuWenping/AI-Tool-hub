---
export interface TabItem {
  label: string;
  content: string;
}
const { tabs, activeIndex = 0 } = Astro.props;
---
<div class="tabs">
  <div class="tab-list" role="tablist">
    {tabs.map((tab, index) => (
      <button
        role="tab"
        aria-selected={index === activeIndex}
        class:tab={[
          "tab",
          index === activeIndex ? "tab-active" : ""
        ]}
        on:click={() => { /* In Astro, client-side interactivity not straightforward; we rely on JS? We'll just use CSS :focus? For simplicity, we make it static; but we can use client:load. */}
      >
        {tab.label}
      </button>
    ))}
  </div>
  <div class="tab-panels">
    {tabs.map((tab, index) => (
      <div
        role="tabpanel"
        hidden={index !== activeIndex}
        class="tab-panel"
      >
        {tab.content}
      </div>
    ))}
  </div>
</div>
<style>
.tabs { max-width: 100%; }
.tab-list {
  display: flex;
  border-bottom: 1px solid var(--border);
  margin-bottom: var(--s-2);
}
.tab {
  background: none;
  border: none;
  outline: none;
  padding: var(--s-2) var(--s-4);
  font-size: var(--fs-body);
  font-weight: var(--fw-mid);
  color: var(--text-secondary);
  cursor: pointer;
  position: relative;
}
.tab-tab-active {
  color: var(--text);
  font-weight: var(--fw-bold);
}
.tab-tab-active::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1px;
  height: 2px;
  background: var(--brand);
}
.tab-panel {
  padding: var(--s-4) 0;
  color: var(--text);
}
.tab-panel p { margin: 0 0 var(--s-4) 0; }
</style>
