---
/**
 * Comments.astro - Giscus comment system component
 * Based on GitHub Discussions - zero cost, auto-sync, serverless
 *
 * Setup steps:
 * 1. Install Giscus app at https://github.com/settings/apps
 * 2. Configure at https://giscus.app to get data-* attributes
 * 3. Replace repo / repoId / category / categoryId below
 */
const { lang = "en" } = Astro.props;

// Theme auto-switches based on current theme
const lightTheme = "light";
const darkTheme = "dark_dimmed";
const giscusTheme = "no";  // Placeholder, JS will switch dynamically

// Giscus config (replace with real values in production)
// Configure at https://giscus.app
// 1. Enter repo: QuWenping/AI-Tool-hub
// 2. Discussion category: Comments
// 3. Copy data-repo-id and data-category-id
const giscusConfig = {
  "data-repo": "QuWenping/AI-Tool-hub",
  "data-repo-id": "R_kgDOSPanaQ",
  "data-category": "Comments",
  "data-category-id": "DIC_kwDOSPanac4DA-kr",
  "data-mapping": "pathname",
  "data-strict": "0",
  "data-reactions-enabled": "1",
  "data-emit-metadata": "0",
  "data-input-position": "top",
  "data-theme": giscusTheme,
  "data-lang": lang,
  "data-loading": "lazy",
  crossorigin: "anonymous",
  async: ""
};
---
<section class="comments-section">
  <h2 data-i18n-en="Comments">Comments</h2>
  <p class="comments-desc" data-i18n-en="Discuss this article. Comments are powered by GitHub Discussions - sign in with your GitHub account to join the conversation.">Discuss this article. Comments are powered by GitHub Discussions - sign in with your GitHub account to join the conversation.</p>
  <script
    src="https://giscus.app/client.js"
    data-repo={giscusConfig["data-repo"]}
    data-repo-id={giscusConfig["data-repo-id"]}
    data-category={giscusConfig["data-category"]}
    data-category-id={giscusConfig["data-category-id"]}
    data-mapping={giscusConfig["data-mapping"]}
    data-strict={giscusConfig["data-strict"]}
    data-reactions-enabled={giscusConfig["data-reactions-enabled"]}
    data-emit-metadata={giscusConfig["data-emit-metadata"]}
    data-input-position={giscusConfig["data-input-position"]}
    data-theme={giscusConfig["data-theme"]}
    data-lang={giscusConfig["data-lang"]}
    data-loading={giscusConfig["data-loading"]}
    crossorigin={giscusConfig.crossorigin}
    async={giscusConfig.async}
  ></script>
  <noscript>
    <p class="comments-fallback" data-i18n-en="Please enable JavaScript to view comments.">Please enable JavaScript to view comments.</p>
  </noscript>
</section>

<style>
.comments-section :global(.giscus-frame) {
  width: 100% !important;
  border: none !important;
}
</style>
