---
// Cookie consent banner — 中文
---

<div id="cookie-consent" class="cc-banner" hidden>
  <div class="cc-container">
    <p class="cc-text">
      本网站使用 Cookie 来改善您的浏览体验。继续使用即表示您同意我们的
      <a href="/zh/privacy/">隐私政策</a>和<a href="/zh/terms/">服务条款</a>。
    </p>
    <div class="cc-actions">
      <button id="cc-decline" class="cc-btn cc-btn-decline" type="button">拒绝</button>
      <button id="cc-accept" class="cc-btn cc-btn-accept" type="button">全部接受</button>
    </div>
  </div>
</div>

<style>
  .cc-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 10000;
    background: #111827;
    color: #f9fafb;
    padding: 16px 0;
    animation: ccFadeIn 0.4s ease-out;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.3);
  }

  @keyframes ccFadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .cc-banner[hidden] { display: none; }

  .cc-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .cc-text {
    flex: 1;
    min-width: 240px;
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }

  .cc-text a {
    color: #93c5fd;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cc-text a:hover { color: #bfdbfe; }

  .cc-actions {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }

  .cc-btn {
    padding: 10px 20px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: opacity 0.15s, background-color 0.15s;
    white-space: nowrap;
  }

  .cc-btn:hover { opacity: 0.9; }

  .cc-btn-accept {
    background: #3b82f6;
    color: #fff;
  }

  .cc-btn-accept:hover { background: #2563eb; }

  .cc-btn-decline {
    background: transparent;
    color: #d1d5db;
    border: 1px solid #4b5563;
  }

  .cc-btn-decline:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: #6b7280;
  }

  @media (max-width: 640px) {
    .cc-container {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 0 16px;
    }

    .cc-text {
      text-align: center;
      font-size: 13px;
    }

    .cc-actions {
      flex-direction: column;
    }

    .cc-btn {
      width: 100%;
      text-align: center;
      padding: 12px 20px;
    }

    .cc-btn-decline { order: 2; }
    .cc-btn-accept  { order: 1; }
  }
</style>

<script is:inline>
  (function () {
    var KEY = "cookieConsent";
    var el = document.getElementById("cookie-consent");
    if (!el) return;

    var choice = localStorage.getItem(KEY);
    if (!choice) {
      el.hidden = false;
    }

    function decide(v) {
      localStorage.setItem(KEY, v);
      el.hidden = true;
    }

    var accept = document.getElementById("cc-accept");
    var decline = document.getElementById("cc-decline");

    if (accept)  accept.addEventListener("click", function () { decide("accepted"); });
    if (decline) decline.addEventListener("click", function () { decide("declined"); });
  })();
</script>
