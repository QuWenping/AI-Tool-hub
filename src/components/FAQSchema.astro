---
/**
 * FAQ Schema - JSON-LD FAQPage structured data
 * For displaying FAQ rich snippets in search results
 *
 * Usage: <FAQSchema faqs={[{q:"Question", a:"Answer"}, ...]} />
 */
interface FAQ {
  q: string;
  a: string;
}
interface Props {
  faqs: FAQ[];
}
const { faqs } = Astro.props as Props;
const siteUrl = "https://thebestaitoolsreview.com";
const url = siteUrl + Astro.url.pathname;

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "url": url,
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
const json = JSON.stringify(schema);
---
<script type="application/ld+json" set:html={json}></script>
