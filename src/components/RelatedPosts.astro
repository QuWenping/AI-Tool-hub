---
/**
 * RelatedPosts.astro - 相关文章推荐
 * 基于 tag 匹配 + 分类匹配
 */
import posts from "../data/posts.json";
const { currentSlug, currentCategory, currentTags = [], limit = 3 } = Astro.props;

// 评分：相同分类 +5，相同 tag 每个 +2
const scoredPosts = posts
  .filter(p => p.slug !== currentSlug)
  .map(p => {
    let score = 0;
    if (p.category === currentCategory) score += 5;
    const sharedTags = (p.tags || []).filter(t => currentTags.includes(t));
    score += sharedTags.length * 2;
    return { ...p, score };
  })
  .filter(p => p.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, limit);
---
{scoredPosts.length > 0 && (
  <section class="related-posts">
    <h3 data-i18n-en="Related articles" data-i18n-zh="相关文章">Related articles</h3>
    <div class="related-grid">
      {scoredPosts.map(p => (
        <a
          href={`/blog/${p.slug}/`}
          class="related-post-card"
          onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.1)';"
          onmouseout="this.style.transform=''; this.style.boxShadow='';"
        >
          <h4>{p.title_en}</h4>
          <p>{p.desc_en}</p>
          <p class="related-post-meta">
            <i class="far fa-calendar"></i> {p.date} · {p.read_time}
          </p>
        </a>
      ))}
    </div>
  </section>
)}
