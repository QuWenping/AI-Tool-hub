---
/**
 * RelatedPosts.astro - Related posts recommendations
 * Based on tag matching + category matching
 */
const { currentSlug, currentCategory, currentTags = [], relatedSlugs = [], limit = 3, posts = [] } = Astro.props;

function getScoredPosts() {
  const scoredPosts = posts
    .filter(p => p.slug !== currentSlug)
    .map(p => {
      let score = 0;
      if (p.data.category === currentCategory) score += 5;
      const sharedTags = (p.data.tags || []).filter(t => currentTags.includes(t));
      score += sharedTags.length * 2;
      return { ...p.data, slug: p.slug, score };
    })
    .filter(p => p.score > 0)
    .sort((a, b) => b.score - a.score);
  return scoredPosts;
}

// Prefer score-based matching; fallback to explicit relatedSlugs when empty
let scoredPosts = getScoredPosts();
if (scoredPosts.length === 0 && relatedSlugs.length > 0) {
  const slugSet = new Set(relatedSlugs.slice(0, limit));
  scoredPosts = posts.filter(p => slugSet.has(p.slug)).map(p => ({ ...p.data, slug: p.slug, score: 1 }));
}
---
{scoredPosts.length > 0 && (
  <section class="related-posts">
    <h3 data-i18n-en="Related articles">Related articles</h3>
    <div class="related-grid">
      {scoredPosts.map(p => (
        <a
          href={`/blog/${p.slug}/`}
          class="related-post-card"
          onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.1)';"
          onmouseout="this.style.transform=''; this.style.boxShadow='';"
        >
          <h4>{p.title_en}</h4>
          <p>{p.desc_en}</p>
          <p class="related-post-meta">
            <i class="far fa-calendar"></i> {p.date} · {p.read_time}
          </p>
        </a>
      ))}
    </div>
  </section>
)}
