---
/**
 * Feedback.astro - "Was this helpful?" feedback buttons
 * Data stored in localStorage (simple version)
 * Production: consider connecting to a backend API
 */
const { slug, lang = "en" } = Astro.props;
---
<section class="feedback-section">
  <p data-i18n-en="Was this article helpful?">Was this article helpful?</p>
  <div class="feedback-buttons" id={`feedback-${slug}`}>
    <button
      class="feedback-btn"
      data-vote="up"
      data-slug={slug}
      class="feedback-btn"
      aria-label="Helpful"
    >
      <i class="far fa-thumbs-up"></i>
      <span data-i18n-en="Yes">Yes</span>
      <span class="feedback-count" data-type="up" class="feedback-count"></span>
    </button>
    <button
      class="feedback-btn"
      data-vote="down"
      data-slug={slug}
      class="feedback-btn"
      aria-label="Not helpful"
    >
      <i class="far fa-thumbs-down"></i>
      <span data-i18n-en="No">No</span>
      <span class="feedback-count" data-type="down" class="feedback-count"></span>
    </button>
  </div>
  <p class="feedback-thanks" data-i18n-en="Thanks for your feedback!">Thanks for your feedback!</p>
</section>

<script is:inline define:vars={{ slug }}>
(function() {
  const storageKey = `feedback-${slug}`;
  const stored = localStorage.getItem(storageKey);

  // Load stored vote
  if (stored) {
    const vote = JSON.parse(stored);
    document.querySelectorAll(`#feedback-${slug} .feedback-btn`).forEach(btn => {
      if (btn.dataset.vote === vote.choice) {
        btn.style.background = 'var(--accent-color)';
        btn.style.color = 'white';
        btn.style.borderColor = 'var(--accent-color)';
      }
    });
    document.querySelector(`#feedback-${slug} .feedback-thanks`).style.display = 'block';
  }

  // Handle clicks
  document.querySelectorAll(`#feedback-${slug} .feedback-btn`).forEach(btn => {
    btn.addEventListener('click', function() {
      const choice = this.dataset.vote;
      localStorage.setItem(storageKey, JSON.stringify({ choice, ts: Date.now() }));

      // Visual feedback
      document.querySelectorAll(`#feedback-${slug} .feedback-btn`).forEach(b => {
        b.style.background = 'var(--bg-color)';
        b.style.color = 'var(--text-main)';
        b.style.borderColor = 'var(--border-color)';
      });
      this.style.background = 'var(--accent-color)';
      this.style.color = 'white';
      this.style.borderColor = 'var(--accent-color)';
      document.querySelector(`#feedback-${slug} .feedback-thanks`).style.display = 'block';

      // Track in analytics (if GA4 is set up)
      if (typeof gtag !== 'undefined') {
        gtag('event', 'article_feedback', { article_slug: slug, vote: choice });
      }
    });
  });
})();
</script>
