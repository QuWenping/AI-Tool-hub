---
/**
 * BreadcrumbList Schema 组件 - 面包屑导航结构化数据
 * 帮助 Google 理解网站结构
 *
 * 用法：<BreadcrumbSchema items={[{name:"首页",url:"/"},{name:"博客",url:"/blog/"},{name:"当前页",url:"/blog/xxx/"}]} />
 */
interface Crumb {
  name: string;
  url: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props as Props;
const siteUrl = "https://thebestaitoolsreview.com";

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": item.name,
    "item": siteUrl + item.url
  }))
};
const json = JSON.stringify(schema);
---
<script type="application/ld+json" set:html={json}></script>
