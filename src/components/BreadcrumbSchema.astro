---
/**
 * BreadcrumbList Schema - Breadcrumb navigation structured data
 * Helps Google understand site structure
 *
 * Usage: <BreadcrumbSchema items={[{name:"Home",url:"/"},{name:"Blog",url:"/blog/"},{name:"Current",url:"/blog/xxx/"}]} />
 */
interface Crumb {
  name: string;
  url: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props as Props;
const siteUrl = "https://thebestaitoolsreview.com";

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": item.name,
    "item": siteUrl + item.url
  }))
};
const json = JSON.stringify(schema);
---
<script type="application/ld+json" set:html={json}></script>
