---
/**
 * Newsletter.astro - Newsletter subscription component
 * Supports Mailchimp / ConvertKit / Buttondown
 *
 * Currently using Buttondown (simplest, no branding)
 * Replace formAction with your service URL
 */
const { variant = "default", lang = "en" } = Astro.props;
const isZh = lang === "zh";
---
<form
  class="newsletter-form"
  action="https://buttondown.email/api/emails/embed-subscribe/yourusername"
  method="post"
  target="_blank"
  style={variant === "compact" ? "" : "background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 16px; padding: 32px; max-width: 500px; margin: 24px auto;"}
>
  {variant === "default" && (
    <h3>{isZh ? "邮件订阅：获取最新 AI 工具动态" : "Get the directory in your inbox"}</h3>
  )}
  <p>{isZh ? "我们每月发送一封简短、不烦人的邮件，包含精选推荐、隐藏宝藏和 AI 工具世界的新动态。"
    : "We send a short, no-spam email every month with our top picks, hidden gems, and what is new in the AI tool world."}</p>

  <div class="newsletter-form">
    <input
      type="email"
      name="email"
      placeholder="your@email.com"
      required
      class="newsletter-input"
    />
    <button
      type="submit"
      class="cta-btn cta-primary"
      class="newsletter-btn"
    >{isZh ? "订阅" : "Subscribe"}</button>
  </div>

  <p class="newsletter-hint">{isZh ? "无垃圾邮件。随时退订。我们永不分享您的邮箱。"
    : "No spam. Unsubscribe anytime. We never share your email."}</p>
</form>
