---
/**
 * Newsletter.astro - Newsletter 订阅组件
 * 支持 Mailchimp / ConvertKit / Buttondown
 *
 * 当前使用 Buttondown（最简单，无品牌）
 * 替换 formAction 为你的服务地址即可
 */
const { variant = "default", lang = "en" } = Astro.props;
---
<form
  class="newsletter-form"
  action="https://buttondown.email/api/emails/embed-subscribe/yourusername"
  method="post"
  target="_blank"
  style={variant === "compact" ? "" : "background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 16px; padding: 32px; max-width: 500px; margin: 24px auto;"}
>
  {variant === "default" && (
    <h3 style="margin-top: 0; font-size: 20px; margin-bottom: 8px;" data-i18n-en="Get the directory in your inbox" data-i18n-zh="把目录收到你的邮箱">Get the directory in your inbox</h3>
  )}
  <p style="color: var(--text-mute); font-size: 14px; margin-bottom: 16px;" data-i18n-en="We send a short, no-spam email every month with our top picks, hidden gems, and what is new in the AI tool world." data-i18n-zh="我们每月发送一封简短、无垃圾邮件的邮件，分享本月精选工具、隐藏神器以及 AI 工具世界的新动向。">We send a short, no-spam email every month with our top picks, hidden gems, and what is new in the AI tool world.</p>

  <div style="display: flex; gap: 8px; flex-wrap: wrap;">
    <input
      type="email"
      name="email"
      placeholder={lang === "zh" ? "你的邮箱地址" : "your@email.com"}
      required
      style="flex: 1; min-width: 200px; padding: 10px 14px; border: 1px solid var(--border-color); border-radius: 8px; background: var(--bg-color); color: var(--text-main); font-size: 14px;"
    />
    <button
      type="submit"
      class="cta-btn cta-primary"
      style="border: none; cursor: pointer;"
      data-i18n-en="Subscribe" data-i18n-zh="订阅"
    >Subscribe</button>
  </div>

  <p style="color: var(--text-mute); font-size: 12px; margin-top: 12px; margin-bottom: 0;" data-i18n-en="No spam. Unsubscribe anytime. We never share your email." data-i18n-zh="无垃圾邮件。随时退订。我们绝不分享你的邮箱。">No spam. Unsubscribe anytime. We never share your email.</p>
</form>
