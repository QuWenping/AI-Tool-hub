---
/**
 * Newsletter.astro - Newsletter subscription component
 * Supports Mailchimp / ConvertKit / Buttondown
 *
 * Currently using Buttondown (simplest, no branding)
 * Replace formAction with your service URL
 */
const { variant = "default", lang = "en" } = Astro.props;
---
<form
  class="newsletter-form"
  action="https://buttondown.email/api/emails/embed-subscribe/yourusername"
  method="post"
  target="_blank"
  style={variant === "compact" ? "" : "background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 16px; padding: 32px; max-width: 500px; margin: 24px auto;"}
>
  {variant === "default" && (
    <h3 data-i18n-en="Get the directory in your inbox">Get the directory in your inbox</h3>
  )}
  <p data-i18n-en="We send a short, no-spam email every month with our top picks, hidden gems, and what is new in the AI tool world.">We send a short, no-spam email every month with our top picks, hidden gems, and what is new in the AI tool world.</p>

  <div class="newsletter-form">
    <input
      type="email"
      name="email"
      placeholder="your@email.com"
      required
      class="newsletter-input"
    />
    <button
      type="submit"
      class="cta-btn cta-primary"
      class="newsletter-btn"
      data-i18n-en="Subscribe"
    >Subscribe</button>
  </div>

  <p class="newsletter-hint" data-i18n-en="No spam. Unsubscribe anytime. We never share your email.">No spam. Unsubscribe anytime. We never share your email.</p>
</form>
