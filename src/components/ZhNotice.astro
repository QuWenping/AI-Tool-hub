---
/** Banner shown on /zh/ pages to indicate translation status */
export interface Props {
  /** Whether zh translation exists for this page */
  hasTranslation?: boolean;
}
const { hasTranslation = false } = Astro.props;
---

{
  !hasTranslation && (
    <div class="zh-notice">
      <div class="zh-notice-inner">
        <i class="fas fa-language" aria-hidden="true"></i>
        <span>中文翻译正在进行中，当前展示英文原文作为参考。</span>
      </div>
    </div>
  )
}

<style is:global>
  .zh-notice {
    background: linear-gradient(135deg, #fef3c7, #fde68a);
    border-bottom: 2px solid #f59e0b;
    padding: 10px 20px;
    text-align: center;
    font-size: 0.9rem;
    color: #92400e;
  }
  .zh-notice-inner {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .zh-notice i {
    font-size: 1rem;
  }
  [data-theme="dark"] .zh-notice {
    background: linear-gradient(135deg, #451a03, #78350f);
    border-color: #b45309;
    color: #fcd34d;
  }
</style>
