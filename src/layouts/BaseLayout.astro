---
import { getCollection } from "astro:content";
import categoriesData from "../data/categories.json";
import Newsletter from "../components/Newsletter.astro";
import CookieConsent from "../components/CookieConsent.astro";
import CookieConsentZh from "../components/CookieConsentZh.astro";
import "../styles/global.css";
import { localePath, navLabel, getTranslations } from "../utils/i18n";
const allTools = await getCollection("tools");
const toolsById = Object.fromEntries(allTools.map(t => [t.id, t]));
const { title, description, keywords, canonical, lang: propLang, fullWidth = false, image, ogType = "website", articleAuthor, pubDate } = Astro.props;
const lang = propLang || Astro.currentLocale || "en";
const t = getTranslations("baseLayout", lang);
const tc = getTranslations("common", lang);
const siteUrl = "https://thebestaitoolsreview.com";
const pagePath = Astro.url.pathname;
const isZhPath = pagePath.startsWith("/zh/") || pagePath === "/zh/";
const zhPageUrl = isZhPath ? pagePath : "/zh" + pagePath;
const enPageUrl = isZhPath ? pagePath.replace(/^\/zh(?=\/|$)/, "") || "/" : pagePath;
const fullTitle = title
  ? (/\|\s*AI Tool Hub\s*$/i.test(title) ? title : title + " | AI Tool Hub")
  : "AI Tool Hub | Best AI Tools Directory";
const desc = description || "Explore curated AI tools for writing, coding, image generation, video, audio and productivity.";
const kw = keywords || "AI tools, best AI tools, AI writing, AI coding, AI image generators";
const url = canonical || siteUrl + Astro.url.pathname;
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "/index.html";
// AdSense policy: no ads on non-content / legal / meta pages
const noAdsSlugs = ["privacy","terms","contact","about","sponsor","advertise","press-kit","changelog","submit-sitemap","accessibility","editorial-guidelines","methodology","team"];
const _cleanPath = Astro.url.pathname.replace(/\/+$/, "");
const noAdsPage = noAdsSlugs.some(s => _cleanPath === "/" + s );
const ogImage = image ? siteUrl + image : siteUrl + "/og-image.svg";
---
<!DOCTYPE html>
<html lang={lang === "zh" ? "zh-CN" : "en-US"}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{fullTitle}</title>
  <meta name="description" content={desc}>
  <meta name="keywords" content={kw}>
  <link rel="canonical" href={url}>
  <meta name="citation_title" content={fullTitle}>
  <meta name="citation_author" content="AI Tool Hub Editorial">
  <meta name="citation_publication_date" content="2026-07-13">
  <meta name="citation_online_date" content="2026-07-13">
  <meta name="citation_publisher" content="AI Tool Hub">
  <meta name="citation_language" content={lang === "zh" ? "zh-CN" : "en-US"}>
  <meta name="author" content="AI Tool Hub Editorial Team">
  <meta name="publisher" content="AI Tool Hub">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">  <meta name="theme-color" content="#3b82f6">
  <script is:inline>
    (function () {
      var saved = null;
      try { saved = localStorage.getItem("theme"); } catch (e) {}
      var theme = saved === "light" || saved === "dark"
        ? saved
        : (window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
      document.documentElement.setAttribute("data-theme", theme);
      document.documentElement.style.colorScheme = theme;
    })();
  </script>
  <meta name="application-name" content="AI Tool Hub">
  <meta name="apple-mobile-web-app-title" content="AI Tool Hub">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="format-detection" content="telephone=no">

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/apple-touch-icon.svg">
  <link rel="manifest" href="/manifest.json">
  <meta name="msapplication-config" content="/browserconfig.xml">
  <meta name="msapplication-TileColor" content="#3b82f6">

  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={desc}>
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={url}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={image ? fullTitle : "AI Tool Hub - Best AI Tools Directory"}>
  <meta property="og:site_name" content="AI Tool Hub">
  <link rel="alternate" hreflang="en" href={siteUrl + enPageUrl}>
  <link rel="alternate" hreflang="zh" href={siteUrl + zhPageUrl}>
  <link rel="alternate" hreflang="x-default" href={siteUrl + enPageUrl}>
  <meta property="og:locale" content={lang === "zh" ? "zh_CN" : "en_US"}>
  {ogType === "article" && <meta property="article:author" content={articleAuthor || "AI Tool Hub Editorial"}>}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={desc}>
  <meta name="twitter:image" content={siteUrl + "/twitter-card.svg"}>
  <meta name="twitter:image:alt" content="AI Tool Hub - Best AI Tools Directory">
  <meta name="twitter:site" content="@aitoolhub">
  <meta name="twitter:creator" content="@aitoolhub">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;700&family=Fira+Code:wght@400;500&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;700&family=Fira+Code:wght@400;500&display=swap"></noscript>
  <script is:inline src="/js/lightbox.js" defer></script>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" referrerpolicy="no-referrer" media="print" onload="this.media='all'">

  <!-- Google Consent Mode v2: default denied, updated on user consent -->
  {import.meta.env.PROD && (
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied',
        'wait_for_update': 500
      });
    </script>
  )}
  <!-- Google Analytics 4 (production only; respects privacy policy IP anonymization) -->
  {import.meta.env.PROD && (
    <Fragment>
      <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-BRKGD43DFT"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-BRKGD43DFT', { anonymize_ip: true });
      </script>
    </Fragment>
  )}

  <meta name="geo.region" content="US">
  <meta name="geo.placename" content="United States">
  <meta name="language" content={lang === "zh" ? "zh-CN" : "en-US"}>
  <meta name="distribution" content="global">
  <meta name="rating" content="general">
  <meta name="revisit-after" content="3 days">
  <meta name="category" content="technology, AI, software">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "AI Tool Hub",
    "alternateName": "AI Tool Hub - Best AI Tools Directory",
    "url": siteUrl,
    "description": "Hand-tested reviews of the best AI tools for writing, coding, image generation, video, audio, and productivity.",
    "publisher": {
      "@type": "Organization",
      "name": "AI Tool Hub",
      "url": siteUrl,
      "logo": {
        "@type": "ImageObject",
        "url": siteUrl + "/logo.svg"
      }
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": siteUrl + "/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    },
    "inLanguage": [lang === "zh" ? "zh" : "en"]
  })}></script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "AI Tool Hub",
    "url": siteUrl,
    "logo": siteUrl + "/logo.svg",
    "description": "Independent directory of hand-tested AI tools. Real reviews, no pay-to-play.",
    "foundingDate": "2025",
    "sameAs": [
      "https://github.com/QuWenping/AI-Tool-hub"
    ]
  })}></script>

  <slot name="head" />

  <meta name="google-adsense-account" content="ca-pub-3930397953691472">
  {import.meta.env.PROD && !noAdsPage && (
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3930397953691472" crossorigin="anonymous"></script>
  )}

  {isHome && <script type="application/json" id="tools-data" set:html={JSON.stringify(Object.fromEntries(allTools.filter(t => t.data.reviewed === true).map(t => [t.id, t.data])))}></script>}
  {isHome && <script type="application/json" id="categories-data" set:html={JSON.stringify(categoriesData)}></script>}
</head>
<body>
  <header class="site-header">
    <div class="container">
      <div class="logo"><a href="/" class="logo-link">AI Tool <span>Hub</span></a></div>
                  <ul id="site-navigation" class="nav-links">
        <li><a href={localePath("/category/", lang)}>{navLabel("categories", lang)}</a></li>
        <li><a href={localePath("/workflows/", lang)}>{navLabel("workflows", lang)}</a></li>
        <li><a href={localePath("/solutions/", lang)}>{navLabel("solutions", lang)}</a></li>
        <li><a href={localePath("/prompts/", lang)}>{navLabel("prompts", lang)}</a></li>
        <li><a href={localePath("/blog/", lang)}>{navLabel("blog", lang)}</a></li>
        <li><a href={localePath("/newsletter/", lang)}>{navLabel("newsletter", lang)}</a></li>
        <li><a href={localePath("/submit-tool/", lang)}>{navLabel("submitTool", lang)}</a></li>
        <li><a href={localePath("/my-library/", lang)}>{navLabel("myLibrary", lang)}</a></li>
        <li><a href={localePath("/about/", lang)}>{navLabel("about", lang)}</a></li>
      </ul>
      <div class="header-actions">
        <div class="action-group">
          <button id="signin-btn" class="signin-btn" aria-label={t("signInAriaLabel")}>{t("signIn")}</button>
          <button id="theme-toggle" aria-label="Toggle theme"><i id="theme-icon" class="fas fa-moon"></i></button>
          <a href={lang === "zh" ? enPageUrl : zhPageUrl} hreflang={lang === "zh" ? "en" : "zh"} id="lang-toggle" class="lang-toggle" aria-label={t("switchToEnglish")}>{t("langToggleLabel")}</a>
          <button id="nav-toggle" class="nav-toggle" type="button" aria-label="Toggle navigation" aria-controls="site-navigation" aria-expanded="false">
            <i class="fas fa-bars" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </div>
  </header>
<div id="signin-modal"></div>
  <main class:list={["container", { "full-width-main": fullWidth }]}>
    <slot />
  </main>
  <section style="padding: 40px 0; background: var(--bg-color);">
    <div class="container">
      <Newsletter lang={lang} />
    </div>
  </section>
  <footer>
    <div class="container">
      <p>(c) 2026 AI Tool Hub. An ultra-minimal, curated directory of useful AI tools.</p>
      <ul class="nav-links">
        <li><a href="/about/">About</a></li>
        <li><a href="/team/">Team</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/cookie-policy/">Cookie Policy</a></li>
        <li><a href="/editorial-guidelines/">Editorial Policy</a></li>
        <li><a href="/advertise/">Advertising</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
  </footer>
  <script src="/js/auth.js" defer></script>
  <script src="/js/main.js" defer></script>
  {isHome && <script src="/js/stack-builder.js" defer></script>}



{lang === "zh" ? <CookieConsentZh /> : <CookieConsent />}
<script is:inline>
// Lazy load images without loading attribute
document.addEventListener('DOMContentLoaded',function(){
  document.querySelectorAll('img:not([loading])').forEach(function(img){
    if(!img.hasAttribute('loading')) img.setAttribute('loading','lazy');
  });
});
</script>
</body>
</html>
