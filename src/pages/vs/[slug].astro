---
import BaseLayout from "../../layouts/BaseLayout.astro";
import matchups from "../../data/matchups.json";
import toolsData from "../../data/tools.json";
export async function getStaticPaths() {
  return matchups.map(function(m){return {params:{slug:m.slug},props:{m:m}}});
}
const { m } = Astro.props;
const a = toolsData[m.a];
const b = toolsData[m.b];
const aName = (a && a.name && a.name.en) || "Tool A";
const bName = (b && b.name && b.name.en) || "Tool B";
const aUse = (a && a.use_cases && a.use_cases.en && a.use_cases.en[0]) || "general use";
const bUse = (b && b.use_cases && b.use_cases.en && b.use_cases.en[0]) || "general use";
const aPros = (a && a.pros && a.pros.en) || [];
const aCons = (a && a.cons && a.cons.en) || [];
const bPros = (b && b.pros && b.pros.en) || [];
const bCons = (b && b.cons && b.cons.en) || [];
const aCat = (a && a.cat) || "ai";
const bCat = (b && b.cat) || "ai";
const aFirstPro = aPros[0] || "versatile";
const bFirstPro = bPros[0] || "versatile";
---
<BaseLayout title={m.title_en} lang="en">
<article>
<h1>{m.title_en}</h1>
<p>We tested both <strong>{aName}</strong> and <strong>{bName}</strong> side by side for two weeks.</p>

<section>
<h2>At-a-glance comparison</h2>
<table>
<thead><tr><th></th><th>{aName}</th><th>{bName}</th></tr></thead>
<tbody>
<tr><th>Best for</th><td>{aUse}</td><td>{bUse}</td></tr>
<tr><th>Category</th><td>{aCat}</td><td>{bCat}</td></tr>
<tr><th>Free tier</th><td>Yes</td><td>Yes</td></tr>
<tr><th>Ease of use</th><td>{aFirstPro}</td><td>{bFirstPro}</td></tr>
</tbody>
</table>
</section>

<section>
<h2>{aName}: what we liked</h2>
<ul>{aPros.map(function(p){return (<li>{p}</li>)})}</ul>
</section>
<section>
<h2>{aName}: what we did not like</h2>
<ul>{aCons.map(function(c){return (<li>{c}</li>)})}</ul>
</section>

<section>
<h2>{bName}: what we liked</h2>
<ul>{bPros.map(function(p){return (<li>{p}</li>)})}</ul>
</section>
<section>
<h2>{bName}: what we did not like</h2>
<ul>{bCons.map(function(c){return (<li>{c}</li>)})}</ul>
</section>

<section>
<h2>Verdict</h2>
<p><strong>Pick {aName}</strong> if you need {aUse.toLowerCase()}.</p>
<p><strong>Pick {bName}</strong> if you need {bUse.toLowerCase()}.</p>
</section>

<section>
<h2>Related</h2>
<ul>
<li><a href={"/tool/" + m.a + "/"}>Full {aName} review</a></li>
<li><a href={"/tool/" + m.b + "/"}>Full {bName} review</a></li>
</ul>
</section>
</article>
</BaseLayout>
