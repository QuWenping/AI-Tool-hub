---
import BaseLayout from "../../layouts/BaseLayout.astro";
import matchups from "../../data/matchups.json";
import toolsData from "../../data/tools.json";
export async function getStaticPaths() {
  return matchups.map(function(m){return {params:{slug:m.slug},props:{m:m}}});
}
const { m } = Astro.props;
const a = toolsData[m.a];
const b = toolsData[m.b];
const aName = (a && a.name && a.name.en) || "Tool A";
const bName = (b && b.name && b.name.en) || "Tool B";
const aUse = (a && a.use_cases && a.use_cases.en && a.use_cases.en[0]) || "general use";
const bUse = (b && b.use_cases && b.use_cases.en && b.use_cases.en[0]) || "general use";
const aPros = (a && a.pros && a.pros.en) || [];
const aCons = (a && a.cons && a.cons.en) || [];
const bPros = (b && b.pros && b.pros.en) || [];
const bCons = (b && b.cons && b.cons.en) || [];
const aCat = (a && a.cat) || "ai";
const bCat = (b && b.cat) || "ai";
const aFirstPro = aPros[0] || "versatile";
const bFirstPro = bPros[0] || "versatile";
const categoryLabels = { text: "Writing", image: "Image", code: "Code", video: "Video", audio: "Audio", productivity: "Business" };
const siteUrl = "https://thebestaitoolsreview.com";
const pageUrl = siteUrl + "/vs/" + m.slug + "/";
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": m.title_en,
  "description": "Side-by-side comparison of " + aName + " vs " + bName + " - features, pricing, pros, cons, and our verdict.",
  "url": pageUrl,
  "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
  "image": { "@type": "ImageObject", "url": siteUrl + "/og-image.svg", "width": 1200, "height": 630 },
  "datePublished": "2026-07-11",
  "dateModified": "2026-07-11",
  "author": { "@type": "Person", "name": "AI Tool Hub Editorial" },
  "publisher": { "@type": "Organization", "name": "AI Tool Hub", "url": siteUrl, "logo": { "@type": "ImageObject", "url": siteUrl + "/logo.svg", "width": 300, "height": 60 } },
  "articleSection": "AI Tool Comparison",
  "inLanguage": "en"
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl + "/" },
    { "@type": "ListItem", "position": 2, "name": "Comparisons", "item": siteUrl + "/vs/" },
    { "@type": "ListItem", "position": 3, "name": m.title_en, "item": pageUrl }
  ]
};
const faqItems = [
  { q: aName + " vs " + bName + ": which is better in 2026?", a: "Both " + aName + " and " + bName + " are strong choices. Pick " + aName + " for " + aUse.toLowerCase() + ". Pick " + bName + " for " + bUse.toLowerCase() + "." },
  { q: "How was this comparison done?", a: "We tested both tools side by side for two weeks on the same tasks: writing, coding, image generation (where applicable), and integration. The verdict reflects real hands-on experience, not a feature list." },
  { q: "Can I use both " + aName + " and " + bName + " together?", a: "Yes - many of our readers subscribe to both and use them for different tasks. The pricing is usually low enough that dual subscription is justified for power users." }
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "url": pageUrl,
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---
<BaseLayout title={m.title_en} description={"Side-by-side comparison of " + aName + " vs " + bName}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </Fragment>
  <article class="legal-page">
    <nav class="breadcrumbs"><a href="/">Home</a> &rsaquo; <a href={"/best/" + aCat + "/"}>{(categoryLabels[aCat] || aCat) + " tools"}</a> &rsaquo; <span>{m.title_en}</span></nav>
    <header class="page-hero">
      <span class="eyebrow" data-i18n="eyebrow_compare">Tool comparison</span>
      <h1>{m.title_en}</h1>
      <p class="lede">We tested both <strong>{aName}</strong> and <strong>{bName}</strong> side by side for two weeks.</p>
    </header>

    <div class="compare-grid">
      <a class="compare-card" href={"/tool/" + m.a + "/"}>
        <div class="compare-icon"><i class={`fas ${a.icon || "fa-robot"}`}></i></div>
        <span class="compare-tag">{categoryLabels[aCat] || aCat}</span>
        <h2>{aName}</h2>
        <p>{aUse}</p>
        <span class="tool-tag">View full review →</span>
      </a>
      <div class="compare-vs">VS</div>
      <a class="compare-card" href={"/tool/" + m.b + "/"}>
        <div class="compare-icon"><i class={`fas ${b.icon || "fa-robot"}`}></i></div>
        <span class="compare-tag">{categoryLabels[bCat] || bCat}</span>
        <h2>{bName}</h2>
        <p>{bUse}</p>
        <span class="tool-tag">View full review →</span>
      </a>
    </div>

    <section>
      <h2>At-a-glance comparison</h2>
      <table class="ranking">
        <thead><tr><th></th><th>{aName}</th><th>{bName}</th></tr></thead>
        <tbody>
          <tr><th>Best for</th><td>{aUse}</td><td>{bUse}</td></tr>
          <tr><th>Category</th><td>{categoryLabels[aCat] || aCat}</td><td>{categoryLabels[bCat] || bCat}</td></tr>
          <tr><th>Free tier</th><td>Yes</td><td>Yes</td></tr>
          <tr><th>Ease of use</th><td>{aFirstPro}</td><td>{bFirstPro}</td></tr>
        </tbody>
      </table>
    </section>

    <div class="compare-pros-cons">
      <section>
        <h2>{aName}: what we liked</h2>
        <ul class="pro-list">{aPros.map(function(p){return (<li>{p}</li>)})}</ul>
      </section>
      <section>
        <h2>{aName}: what we did not like</h2>
        <ul class="con-list">{aCons.map(function(c){return (<li>{c}</li>)})}</ul>
      </section>
      <section>
        <h2>{bName}: what we liked</h2>
        <ul class="pro-list">{bPros.map(function(p){return (<li>{p}</li>)})}</ul>
      </section>
      <section>
        <h2>{bName}: what we did not like</h2>
        <ul class="con-list">{bCons.map(function(c){return (<li>{c}</li>)})}</ul>
      </section>
    </div>

    <section class="verdict-box">
      <h2 data-i18n="verdict">Verdict</h2>
      <p><strong>Pick {aName}</strong> if you need {aUse.toLowerCase()}.</p>
      <p><strong>Pick {bName}</strong> if you need {bUse.toLowerCase()}.</p>
    </section>

    <section class="related">
      <h2 data-i18n="related">Related</h2>
      <div class="related-grid">
        <a class="related-card" href={"/tool/" + m.a + "/"}>
          <div class="related-icon"><i class={`fas ${a.icon || "fa-robot"}`}></i></div>
          <div>
            <h3>{aName}</h3>
            <p>Full review of {aName}</p>
          </div>
        </a>
        <a class="related-card" href={"/tool/" + m.b + "/"}>
          <div class="related-icon"><i class={`fas ${b.icon || "fa-robot"}`}></i></div>
          <div>
            <h3>{bName}</h3>
            <p>Full review of {bName}</p>
          </div>
        </a>
      </div>
    </section>
  </article>
</BaseLayout>
