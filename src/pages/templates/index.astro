---
import BaseLayout from "../../layouts/BaseLayout.astro";
import templates from "../../data/templates.json";
const cats = [...new Set(templates.map(t => t.category))];
---
<BaseLayout title="AI Templates Library | Resume, PPT, PRD, ComfyUI, Legal Templates" description="Free copy-paste templates: resumes, presentations, PRDs, ComfyUI workflows, legal docs, meeting notes, SWOT analysis and more." keywords="templates, resume template, PRD template, pitch deck, ComfyUI workflow, NDA template, meeting minutes, SWOT">
  <div class="page-container">
    <nav class="breadcrumbs"><a href="/">Home</a> &rsaquo; <span>Templates</span></nav>
    <h1 class="page-title">Template Library</h1>
    <p class="page-lede">{templates.length} free templates. Copy, paste, customize. Resumes, presentations, documents, ComfyUI workflows, and more.</p>
    {cats.map(cat => (
      <section class="list-section">
        <h2 class="list-section-title">{cat}</h2>
        <div class="card-grid">
          {templates.filter(t => t.category === cat).map(t => (
            <a class="list-card" href={"/templates/" + t.slug + "/"}>
              <div class="card-head">
                <h3>{t.title}</h3>
                <span class={`tag-pill diff-${(t.difficulty||"").toLowerCase()}`}>{t.difficulty}</span>
              </div>
              <p class="card-desc">{t.description}</p>
              <div class="tag-row">
                {t.tags.map(tg => <span class="tag-chip">#{tg}</span>)}
                <span class="tool-pill">{t.tool}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>