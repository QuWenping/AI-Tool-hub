---
import BaseLayout from "../../layouts/BaseLayout.astro";
import templates from "../../data/templates.json";
const cats = [...new Set(templates.map(t => t.category))];
const diffColors = { "Beginner": "#22c55e", "Intermediate": "#f59e0b", "Advanced": "#ef4444" };
---
<BaseLayout title="AI Templates Library | Resume, PPT, PRD, ComfyUI, Legal Templates" description="Free copy-paste templates: resumes, presentations, PRDs, ComfyUI workflows, legal docs, meeting notes, SWOT analysis and more." keywords="templates, resume template, PRD template, pitch deck, ComfyUI workflow, NDA template, meeting minutes, SWOT">
  <div class="container" style="max-width:900px;margin:0 auto;padding:48px 24px;">
    <nav class="breadcrumbs" style="margin-bottom:24px;"><a href="/">Home</a> &rsaquo; <span>Templates</span></nav>
    <h1 style="font-size:32px;font-weight:700;margin-bottom:8px;">Template Library</h1>
    <p style="color:var(--text-mute);font-size:16px;margin-bottom:32px;">{templates.length} free templates. Copy, paste, customize. Resumes, presentations, documents, ComfyUI workflows, and more.</p>
    {cats.map(cat => (
      <section style="margin-bottom:40px;">
        <h2 style="font-size:20px;font-weight:700;margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border-color);">{cat}</h2>
        <div style="display:grid;gap:16px;">
          {templates.filter(t => t.category === cat).map(t => (
            <a href={"/templates/" + t.slug + "/"} style="text-decoration:none;color:inherit;display:block;background:var(--card-bg);border:1px solid var(--border-color);border-radius:12px;padding:20px;transition:border-color 0.2s;" onmouseover="this.style.borderColor='var(--accent-color)'" onmouseout="this.style.borderColor='var(--border-color)'">
              <div style="display:flex;justify-content:space-between;align-items:start;gap:12px;margin-bottom:8px;">
                <h3 style="font-size:16px;font-weight:600;margin:0;">{t.title}</h3>
                <span style="font-size:11px;font-weight:600;color:#fff;background:{diffColors[t.difficulty]||'#6b7280'};padding:2px 10px;border-radius:999px;white-space:nowrap;">{t.difficulty}</span>
              </div>
              <p style="font-size:14px;color:var(--text-soft);margin:0 0 12px 0;line-height:1.5;">{t.description}</p>
              <div style="display:flex;gap:6px;flex-wrap:wrap;">
                {t.tags.map(tg => <span style="font-size:11px;color:var(--text-mute);background:var(--bg-color);padding:2px 8px;border-radius:5px;">#{tg}</span>)}
                <span style="font-size:12px;color:var(--accent-color);margin-left:auto;">{t.tool}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
