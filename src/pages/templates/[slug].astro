---
import BaseLayout from "../../layouts/BaseLayout.astro";
import templates from "../../data/templates.json";
import TLDR from "../../components/ui/TLDR.astro";
export async function getStaticPaths() {
  return templates.map(t => ({ params: { slug: t.slug }, props: { template: t } }));
}
const { template } = Astro.props;
const siteUrl = "https://thebestaitoolsreview.com";
const pageUrl = siteUrl + "/templates/" + template.slug + "/";
const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","url":pageUrl,"mainEntity":[{ "@type":"Question","name":template.title,"acceptedAnswer":{"@type":"Answer","text":template.description } }] };
const breadcrumb = { "@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":siteUrl},{"@type":"ListItem","position":2,"name":"Templates","item":siteUrl+"/templates/"},{"@type":"ListItem","position":3,"name":template.title,"item":pageUrl}] };
---
<BaseLayout title={template.title + " | Template Library"} description={template.description} keywords={template.tags.join(", ")}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}></script>
  </Fragment>
  <div class="article">
    <nav class="breadcrumbs"><a href="/">Home</a> &rsaquo; <a href="/templates/">Templates</a> &rsaquo; <span>{template.title}</span></nav>
    <header class="article-header">
      <span class="eyebrow">{template.category}</span>
      <h1>{template.title}</h1>
      <div class="tag-row">
        <span class="meta-text">Tool: {template.tool}</span>
        <span class="meta-text">|</span>
        <span class="meta-text">Level: {template.difficulty}</span>
      </div>
    </header>
    <section class="article-body">
      <p>{template.description}</p>
    <TLDR items={[
      template.title,
      "Category: " + template.category,
      "Tool: " + template.tool,
      "Difficulty: " + template.difficulty
    ]} />

      <div class="info-card blue">
        <p><strong>Best for:</strong> {template.useCase}</p>
      </div>
      <h2>Template</h2>
      <div class="code-card">
        <button id="cp" class="copy-btn">Copy</button>
        <pre id="tt" class="prompt-code">{template.template}</pre>
      </div>
      <h2>How to Use</h2>
      <ol>
        <li>Copy the template above</li>
        <li>Replace [PLACEHOLDER] text with your details</li>
        <li>Customize sections as needed</li>
        <li>{template.tool === 'ComfyUI' ? 'Set up the nodes in ComfyUI as described' : 'Use in your preferred tool or document'}</li>
      </ol>
      <div class="tag-row">
        {template.tags.map(t => <span class="tag-chip">#{t}</span>)}
      </div>
      <div class="qa-box">
        <h3>This Template Answers</h3>
        <ul>
          <li>How to structure a {template.title.toLowerCase()}</li>
          <li>What sections to include</li>
          <li>Best practices for {template.category.toLowerCase()}</li>
        </ul>
      </div>
      <p class="back-link"><a href="/templates/">Back to Templates</a></p>
    </section>
  </div>
</BaseLayout>
<script is:inline>document.getElementById("cp").addEventListener("click",function(){navigator.clipboard.writeText(document.getElementById("tt").textContent).then(function(){var b=document.getElementById("cp");b.textContent="Copied!";setTimeout(function(){b.textContent="Copy"},2000)})})</script>