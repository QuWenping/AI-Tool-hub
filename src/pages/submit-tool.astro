---
import BaseLayout from "../layouts/BaseLayout.astro";
const siteUrl = "https://thebestaitoolsreview.com";
const pageUrl = siteUrl + "/submit-tool/";
const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","url":pageUrl,"mainEntity":[
  {"@type":"Question","name":"How long does it take for a submitted tool to be reviewed?","acceptedAnswer":{"@type":"Answer","text":"We review submissions within 3-5 business days. If your tool meets our criteria, we will add it to our database with a full review page. You will receive an email notification when your tool is published."}},
  {"@type":"Question","name":"What criteria must a tool meet to be listed?","acceptedAnswer":{"@type":"Answer","text":"The tool must: 1) Be an AI-powered tool or have significant AI features, 2) Have a live website with clear pricing, 3) Be usable by individuals or businesses (not enterprise-only), 4) Not be a scam or misleading product. We prioritize tools with active development and positive user feedback."}},
  {"@type":"Question","name":"Can I submit my own tool?","acceptedAnswer":{"@type":"Answer","text":"Yes! Tool creators and founders are welcome to submit their products. Please disclose your affiliation in the submission form. We review all submissions with the same criteria regardless of who submits them."}},
  {"@type":"Question","name":"Is there a fee for listing a tool?","acceptedAnswer":{"@type":"Answer","text":"No. Listing on AI Tool Hub is completely free. We do not accept payment for reviews or ranking placement. Our rankings are based on hands-on testing and editorial judgment."}}
]};
---
<BaseLayout title="Submit an AI Tool | AI Tool Hub" description="Submit a new AI tool to be reviewed and listed on AI Tool Hub. Free, no pay-to-play. We review all submissions within 3-5 business days." keywords="submit AI tool, list AI tool, AI tool directory submission, tool review request">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </Fragment>
  <div class="article">
    <nav class="breadcrumbs"><a href="/">Home</a> &rsaquo; <span>Submit Tool</span></nav>
    <header class="article-header">
      <span class="eyebrow">Contribute</span>
      <h1>Submit an AI Tool</h1>
    </header>
    <section class="article-body">
      <p>Know an AI tool we should review? Submit it below. We review all submissions within <strong>3-5 business days</strong>. Listing is free — we never accept payment for reviews or ranking.</p>

      <div class="info-card green">
        <h3>Listing Criteria</h3>
        <ul>
          <li>AI-powered tool or significant AI features</li>
          <li>Live website with clear pricing</li>
          <li>Available to individuals or businesses (not enterprise-only)</li>
          <li>Active development and positive user feedback</li>
        </ul>
      </div>

      <form id="submit-form" class="form-grid">
        <div>
          <label class="form-label">Tool Name *</label>
          <input type="text" id="tool-name" required placeholder="e.g. Cursor" class="form-input" />
        </div>
        <div>
          <label class="form-label">Website URL *</label>
          <input type="url" id="tool-url" required placeholder="https://..." class="form-input" />
        </div>
        <div>
          <label class="form-label">Category *</label>
          <select id="tool-category" required class="form-input">
            <option value="">Select category...</option>
            <option value="code">Coding / Development</option>
            <option value="image">Image Generation / Design</option>
            <option value="video">Video Generation / Editing</option>
            <option value="audio">Audio / Music / Voice</option>
            <option value="text">Writing / Chat / Text</option>
            <option value="productivity">Productivity / Automation</option>
            <option value="research">Research / Analysis</option>
            <option value="agent">AI Agent / Automation</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div>
          <label class="form-label">Short Description *</label>
          <textarea id="tool-desc" required rows="3" placeholder="What does this tool do? (1-2 sentences)" class="form-input"></textarea>
        </div>
        <div>
          <label class="form-label">Pricing Model</label>
          <select id="tool-pricing" class="form-input">
            <option value="">Select pricing...</option>
            <option value="free">Free</option>
            <option value="freemium">Freemium (free tier + paid)</option>
            <option value="paid">Paid only</option>
            <option value="opensource">Open source</option>
            <option value="enterprise">Enterprise / Contact sales</option>
          </select>
        </div>
        <div>
          <label class="form-label">Your Email (for confirmation) *</label>
          <input type="email" id="submitter-email" required placeholder="your@email.com" class="form-input" />
        </div>
        <div>
          <label class="form-label">Are you affiliated with this tool?</label>
          <select id="affiliation" class="form-input">
            <option value="no">No, just a user/fan</option>
            <option value="founder">Yes, I am the founder/creator</option>
            <option value="team">Yes, I am on the team</option>
            <option value="marketer">Yes, I do marketing for them</option>
          </select>
        </div>
        <div>
          <label class="form-label">Anything else we should know?</label>
          <textarea id="tool-notes" rows="3" placeholder="Optional: standout features, use cases, why you recommend it" class="form-input"></textarea>
        </div>
        <button type="submit" class="cta-primary">Submit for Review</button>
      </form>
      <div id="submit-msg" class="form-success">
        <p>Thank you! Your submission has been received.</p>
        <p>We will review this tool within 3-5 business days and notify you by email if it is added to our database.</p>
      </div>

      <h2>FAQ</h2>
      <div class="card-grid">
        <div class="info-card">
          <h3>How long does review take?</h3>
          <p>3-5 business days. You will be notified by email when your tool is published.</p>
        </div>
        <div class="info-card">
          <h3>Is there a listing fee?</h3>
          <p>No. Listing is completely free. We do not accept payment for reviews or rankings.</p>
        </div>
        <div class="info-card">
          <h3>Can I submit my own tool?</h3>
          <p>Yes! Please disclose your affiliation. All submissions are reviewed with the same criteria.</p>
        </div>
      </div>

      <p class="back-link"><a href="/submit-prompt/">Submit a Prompt</a> &nbsp;|&nbsp; <a href="/">Browse Tools</a></p>
    </section>
  </div>
</BaseLayout>
<script is:inline>
document.getElementById("submit-form").addEventListener("submit",function(e){
  e.preventDefault();
  var form=e.target;
  var data={name:form.querySelector("#tool-name").value,url:form.querySelector("#tool-url").value,category:form.querySelector("#tool-category").value,description:form.querySelector("#tool-desc").value,pricing:form.querySelector("#tool-pricing").value,email:form.querySelector("#submitter-email").value,affiliation:form.querySelector("#affiliation").value,notes:form.querySelector("#tool-notes").value};
  fetch("/api/submit-tool",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(data)}).then(function(r){return r.json()}).then(function(d){
    if(d.success){document.getElementById("submit-msg").style.display="block";form.style.display="none";}
  }).catch(function(){document.getElementById("submit-msg").style.display="block";document.getElementById("submit-msg").querySelector("p").textContent="Network error. Please try again.";});
});
</script>
