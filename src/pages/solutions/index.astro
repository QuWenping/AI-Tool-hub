---
import BaseLayout from "../../layouts/BaseLayout.astro";
import solutions from "../../data/solutions.json";
---
<BaseLayout title="AI Solutions by Industry | Developer, Marketing, Education, Business" description="Industry-specific AI tool guides for developers, marketers, educators, businesses, and creatives. Learn which AI tools to use, how to combine them, and real workflows for your field." keywords="AI solutions, AI for developers, AI for marketing, AI for education, AI for business, AI for creatives, industry AI guide">
  <div class="container" style="max-width:900px;margin:0 auto;padding:48px 24px;">
    <nav class="breadcrumbs" style="margin-bottom:24px;"><a href="/">Home</a> &rsaquo; <span>Solutions</span></nav>
    <h1 style="font-size:32px;font-weight:700;margin-bottom:8px;">AI Solutions by Industry</h1>
    <p style="color:var(--text-mute);font-size:16px;margin-bottom:32px;">Industry-specific guides: which AI tools to use, how to combine them into workflows, and real-world implementation strategies.</p>

    <div style="display:grid;gap:20px;">
      {solutions.map(s => (
        <a href={"/solutions/" + s.slug + "/"} style="text-decoration:none;color:inherit;display:block;background:var(--card-bg);border:1px solid var(--border-color);border-radius:12px;padding:24px;transition:border-color 0.2s;" onmouseover="this.style.borderColor='var(--accent-color)'" onmouseout="this.style.borderColor='var(--border-color)'">
          <div style="display:flex;justify-content:space-between;align-items:start;gap:12px;margin-bottom:8px;">
            <h2 style="font-size:18px;font-weight:600;margin:0;">{s.title}</h2>
            <span style="font-size:11px;color:var(--accent-color);background:rgba(59,130,246,0.1);padding:3px 10px;border-radius:999px;white-space:nowrap;font-weight:600;">{s.industry}</span>
          </div>
          <p style="font-size:14px;color:var(--text-soft);margin:0 0 12px 0;line-height:1.5;">{s.description}</p>
          <div style="display:flex;gap:6px;flex-wrap:wrap;">
            {s.tools.slice(0, 5).map(t => <span style="font-size:12px;color:var(--text-mute);background:var(--bg-color);padding:3px 10px;border-radius:5px;">{t}</span>)}
            {s.tools.length > 5 && <span style="font-size:12px;color:var(--text-mute);padding:3px 6px;">+{s.tools.length - 5} more</span>}
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
