---
import BaseLayout from "../../layouts/BaseLayout.astro";
import toolsData from "../../data/tools.json";
export async function getStaticPaths() {
  return Object.entries(toolsData).filter(function(e){return e[0]!=="codewords"}).map(function(e){return {params:{slug:e[0]},props:{id:e[0],tool:e[1]}}});
}
const { id, tool } = Astro.props;
const alternatives = Object.entries(toolsData).filter(function(e){return e[0]!==id && e[1].cat===tool.cat}).slice(0,8);
const aName = (tool && tool.name && tool.name.en) || "Tool";
---
<BaseLayout title={"Best " + aName + " Alternatives in 2026"} lang="en">
<article>
<h1>{"Best " + aName + " Alternatives in 2026"}</h1>
<p>{aName} is great. Here are alternatives.</p>
<ul>
{alternatives.map(function(e){var k=e[0];var t=e[1];return (<li><a href={"/tool/" + k + "/"}><strong>{t.name.en}</strong></a> - {t.short_desc.en}</li>)})}
</ul>
</article>
</BaseLayout>
