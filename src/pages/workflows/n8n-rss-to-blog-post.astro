---
import BaseLayout from "../../layouts/BaseLayout.astro";
const title = "n8n RSS to Blog Post Automation Workflow";

const siteUrl = "https://thebestaitoolsreview.com";
const pageUrl = siteUrl + "/workflows/n8n-rss-to-blog-post/";
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": title,
  "description": "Automatically convert RSS feed items into formatted blog posts using n8n automation workflow with AI-powered content transformation.",
  "url": pageUrl,
  "step": [
    { "@type": "HowToStep", "position": 1, "name": "RSS Trigger", "text": "Poll configured RSS feeds at your chosen interval." },
    { "@type": "HowToStep", "position": 2, "name": "Duplicate Check", "text": "Compare against previously processed items to avoid republishing." },
    { "@type": "HowToStep", "position": 3, "name": "Content Extraction", "text": "Fetch full article text from each RSS item URL." },
    { "@type": "HowToStep", "position": 4, "name": "AI Rewriting", "text": "Send content to ChatGPT or Claude API for summarization and style formatting." },
    { "@type": "HowToStep", "position": 5, "name": "SEO Generation", "text": "Create meta title, description, and tags automatically." },
    { "@type": "HowToStep", "position": 6, "name": "Output", "text": "Push to WordPress, Webflow, Markdown file, or email digest based on your configuration." }
  ]
};
const articleSchema = { "@context":"https://schema.org","@type":"Article","headline":title,"description":"Automatically convert RSS feed items into formatted blog posts using n8n automation workflow. AI-powered content transformation with publishing-ready output.","url":pageUrl,"author":{"@type":"Organization","name":"AI Tool Hub"},"publisher":{"@type":"Organization","name":"AI Tool Hub"},"datePublished":"2026-07-26","dateModified":"2026-07-26" };
const breadcrumb = { "@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":siteUrl+"/"},{"@type":"ListItem","position":2,"name":"Workflows","item":siteUrl+"/workflows/"},{"@type":"ListItem","position":3,"name":title,"item":pageUrl}] };
---

<BaseLayout title={title} description="Automatically convert RSS feed items into formatted blog posts using n8n automation workflow. AI-powered content transformation with publishing-ready output.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}></script>
  </Fragment>
  <article class="legal-page">
    <nav class="breadcrumbs">
      <a href="/">Home</a> &rsaquo;
      <a href="/workflows/">AI Workflows</a> &rsaquo;
      <span>{title}</span>
    </nav>
    <header class="page-hero">
      <span class="eyebrow">Workflows</span>
      <h1>{title}</h1>
      <p class="lede">Automatically convert RSS feed items into formatted blog posts using n8n. Includes AI-powered content rewriting, SEO metadata generation, and CMS publishing.</p>
    </header>
    <section class="article-body">
      <h2>Overview</h2>
      <p>This n8n workflow monitors one or more RSS feeds, extracts new articles, and transforms them into publish-ready blog posts using AI. It handles content summarization, formatting, SEO metadata, and automated CMS or email output.</p>

      <h2>Workflow Steps</h2>
      <ol>
        <li><strong>RSS Trigger</strong>: Polls configured RSS feeds at your chosen interval.</li>
        <li><strong>Duplicate Check</strong>: Compares against previously processed items to avoid republishing.</li>
        <li><strong>Content Extraction</strong>: Fetches full article text from each RSS item URL.</li>
        <li><strong>AI Rewriting</strong>: Sends content to ChatGPT or Claude API for summarization and style formatting.</li>
        <li><strong>SEO Generation</strong>: Creates meta title, description, and tags automatically.</li>
        <li><strong>Output</strong>: Pushes to WordPress, Webflow, Markdown file, or email digest based on your configuration.</li>
      </ol>

      <h2>Tools Required</h2>
      <ul>
        <li>n8n (self-hosted or cloud)</li>
        <li>OpenAI API or Anthropic API key</li>
        <li>CMS integration (WordPress, Webflow, or file output)</li>
      </ul>

      <h2>Use Cases</h2>
      <ul>
        <li>Content curation sites that aggregate industry news</li>
        <li>Personal newsletters that summarize daily RSS feeds</li>
        <li>Internal knowledge bases that auto-sync with external sources</li>
      </ul>
    </section>
  </article>
</BaseLayout>
