---
import BaseLayout from "../../layouts/BaseLayout.astro";
import workflows from "../../data/workflows.json";
const cats = [...new Set(workflows.map(w => w.category))];
const diffColors = { "Beginner": "#22c55e", "Intermediate": "#f59e0b", "Advanced": "#ef4444" };
---
<BaseLayout title="AI Workflow Library | n8n, Dify, ComfyUI, MCP Tutorials" description="Step-by-step AI workflow tutorials for n8n, Dify, ComfyUI, and MCP. Automate content generation, customer support, data analysis, and more with detailed setup guides." keywords="AI workflows, n8n workflows, Dify workflows, ComfyUI workflows, MCP tutorials, automation, AI agent">
  <div class="container" style="max-width:900px;margin:0 auto;padding:48px 24px;">
    <nav class="breadcrumbs" style="margin-bottom:24px;"><a href="/">Home</a> &rsaquo; <span>Workflow Library</span></nav>
    <h1 style="font-size:32px;font-weight:700;margin-bottom:8px;">AI Workflow Library</h1>
    <p style="color:var(--text-mute);font-size:16px;margin-bottom:32px;">{workflows.length} step-by-step workflow tutorials for n8n, Dify, ComfyUI, and MCP. From beginner to advanced.</p>

    {cats.map(cat => (
      <section style="margin-bottom:40px;">
        <h2 style="font-size:20px;font-weight:700;margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border-color);">{cat}</h2>
        <div style="display:grid;gap:16px;">
          {workflows.filter(w => w.category === cat).map(w => (
            <a href={"/workflows/" + w.slug + "/"} style="text-decoration:none;color:inherit;display:block;background:var(--card-bg);border:1px solid var(--border-color);border-radius:12px;padding:20px;transition:border-color 0.2s;" onmouseover="this.style.borderColor='var(--accent-color)'" onmouseout="this.style.borderColor='var(--border-color)'">
              <div style="display:flex;justify-content:space-between;align-items:start;gap:12px;margin-bottom:8px;">
                <h3 style="font-size:16px;font-weight:600;margin:0;">{w.title}</h3>
                <span style="font-size:11px;font-weight:600;color:#fff;background:{diffColors[w.difficulty] || '#6b7280'};padding:2px 10px;border-radius:999px;white-space:nowrap;">{w.difficulty}</span>
              </div>
              <p style="font-size:14px;color:var(--text-soft);margin:0 0 12px 0;line-height:1.5;">{w.description}</p>
              <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
                <span style="font-size:12px;color:var(--accent-color);background:rgba(59,130,246,0.1);padding:3px 10px;border-radius:6px;font-weight:600;">{w.tool}</span>
                {w.tags.slice(0, 3).map(t => <span style="font-size:11px;color:var(--text-mute);background:var(--bg-color);padding:2px 8px;border-radius:5px;">#{t}</span>)}
                <span style="font-size:12px;color:var(--text-mute);margin-left:auto;">{w.steps.length} steps</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <div style="text-align:center;margin-top:48px;padding-top:24px;border-top:1px solid var(--border-color);">
      <p style="color:var(--text-mute);font-size:14px;">More workflows coming soon. Have a request? <a href="/contact/" style="color:var(--accent-color);">Let us know</a>.</p>
    </div>
  </div>
</BaseLayout>
