---
import BaseLayout from "../../layouts/BaseLayout.astro";
import workflows from "../../data/workflows.json";
const cats = [...new Set(workflows.map(w => w.category))];
---
<BaseLayout title="AI Workflow Library | n8n, Dify, ComfyUI, MCP Tutorials" description="Step-by-step AI workflow tutorials for n8n, Dify, ComfyUI, and MCP. Automate content generation, customer support, data analysis, and more with detailed setup guides." keywords="AI workflows, n8n workflows, Dify workflows, ComfyUI workflows, MCP tutorials, automation, AI agent">
  <div class="page-container">
    <nav class="breadcrumbs"><a href="/">Home</a> &rsaquo; <span>Workflow Library</span></nav>
    <h1 class="page-title">AI Workflow Library</h1>
    <p class="page-lede">{workflows.length} step-by-step workflow tutorials for n8n, Dify, ComfyUI, and MCP. From beginner to advanced.</p>

    {cats.map(cat => (
      <section class="list-section">
        <h2 class="list-section-title">{cat}</h2>
        <div class="card-grid">
          {workflows.filter(w => w.category === cat).map(w => (
            <a class="list-card" href={"/workflows/" + w.slug + "/"}>
              <div class="card-head">
                <h3>{w.title}</h3>
                <span class={`tag-pill diff-${(w.difficulty||"").toLowerCase()}`}>{w.difficulty}</span>
              </div>
              <p class="card-desc">{w.description}</p>
              <div class="tag-row">
                <span class="tool-pill">{w.tool}</span>
                {w.tags.slice(0, 3).map(t => <span class="tag-chip">#{t}</span>)}
                <span class="meta-count">{w.steps.length} steps</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <div class="list-footer">
      <p>More workflows coming soon. Have a request? <a href="/contact/">Let us know</a>.</p>
    </div>
  </div>
</BaseLayout>