---
import BaseLayout from "../../layouts/BaseLayout.astro";
import tools from "../../data/tools.json";

const workflows = [
  {
    title: "Content Repurposing Pipeline",
    description: "Turn one blog post into social posts, newsletter, and video script using Claude + ChatGPT + ElevenLabs",
    toolCount: 3
  },
  {
    title: "SEO Content Engine",
    description: "Keyword research → outline → draft → optimize using ChatGPT + SurferSEO + Grammarly",
    toolCount: 3
  },
  {
    title: "Design-to-Code Handoff",
    description: "Figma mockup → AI code generation → review using Midjourney + Cursor + ChatGPT",
    toolCount: 3
  },
  {
    title: "Customer Support Automation",
    description: "Ticket triage → draft response → human review using ChatGPT + Claude + Make",
    toolCount: 3
  },
  {
    title: "Data Analysis Pipeline",
    description: "Raw data → clean → visualize → report using ChatGPT Code Interpreter + Claude",
    toolCount: 2
  },
  {
    title: "Video Production Suite",
    description: "Script → voiceover → edit → captions using Claude + ElevenLabs + Runway + Descript",
    toolCount: 4
  }
];
---

<BaseLayout
  title="AI Workflows - Pre-built Multi-Tool Automation Workflows"
  description="Pre-built multi-tool workflows to automate your daily tasks. Combine ChatGPT, Claude, Midjourney, ElevenLabs and more."
>
  <div class="page-container">
    <h1 class="page-title">AI Workflows</h1>
    <p class="page-lede">Pre-built multi-tool workflows to automate your daily tasks.</p>

    <div class="card-grid">
      {workflows.map(w => (
        <div class="list-card">
          <div class="card-head">{w.title}</div>
          <p class="card-desc">{w.description}</p>
          <span>{w.toolCount} tools</span>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
