---
import BaseLayout from "../../layouts/BaseLayout.astro";

const siteUrl = "https://thebestaitoolsreview.com";
const pageUrl = siteUrl + "/workflows/dify-sales-assistant/";
const faqItems = [
  { q: "What is a Dify sales assistant workflow?", a: "A Dify AI application that handles inbound sales inquiries: classifies intent, retrieves product info from a knowledge base, drafts responses, and can hand off to a human. This template wires an LLM node, knowledge retrieval, and conditional branching." },
  { q: "Do I need coding to deploy this?", a: "No. Dify provides a visual orchestration canvas. You import this workflow JSON, connect your LLM provider key, and upload your product knowledge base. No code required." }
];
const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","url":pageUrl,"mainEntity": faqItems.map(f => ({ "@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a} })) };
const articleSchema = { "@context":"https://schema.org","@type":"Article","headline":"Dify Sales Assistant Workflow","description":"A Dify AI sales assistant workflow: intent classification, knowledge retrieval, response drafting, and human handoff.","url":pageUrl,"author":{"@type":"Organization","name":"AI Tool Hub"},"publisher":{"@type":"Organization","name":"AI Tool Hub"},"datePublished":"2026-07-26","dateModified":"2026-07-26" };
const breadcrumb = { "@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":siteUrl},{"@type":"ListItem","position":2,"name":"Workflows","item":siteUrl+"/workflows/"},{"@type":"ListItem","position":3,"name":"Sales Assistant","item":pageUrl}] };
---

<BaseLayout title="Dify Sales Assistant Workflow | AI Tool Hub" description="A Dify AI sales assistant workflow with intent classification, knowledge retrieval, and human handoff." keywords="Dify, sales assistant, AI agent, LLM workflow, customer support" lang="en">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}></script>
  </Fragment>
  <div class="article">
    <nav class="breadcrumbs"><a href="/">Home</a> &rsaquo; <a href="/workflows/">Workflows</a> &rsaquo; <span>Sales Assistant</span></nav>
    <header class="article-header">
      <span class="eyebrow">Workflow</span>
      <h1>Dify Sales Assistant Workflow</h1>
      <p>An AI sales assistant built in Dify. It classifies inbound inquiries, retrieves answers from your product knowledge base, drafts replies, and escalates complex cases to a human.</p>
    </header>
    <section class="article-body">

      <h2>Workflow Nodes</h2>
      <ol>
        <li><strong>Start:</strong> receives customer message + conversation history</li>
        <li><strong>Intent Classifier (LLM):</strong> labels as "product_question", "pricing", "demo_request", "complaint", or "other"</li>
        <li><strong>Knowledge Retrieval:</strong> queries your product/pricing knowledge base (top 3 chunks)</li>
        <li><strong>Response Drafter (LLM):</strong> generates a helpful, on-brand reply using retrieved context</li>
        <li><strong>Conditional Branch:</strong> if intent == "demo_request" or confidence &lt; 0.6, route to human handoff</li>
        <li><strong>Human Handoff:</strong> posts to Slack/CRM and returns a "transferring you to an agent" message</li>
        <li><strong>End:</strong> returns final response to the chat widget</li>
      </ol>

      <h2>Setup Steps</h2>
      <ul>
        <li>Import this workflow JSON into Dify</li>
        <li>Connect your LLM provider (OpenAI / Anthropic / local)</li>
        <li>Upload product docs, pricing sheets, and FAQs to the knowledge base</li>
        <li>Configure the human-handoff webhook (Slack / HubSpot / Salesforce)</li>
        <li>Publish and embed the chat widget on your site</li>
      </ul>

      <h2>FAQ</h2>
      <div class="card-grid">
        {faqItems.map(f => (
          <div class="info-card"><h3>{f.q}</h3><p>{f.a}</p></div>
        ))}
      </div>
      <p class="back-link"><a href="/workflows/">All Workflows</a></p>
    </section>
  </div>
</BaseLayout>
