---
import BaseLayout from "../../layouts/BaseLayout.astro";
import workflows from "../../data/workflows.json";
import Chart from "../../components/Chart.astro";
import TLDR from "../../components/ui/TLDR.astro";
import AdSlot from "../../components/ui/AdSlot.astro";
export async function getStaticPaths() {
  return workflows.map(w => ({ params: { slug: w.slug }, props: { workflow: w } }));
}
const { workflow } = Astro.props;
const siteUrl = "https://thebestaitoolsreview.com";
const pageUrl = siteUrl + "/workflows/" + workflow.slug + "/";
const faqItems = [
  { q: "What is " + workflow.title + "?", a: workflow.description },
  { q: "What tool is used for this workflow?", a: "This workflow uses " + workflow.tool + ". " + workflow.prerequisites },
  { q: "Is this workflow suitable for beginners?", a: workflow.difficulty === "Beginner" ? "Yes, this workflow is designed for beginners with no prior experience needed." : "This is rated as " + workflow.difficulty + " difficulty. " + workflow.prerequisites }
];
const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","url":pageUrl,"mainEntity": faqItems.map(f => ({ "@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a} })) };
const howToSchema = { "@context":"https://schema.org","@type":"HowTo","name":workflow.title,"description":workflow.description,"tool":workflow.tool,"step":workflow.steps.map((s, i) => ({ "@type":"HowToStep","position":i+1,"name":s.title,"text":s.detail})), "totalTime":"PT30M" };
const breadcrumb = { "@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":siteUrl},{"@type":"ListItem","position":2,"name":"Workflow Library","item":siteUrl+"/workflows/"},{"@type":"ListItem","position":3,"name":workflow.title,"item":pageUrl}] };
---
<BaseLayout title={workflow.title + " | AI Workflow Library"} description={workflow.description} keywords={workflow.tags.join(", ")}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}></script>
  </Fragment>
  <div class="article">
    <nav class="breadcrumbs"><a href="/">Home</a> &rsaquo; <a href="/workflows/">Workflow Library</a> &rsaquo; <span>{workflow.title}</span></nav>
    <header class="article-header">
      <span class="eyebrow">{workflow.category} - {workflow.tool}</span>
      <h1>{workflow.title}</h1>
      <div class="tag-row">
        <span class={`tag-pill diff-${(workflow.difficulty||'').toLowerCase()}`}>{workflow.difficulty}</span>
        <span class="meta-text">{workflow.steps.length} steps</span>
      </div>
    </header>
    <section class="article-body">
      <p>{workflow.summary}</p>
    <TLDR items={[
      workflow.title + " — " + (workflow.difficulty || "intermediate") + " level",
      "Tool: " + workflow.tool,
      workflow.steps.length + " steps with detailed instructions",
      "Prerequisites: " + (workflow.prerequisites || "See below")
    ]} />

    <AdSlot format="banner" />


      <div class="info-card">
        <h3>Use Case</h3>
        <p>{workflow.useCase}</p>
      </div>

      <div class="info-card amber">
        <h3>Prerequisites</h3>
        <p>{workflow.prerequisites}</p>
      </div>

      <h2>Workflow Diagram</h2>
    <Chart type="flowchart" title={workflow.title} data={{
      steps: workflow.steps.map((s, i) => ({
        label: s.title,
        type: i === 0 ? "start" : "step"
      }))
    }} />

      <h2>Step-by-Step Guide</h2>
      <ol class="step-list">
        {workflow.steps.map((step, i) => (
          <li class="step-item">
            <span class="step-icon">{i+1}</span>
            <h3>{step.title}</h3>
            <p>{step.detail}</p>
          </li>
        ))}
      </ol>

      <h2>Tags</h2>
      <div class="tag-row">
        {workflow.tags.map(t => <span class="tag-chip">#{t}</span>)}
      </div>

      <div class="qa-box">
        <h3>This workflow answers:</h3>
        <ul>
          <li>How to set up {workflow.title.toLowerCase()}</li>
          <li>What tools and access you need</li>
          <li>How to troubleshoot common issues</li>
        </ul>
      </div>

      <p class="back-link"><a href="/workflows/">Back to Workflow Library</a></p>
    </section>
  </div>
</BaseLayout>