    exampleOutput: "## Agent Memory Architecture\n### Short-term Memory\n- Sliding context window: last 10 turns\n- Token budget: 8K tokens\n### Long-term Memory\n- Vector DB: Pinecone, embedding dimension 1536\n- Chunking: 512 tokens with 64-token overlap\n### Episodic Memory\n- Store key decisions and outcomes as structured JSON\n- Retrieval: semantic search + recency boost\n### Consolidation\n- Nightly batch: summarize daily interactions into long-term store\n- Pruning: remove redundant memories older than 30 days",
    relatedTools: ["claude", "chatgpt"],
  },
  "chatgpt-diff-instruction": {
    title: "ChatGPT Diff Instruction Prompt",
    description: "A prompt for using ChatGPT to generate precise code diffs and apply targeted changes to existing codebases. Handles refactoring, bug fixes, and feature additions with minimal collateral changes.",
    tags: ["Coding", "ChatGPT", "Git"],
    useCase: "Developers who need AI to produce clean, minimal diffs that can be directly applied as patches or easily reviewed in pull requests.",
    exampleOutput: "## Diff: Fix rate limiter bug\n```diff\n--- a/src/middleware/rateLimiter.ts\n+++ b/src/middleware/rateLimiter.ts\n@@ -12,7 +12,7 @@\n   const key = `${req.ip}:${req.path}`;\n   const current = await redis.get(key);\n-  if (current && parseInt(current) > limit) {\n+  if (current && parseInt(current) >= limit) {\n     return res.status(429).json({ error: 'Too many requests' });\n   }\n```\n### Impact: 1 line changed, off-by-one error fixed.",
    relatedTools: ["chatgpt", "cursor", "claude"],
  },
  "claude-arch-doc": {
    title: "Claude Architecture Doc Prompt",
    description: "A prompt for using Claude to generate comprehensive software architecture documentation. Covers system design diagrams (text-based), component descriptions, data flow, API contracts, and deployment architecture.",
    tags: ["Architecture", "Claude", "Documentation"],
    useCase: "Software architects and tech leads who need to produce thorough architecture decision records (ADRs), system design docs, and technical specifications.",
    exampleOutput: "## Architecture: Microservices E-Commerce Platform\n### System Overview\n- API Gateway (Kong) routes to 12 microservices\n- Event bus (Kafka) for async communication\n- Service mesh (Istio) for observability\n### Component: Order Service\n- Responsibility: Order lifecycle management\n- Database: PostgreSQL with read replicas\n- Dependencies: Inventory Service, Payment Service\n### Data Flow\n1. Client -> API Gateway -> Order Service\n2. Order Service -> Kafka (order.created event)\n3. Inventory Service consumes event, reserves stock\n### ADR-004: Chose Kafka over RabbitMQ\n- Rationale: Better replay capabilities, higher throughput for order events",
    relatedTools: ["claude", "chatgpt"],
  },
};

export async function getStaticPaths() {
  const slugs = [
    "cursor-middleware", "any-k8s", "perplexity-deep-dive", "chatgpt-simplify",
    "any-data-quality", "any-whitepaper", "any-governance-d", "cursor-refactor-agent",
    "claude-metaphor", "cursor-merge-conf", "mj-cozy-room", "claude-offboard", "any-customer-research", "chatgpt-cover-letter",
    "cursor-graphql-s", "cursor-debug-strategy", "windsurf-fullstack",
    "any-orchestration-d", "chatgpt-learning", "midjourney-info-bg", "deepseek-opt",
    "cursor-new-project-setup", "any-risk-reg",
    "any-churn-pred", "claude-exec-sum",
    "any-comms-plan", "chatgpt-pr-desc", "any-coding-roadmap",
    "any-etl-spec2", "mj-landscape", "any-kb-structure", "any-react-pat",
    "chatgpt-biz-plan", "cursor-worker",

    "any-feature-store", "any-sql-schema", "chatgpt-networking", "mj-tech-render",
    "any-agent-memory", "chatgpt-diff-instruction", "claude-arch-doc", "any-cicd",
  ];
  return slugs.map(slug => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props;
const pageLang = Astro.currentLocale || "en";
const pd = promptData[slug] || { title: slug.replace(/-/g, ' '), description: '', tags: [], useCase: '', exampleOutput: '', relatedTools: [] };
const title = pd.title;
const description = pd.description || '';
const tags = pd.tags || [];
---

<BaseLayout title={`${title} — AI Prompt Template`} description={description} lang={pageLang}>
  <article class="legal-page">
    <nav class="breadcrumbs">
      <a href="/">Home</a> &rsaquo;
      <a href="/prompts/">AI Prompts</a> &rsaquo;
      <span>{title}</span>
    </nav>
    <header class="page-hero">
      <span class="eyebrow">Prompts</span>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {tags.length > 0 && (
        <div style="margin-top: 12px;">
          {tags.map((tag: string) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>
    <section class="article-body">
      <h2>Prompt Template</h2>
      <pre class="prompt-block"><code>{pd.title}</code></pre>
      <h2>Use Case</h2>
      <p>{pd.useCase}</p>
      <h2>Example Output</h2>
      <pre class="prompt-block"><code>{pd.exampleOutput}</code></pre>
      {pd.relatedTools && pd.relatedTools.length > 0 && (
        <>
          <h2>Related Tools</h2>
          <div class="tag-row">
            {pd.relatedTools.map((tid: string) => (
              <a class="tool-pill" href={`/tools/${tid}/`}>{tid}</a>
            ))}
          </div>
        </>
      )}
    </section>
    <section class="related" style="margin-top: 48px;">
      <h2>More Prompts</h2>
      <div class="related-grid">
        {Object.keys(promptData).filter(s => s !== slug).slice(0, 6).map(s => (
          <a class="related-card" href={`/prompts/${s}/`}>
            <div class="related-icon"><i class="fas fa-terminal"></i></div>
            <div>
              <h3>{promptData[s]?.title || s.replace(/-/g, ' ')}</h3>
              <p>{(promptData[s]?.description || '').slice(0, 80)}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>
