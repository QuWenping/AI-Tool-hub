const { slug } = Astro.props;
if (!promptData[slug]) return Astro.redirect('/prompts/', 301);
const pageLang = Astro.currentLocale || "en";
const pd = promptData[slug] || { title: slug.replace(/-/g, ' '), description: '', tags: [], useCase: '', eexampleOutput: '', relatedTools: [] };
const title = pd.title;
const description = pd.description || '';
const tags = pd.tags || [];
---

<BaseLayout title={`${title} — AI Prompt Template`} description={description} lang={pageLang}>
  <article class="legal-page">
    <nav class="breadcrumbs">
      <a href="/">Home</a> &rsaquo;
      <a href="/prompts/">AI Prompts</a> &rsaquo;
      <span>{title}</span>
    </nav>
    <header class="page-hero">
      <span class="eyebrow">Prompts</span>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {tags.length > 0 && (
        <div style="margin-top: 12px;">
          {tags.map((tag: string) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>
    <section class="article-body">
      <h2>Prompt Template</h2>
      <pre class="prompt-block"><code>{pd.title}</code></pre>
      <h2>Use Case</h2>
      <p>{pd.useCase}</p>
      <h2>Example Output</h2>
      <pre class="prompt-block"><code>{pd.exampleOutput}</code></pre>
      {pd.relatedTools && pd.relatedTools.length > 0 && (
        <>
          <h2>Related Tools</h2>
          <div class="tag-row">
            {pd.relatedTools.map((tid: string) => (
              <a class="tool-pill" href={`/tools/${tid}/`}>{tid}</a>
            ))}
          </div>
        </>
      )}
    </section>
    <section class="related" style="margin-top: 48px;">
      <h2>More Prompts</h2>
      <div class="related-grid">
        {Object.keys(promptData).filter(s => s !== slug).slice(0, 6).map(s => (
          <a class="related-card" href={`/prompts/${s}/`}>
            <div class="related-icon"><i class="fas fa-terminal"></i></div>
            <div>
              <h3>{promptData[s]?.title || s.replace(/-/g, ' ')}</h3>
              <p>{(promptData[s]?.description || '').slice(0, 80)}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>
