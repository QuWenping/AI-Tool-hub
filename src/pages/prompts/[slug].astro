---
import BaseLayout from "../../layouts/BaseLayout.astro";
import prompts from "../../data/prompts.json";
import TLDR from "../../components/ui/TLDR.astro";
export async function getStaticPaths() {
  return prompts.map(p => ({ params: { slug: p.slug }, props: { prompt: p } }));
}
const { prompt } = Astro.props;
const siteUrl = "https://thebestaitoolsreview.com";
const pageUrl = siteUrl + "/prompts/" + prompt.slug + "/";
const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","url":pageUrl,"mainEntity":[{ "@type":"Question","name":prompt.title,"acceptedAnswer":{ "@type":"Answer","text":prompt.prompt } }] };
---
<BaseLayout title={prompt.title + " | AI Prompt Library"} description={"Copy-paste prompt: " + prompt.prompt.substring(0, 120)} keywords={prompt.tags.join(", ")}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script></Fragment>
  <div class="article">
    <nav class="breadcrumbs"><a href="/">Home</a> &rsaquo; <a href="/prompts/">Prompt Library</a> &rsaquo; <span>{prompt.title}</span></nav>
    <header class="article-header"><span class="eyebrow">{prompt.category} - {prompt.tool}</span><h1>{prompt.title}</h1></header>
    <section class="article-body">
      <p>Copy and paste this prompt into <strong>{prompt.tool}</strong> or any AI assistant:</p>
    <TLDR items={[
      prompt.title,
      "Tool: " + prompt.tool,
      "Category: " + prompt.category,
      "Tags: " + prompt.tags.join(", ")
    ]} />

      <div class="code-card">
        <button id="cp" class="copy-btn">Copy</button>
        <pre id="pt" class="prompt-code">{prompt.prompt}</pre>
      </div>
      <h2>How to use</h2>
      <ol><li>Copy the prompt above</li><li>Open {prompt.tool} or your AI assistant</li><li>Replace [PLACEHOLDER] text with your needs</li><li>Review and edit the AI output</li></ol>
      <p class="back-link"><a href="/prompts/">Back to Prompt Library</a></p>
    </section>
  </div>
</BaseLayout>
<script is:inline>document.getElementById("cp").addEventListener("click",function(){navigator.clipboard.writeText(document.getElementById("pt").textContent).then(function(){var b=document.getElementById("cp");b.textContent="Copied!";setTimeout(function(){b.textContent="Copy"},2000)})})</script>