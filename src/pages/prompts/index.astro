---
import BaseLayout from "../../layouts/BaseLayout.astro";
import prompts from "../../data/prompts.json";
const cats = [...new Set(prompts.map(p => p.category))];
---
<BaseLayout title="AI Prompt Library | 20+ Copy-Paste Prompts for Every Tool" description="Free AI prompt library. Copy-paste prompts for ChatGPT, Claude, Midjourney, Cursor, Gemini, and more. Categorized by use case." keywords="AI prompts, prompt library, ChatGPT prompts, Claude prompts, Midjourney prompts, copy paste prompts">
  <div class="page-container">
    <nav class="breadcrumbs"><a href="/">Home</a> &rsaquo; <span>Prompt Library</span></nav>
    <h1 class="page-title">AI Prompt Library</h1>
    <p class="page-lede">{prompts.length} copy-paste prompts for every major AI tool. Free to use.</p>

    {cats.map(cat => (
      <section class="list-section">
        <h2 class="list-section-title">{cat}</h2>
        <div class="card-grid">
          {prompts.filter(p => p.category === cat).map(p => (
            <div class="list-card">
              <div class="card-head">
                <h3>{p.title}</h3>
                <span class="tool-pill">{p.tool}</span>
              </div>
              <pre class="prompt-preview">{p.prompt}</pre>
              <div class="tag-row">
                {p.tags.map(t => <span class="tag-chip">#{t}</span>)}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>