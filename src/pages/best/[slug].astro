---
import BaseLayout from "../../layouts/BaseLayout.astro";
import categories from "../../data/categories.json";
import toolsData from "../../data/tools.json";
export async function getStaticPaths() {
  return categories.map(function(cat){return {params:{slug:cat.slug},props:{cat:cat}}});
}
const { cat } = Astro.props;
const matchedTools = cat.tools.map(function(id){return toolsData[id]}).filter(Boolean);
---
<BaseLayout title={cat.title_en} description={cat.desc_en} lang="en">
<article>
<h1>{cat.title_en}</h1>
<p>{cat.desc_en}</p>
<h2>Top 3 Picks</h2>
<ol>
{matchedTools.slice(0, 3).map(function(t){return (<li><a href={"/tool/" + t.id + "/"}><strong>{t.name.en}</strong></a> - {t.short_desc.en}</li>)})}
</ol>
<h2>All Tools</h2>
<ul>
{matchedTools.map(function(t){return (<li><a href={"/tool/" + t.id + "/"}>{t.name.en}</a> - {t.short_desc.en}</li>)})}
</ul>
<h2>Related Categories</h2>
<ul>
{categories.filter(function(c){return c.slug !== cat.slug}).slice(0, 6).map(function(c){return (<li><a href={"/best/" + c.slug + "/"}>{c.title_en}</a></li>)})}
</ul>
</article>
</BaseLayout>
