---
import BaseLayout from "../../layouts/BaseLayout.astro";
import categories from "../../data/categories.json";
import toolsData from "../../data/tools.json";
export async function getStaticPaths() {
  return categories.map(function(cat){return {params:{slug:cat.slug},props:{cat:cat}}});
}
const { cat } = Astro.props;
const matchedTools = cat.tools
  .map(function(id){return Object.assign({id:id}, toolsData[id])})
  .filter(function(t){return t && t.name});
const categoryLabels = { text: "Writing", image: "Image", code: "Code", video: "Video", audio: "Audio", productivity: "Business" };
const catLabel = categoryLabels[matchedTools[0]?.cat] || (matchedTools[0]?.cat || "AI");
const relatedCategories = categories.filter(function(c){return c.slug !== cat.slug}).slice(0, 6);
---
<BaseLayout title={"Best " + cat.title_en + " in 2026"} description={cat.desc_en} keywords={"best AI tools for " + cat.slug + ", " + cat.title_en}>
  <article class="legal-page">
    <nav class="breadcrumbs"><a href="/">Home</a> &rsaquo; <a href="/">Best AI Tools</a> &rsaquo; <span>{cat.title_en}</span></nav>
    <header class="page-hero">
      <span class="eyebrow" data-i18n="eyebrow_best">Best of 2026</span>
      <h1 data-i18n="best_h1_template">{cat.title_en}</h1>
      <p class="lede">{cat.desc_en}</p>
      <p class="update-note"><em data-i18n="last_updated">Last updated</em>: July 2026 &middot; <span data-i18n="we_tested">{`We tested ${matchedTools.length} tools hands-on.`}</span></p>
    </header>

    <section>
      <h2 data-i18n="top_3_picks">Top 3 Picks</h2>
      <div class="tool-grid">
        {matchedTools.slice(0, 3).map(function(t, i){return (
          <a class="tool-card" href={"/tool/" + t.id + "/"}>
            <span class="card-number">#{i+1}</span>
            <div class="tool-icon"><i class={`fas ${t.icon || "fa-robot"}`}></i></div>
            <h3>{t.name.en}</h3>
            <p>{t.short_desc.en}</p>
            <span class="tool-tag">{categoryLabels[t.cat] || t.cat}</span>
          </a>
        )})}
      </div>
    </section>

    <section>
      <h2>Full List: All {matchedTools.length} Tools Ranked</h2>
      <table class="ranking">
        <thead><tr><th>Rank</th><th>Tool</th><th>Best For</th><th>Category</th></tr></thead>
        <tbody>
          {matchedTools.map(function(t, i){return (
            <tr>
              <td>#{i+1}</td>
              <td><a href={"/tool/" + t.id + "/"}><strong>{t.name.en}</strong></a></td>
              <td>{t.pros?.en?.[0] || ""}</td>
              <td>{categoryLabels[t.cat] || t.cat}</td>
            </tr>
          )})}
        </tbody>
      </table>
    </section>

    <section>
      <h2 data-i18n="detailed_reviews">Detailed Reviews</h2>
      {matchedTools.map(function(t){return (
        <article class="tool-review" id={t.id}>
          <header class="tool-review-head">
            <div class="tool-review-icon"><i class={`fas ${t.icon || "fa-robot"}`}></i></div>
            <div>
              <h3><a href={"/tool/" + t.id + "/"}>{t.name.en}</a></h3>
              <p class="short">{t.short_desc.en}</p>
            </div>
          </header>
          <p>{t.long_desc.en}</p>
          <div class="pros-cons-box">
            <div class="pro-list"><strong>Pros:</strong> {(t.pros?.en || []).join(", ")}</div>
            <div class="con-list"><strong>Cons:</strong> {(t.cons?.en || []).join(", ")}</div>
          </div>
          <a class="cta-primary" href={"/tool/" + t.id + "/"}>Read full review</a>
        </article>
      )})}
    </section>

    <section>
      <h2 data-i18n="faq_title">Frequently Asked Questions</h2>
      <div class="faq-section">
        <details><summary>What is the best AI tool for {cat.slug}?</summary><p>Based on our 2-week test, {matchedTools[0]?.name?.en || "ChatGPT"} is the top pick for most {cat.slug} use cases.</p></details>
        <details><summary>Are these tools free?</summary><p>Most have a free tier or trial. Premium plans unlock higher limits.</p></details>
      </div>
    </section>

    <section class="related">
      <h2 data-i18n="related_categories">Related Categories</h2>
      <div class="related-grid">
        {relatedCategories.map(function(c){return (
          <a class="related-card" href={"/best/" + c.slug + "/"}>
            <div class="related-icon"><i class="fas fa-folder-open"></i></div>
            <div>
              <h3>{c.title_en}</h3>
              <p>{c.desc_en}</p>
            </div>
          </a>
        )})}
      </div>
    </section>
  </article>
</BaseLayout>
