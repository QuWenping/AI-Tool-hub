---
import BaseLayout from "../../layouts/BaseLayout.astro";
import categories from "../../data/categories.json";
import toolsData from "../../data/tools.json";
const siteUrl = "https://thebestaitoolsreview.com";
const breadcrumb = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl + "/" },
    { "@type": "ListItem", "position": 2, "name": "Best AI Tools", "item": siteUrl + "/best/" }
  ]
};
---
<BaseLayout title="Best AI Tools in 2026 — Ranked & Hands-On Tested" description="Ranked lists of the best AI tools in every category: writing, coding, image, video, audio, productivity, and more. Every list is hands-on tested with real pros and cons." keywords="best AI tools, best AI tools 2026, AI tool rankings, best AI writing tools, best AI coding tools">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}></script>
  </Fragment>
  <div class="page-container">
    <nav class="breadcrumbs"><a href="/">Home</a> &rsaquo; <span>Best AI Tools</span></nav>
    <h1 class="page-title">Best AI Tools in 2026</h1>
    <p class="page-lede">Hands-on tested, ranked lists across {categories.length} categories. Real reviews, real pros and cons, no pay-to-play rankings.</p>
    <div class="card-grid">
      {categories.map(cat => {
        const count = cat.tools.filter(id => toolsData[id]).length;
        const cleanTitle = cat.title_en.replace(/^Best\s+/i, "").replace(/\s+in\s+2026$/i, "");
        return (
          <a class="list-card" href={`/best/${cat.slug}/`}>
            <div class="card-head">
              <h3>{cleanTitle}</h3>
              <span class="tool-pill">{count} tools</span>
            </div>
            <p class="card-desc">{cat.desc_en}</p>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
