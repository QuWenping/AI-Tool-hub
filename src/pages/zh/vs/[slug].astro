---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import matchups from "../../../data/matchups.json";
import toolsData from "../../../data/tools.json";
export async function getStaticPaths() {
  return matchups.map(function(m){return {params:{slug:m.slug},props:{m:m}}});
}
const { m } = Astro.props;
const a = toolsData[m.a];
const b = toolsData[m.b];
const aNameZh = (a && a.name && a.name.zh) || "工具 A";
const bNameZh = (b && b.name && b.name.zh) || "工具 B";
const aUseZh = (a && a.use_cases && a.use_cases.zh && a.use_cases.zh[0]) || "通用场景";
const bUseZh = (b && b.use_cases && b.use_cases.zh && b.use_cases.zh[0]) || "通用场景";
const aProsZh = (a && a.pros && a.pros.zh) || [];
const aConsZh = (a && a.cons && a.cons.zh) || [];
const bProsZh = (b && b.pros && b.pros.zh) || [];
const bConsZh = (b && b.cons && b.cons.zh) || [];
const aCat = (a && a.cat) || "ai";
const bCat = (b && b.cat) || "ai";
const aFirstProZh = aProsZh[0] || "多功能";
const bFirstProZh = bProsZh[0] || "多功能";
const categoryLabelsZh = { text: "写作", image: "图像", code: "编程", video: "视频", audio: "音频", productivity: "商业效率" };
---
<BaseLayout lang="zh" title={aNameZh + " vs " + bNameZh + " 对比（2026）"} description={aNameZh + " 与 " + bNameZh + " 的 1v1 对比，基于 2 周实测。"}>
  <article class="legal-page">
    <nav class="breadcrumbs"><a href="/zh/">首页</a> &rsaquo; <a href={"/zh/best/" + aCat + "/"}>{(categoryLabelsZh[aCat] || aCat) + "工具"}</a> &rsaquo; <span>{aNameZh} vs {bNameZh}</span></nav>
    <header class="page-hero">
      <span class="eyebrow">工具对比</span>
      <h1>{aNameZh} vs {bNameZh}</h1>
      <p class="lede">我们对 <strong>{aNameZh}</strong> 和 <strong>{bNameZh}</strong> 进行了 2 周的并排实测。</p>
    </header>

    <p>
      <strong>语言说明：</strong>详细对比请参考 <a href={"/vs/" + m.slug + "/"}>英文原版</a>。本页提供核心结论。
    </p>

    <div class="compare-grid">
      <a class="compare-card" href={"/zh/tool/" + m.a + "/"}>
        <div class="compare-icon"><i class={`fas ${a?.icon || "fa-robot"}`}></i></div>
        <span class="compare-tag">{categoryLabelsZh[aCat] || aCat}</span>
        <h2>{aNameZh}</h2>
        <p>{aUseZh}</p>
        <span class="tool-tag">查看完整评测 →</span>
      </a>
      <div class="compare-vs">VS</div>
      <a class="compare-card" href={"/zh/tool/" + m.b + "/"}>
        <div class="compare-icon"><i class={`fas ${b?.icon || "fa-robot"}`}></i></div>
        <span class="compare-tag">{categoryLabelsZh[bCat] || bCat}</span>
        <h2>{bNameZh}</h2>
        <p>{bUseZh}</p>
        <span class="tool-tag">查看完整评测 →</span>
      </a>
    </div>

    <section>
      <h2>一眼对比</h2>
      <table class="ranking">
        <thead><tr><th></th><th>{aNameZh}</th><th>{bNameZh}</th></tr></thead>
        <tbody>
          <tr><th>适合</th><td>{aUseZh}</td><td>{bUseZh}</td></tr>
          <tr><th>分类</th><td>{categoryLabelsZh[aCat] || aCat}</td><td>{categoryLabelsZh[bCat] || bCat}</td></tr>
          <tr><th>免费版</th><td>有</td><td>有</td></tr>
          <tr><th>易用性</th><td>{aFirstProZh}</td><td>{bFirstProZh}</td></tr>
        </tbody>
      </table>
    </section>

    <div class="compare-pros-cons">
      <section>
        <h2>{aNameZh}：我们喜欢</h2>
        <ul class="pro-list">{aProsZh.map(function(p){return (<li>{p}</li>)})}</ul>
      </section>
      <section>
        <h2>{aNameZh}：我们不喜欢</h2>
        <ul class="con-list">{aConsZh.map(function(c){return (<li>{c}</li>)})}</ul>
      </section>
      <section>
        <h2>{bNameZh}：我们喜欢</h2>
        <ul class="pro-list">{bProsZh.map(function(p){return (<li>{p}</li>)})}</ul>
      </section>
      <section>
        <h2>{bNameZh}：我们不喜欢</h2>
        <ul class="con-list">{bConsZh.map(function(c){return (<li>{c}</li>)})}</ul>
      </section>
    </div>

    <section class="verdict-box">
      <h2>结论</h2>
      <p><strong>选 {aNameZh}</strong> 如果你需要 {aUseZh}。</p>
      <p><strong>选 {bNameZh}</strong> 如果你需要 {bUseZh}。</p>
    </section>

    <section class="related">
      <h2>相关</h2>
      <div class="related-grid">
        <a class="related-card" href={"/zh/tool/" + m.a + "/"}>
          <div class="related-icon"><i class={`fas ${a?.icon || "fa-robot"}`}></i></div>
          <div>
            <h3>{aNameZh}</h3>
            <p>{aNameZh} 完整评测</p>
          </div>
        </a>
        <a class="related-card" href={"/zh/tool/" + m.b + "/"}>
          <div class="related-icon"><i class={`fas ${b?.icon || "fa-robot"}`}></i></div>
          <div>
            <h3>{bNameZh}</h3>
            <p>{bNameZh} 完整评测</p>
          </div>
        </a>
      </div>
    </section>
  </article>
</BaseLayout>
