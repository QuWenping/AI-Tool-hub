export async function getStaticPaths() {
  const slugs = [
    "cursor-middleware", "any-k8s", "perplexity-deep-dive", "chatgpt-simplify",
    "any-data-quality", "any-whitepaper", "any-governance-d", "cursor-refactor-agent",
    "claude-metaphor", "cursor-merge-conf", "mj-cozy-room", "claude-offboard", "any-customer-research",
    "chatgpt-cover-letter", "cursor-graphql-s",
    "cursor-debug-strategy", "windsurf-fullstack", "any-orchestration-d",
    "chatgpt-learning", "midjourney-info-bg", "deepseek-opt",
    "cursor-new-project-setup", "any-risk-reg",
    "any-comms-plan", "chatgpt-pr-desc", "any-coding-roadmap",
    "any-etl-spec2", "mj-landscape", "any-kb-structure", "any-react-pat",
    "chatgpt-biz-plan", "cursor-worker", "any-cicd",
  ];
  return slugs.map(slug => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props;
const pageLang = "zh";
const pd = promptDataZh[slug] || { title: slug.replace(/-/g, ' '), description: '', tags: [], useCase: '', exampleOutput: '', relatedTools: [] };
const title = pd.title;
const description = pd.description || '';
const tags = pd.tags || [];
---

<BaseLayout title={`${title} — AI 提示词模板`} description={description} lang={pageLang}>
  <article class="legal-page">
    <nav class="breadcrumbs">
      <a href="/zh/">首页</a> &rsaquo;
      <a href="/zh/prompts/">AI 提示词</a> &rsaquo;
      <span>{title}</span>
    </nav>
    <header class="page-hero">
      <span class="eyebrow">提示词</span>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {tags.length > 0 && (
        <div style="margin-top: 12px;">
          {tags.map((tag: string) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>
    <section class="article-body">
      <h2>提示词模板</h2>
      <pre class="prompt-block"><code>{pd.title}</code></pre>
      <h2>使用场景</h2>
      <p>{pd.useCase}</p>
      <h2>示例输出</h2>
      <pre class="prompt-block"><code>{pd.exampleOutput}</code></pre>
      {pd.relatedTools && pd.relatedTools.length > 0 && (
        <>
          <h2>相关工具</h2>
          <div class="tag-row">
            {pd.relatedTools.map((tid: string) => (
              <a class="tool-pill" href={`/zh/tools/${tid}/`}>{tid}</a>
            ))}
          </div>
        </>
      )}
    </section>
    <section class="related" style="margin-top: 48px;">
      <h2>更多提示词</h2>
      <div class="related-grid">
        {Object.keys(promptDataZh).filter(s => s !== slug).slice(0, 6).map(s => (
          <a class="related-card" href={`/zh/prompts/${s}/`}>
            <div class="related-icon"><i class="fas fa-terminal"></i></div>
            <div>
              <h3>{promptDataZh[s]?.title || s.replace(/-/g, ' ')}</h3>
              <p>{(promptDataZh[s]?.description || '').slice(0, 80)}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>
