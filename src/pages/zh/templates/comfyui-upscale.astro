---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const siteUrl = "https://thebestaitoolsreview.com";
const pageUrl = siteUrl + "/zh/templates/comfyui-upscale/";
const faqItems = [
  { q: "ComfyUI 放大工作流能放大多大？", a: "使用 4x-UltraSharp 等专用放大模型，可将图像从 1024x1024 放大至 4096x4096 甚至更高。配合分块（tiled）处理，理论上可放大至任意尺寸。" }
];
const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","url":pageUrl,"mainEntity": faqItems.map(f => ({ "@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a} })) };
const articleSchema = { "@context":"https://schema.org","@type":"Article","headline":"ComfyUI 图像放大工作流模板","description":"即开即用的 ComfyUI 图像放大工作流，支持 2x/4x 高清放大与细节增强。","url":pageUrl,"author":{"@type":"Organization","name":"AI Tool Hub"},"publisher":{"@type":"Organization","name":"AI Tool Hub"},"datePublished":"2026-07-26","dateModified":"2026-07-26" };
const breadcrumb = { "@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"首页","item":siteUrl+"/zh/"},{"@type":"ListItem","position":2,"name":"模板","item":siteUrl+"/zh/templates/"},{"@type":"ListItem","position":3,"name":"ComfyUI 放大","item":pageUrl}] };
---

<BaseLayout title="ComfyUI 图像放大工作流模板 | AI 工具中心" description="即开即用的 ComfyUI 图像放大工作流，支持 2x/4x 放大与细节增强。" keywords="ComfyUI, 图像放大, upscale, AI超分, 画质增强" lang="zh">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}></script>
  </Fragment>
  <div class="article">
    <nav class="breadcrumbs"><a href="/zh/">首页</a> &rsaquo; <a href="/zh/templates/">模板</a> &rsaquo; <span>ComfyUI 放大</span></nav>
    <header class="article-header">
      <span class="eyebrow">免费模板</span>
      <h1>ComfyUI 图像放大工作流</h1>
      <p>一个即开即用的 ComfyUI 图像放大工作流。支持 2 倍和 4 倍高清放大，保留并增强细节纹理。</p>
    </header>
    <section class="article-body">

      <h2>工作流节点</h2>
      <ol>
        <li><strong>加载图像：</strong>导入需要放大的原始图像</li>
        <li><strong>加载放大模型：</strong>选择放大模型（推荐 4x-UltraSharp 或 4x-AnimeSharp）</li>
        <li><strong>放大图像：</strong>按选定倍率（2x/4x）进行初步放大</li>
        <li><strong>加载 Checkpoint：</strong>加载 SDXL 或 SD1.5 模型用于细节增强</li>
        <li><strong>VAE 编码：</strong>将放大后的图像编码进入潜空间</li>
        <li><strong>KSampler（分块）：</strong>使用低去噪强度（0.2-0.35）增强细节</li>
        <li><strong>VAE 解码：</strong>潜空间转最终输出</li>
        <li><strong>保存图像：</strong>输出放大后的高清图像</li>
      </ol>

      <h2>推荐参数</h2>
      <ul>
        <li><strong>放大模型：</strong>4x-UltraSharp（写实）/ 4x-AnimeSharp（动漫）</li>
        <li><strong>去噪强度：</strong>0.2（保守）/ 0.35（激进增强）</li>
        <li><strong>分块大小：</strong>512-768 px（视显存而定）</li>
      </ul>

      <h2>常见问题</h2>
      <div class="card-grid">
        {faqItems.map(f => (
          <div class="info-card"><h3>{f.q}</h3><p>{f.a}</p></div>
        ))}
      </div>
      <p class="back-link"><a href="/zh/templates/">所有模板</a></p>
    </section>
  </div>
</BaseLayout>
