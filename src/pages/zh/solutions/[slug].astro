---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import solutions from "../../../data/solutions.json";
import workflows from "../../../data/workflows.json";
export async function getStaticPaths() {
  return solutions.map(s => ({ params: { slug: s.slug }, props: { solution: s } }));
}
const { solution } = Astro.props;
const siteUrl = "https://thebestaitoolsreview.com";
const pageUrl = siteUrl + "/zh/solutions/" + solution.slug + "/";
const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","url":pageUrl,"mainEntity": solution.faq.map(f => ({ "@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a} })) };
const articleSchema = { "@context":"https://schema.org","@type":"Article","headline":solution.title_zh || solution.title,"description":solution.desc_zh || solution.description,"author":{"@type":"Organization","name":"AI Tool Hub"},"publisher":{"@type":"Organization","name":"AI Tool Hub"},"mainEntityOfPage":pageUrl,"datePublished":"2026-07-13","dateModified":"2026-07-13" };
const breadcrumb = { "@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"首页","item":siteUrl+"/zh/"},{"@type":"ListItem","position":2,"name":"行业方案","item":siteUrl+"/zh/solutions/"},{"@type":"ListItem","position":3,"name":solution.title_zh || solution.title,"item":pageUrl}] };
const relatedWorkflows = workflows.filter(w => solution.workflows.includes(w.slug));
---
<BaseLayout title={(solution.title_zh || solution.title) + " | AI 行业方案"} description={solution.desc_zh || solution.description} keywords={solution.tools.join(", ")}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}></script>
  </Fragment>
  <div class="article" style="max-width:800px;margin:0 auto;padding:48px 0;">
    <nav class="breadcrumbs"><a href="/zh/">首页</a> &rsaquo; <a href="/zh/solutions/">行业方案</a> &rsaquo; <span>{solution.title_zh || solution.title}</span></nav>
    <header class="article-header">
      <span class="eyebrow">{solution.industry}</span>
      <h1>{solution.title_zh || solution.title}</h1>
    </header>
    <section class="article-body">
      <p style="font-size:16px;color:var(--text-soft);line-height:1.7;">{solution.desc_zh || solution.description}</p>

      <div style="background:var(--card-bg);border:1px solid var(--border-color);border-radius:12px;padding:16px;margin:24px 0;">
        <h3 style="font-size:14px;font-weight:600;margin-bottom:10px;">推荐 AI 工具</h3>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          {solution.tools.map(t => <span style="font-size:13px;color:var(--accent-color);background:rgba(59,130,246,0.08);padding:4px 12px;border-radius:6px;font-weight:500;">{t}</span>)}
        </div>
      </div>

      {solution.sections.map(section => (
        <section style="margin-top:32px;">
          <h2 style="font-size:22px;font-weight:700;margin-bottom:12px;">{section.heading}</h2>
          <p style="font-size:15px;color:var(--text-soft);line-height:1.8;margin-bottom:12px;">{section.content}</p>
        </section>
      ))}

      {relatedWorkflows.length > 0 && (
        <section style="margin-top:40px;">
          <h2 style="font-size:22px;font-weight:700;margin-bottom:16px;">相关工作流</h2>
          <div style="display:grid;gap:12px;">
            {relatedWorkflows.map(w => (
              <a href={"/zh/workflows/" + w.slug + "/"} style="text-decoration:none;color:inherit;display:block;background:var(--card-bg);border:1px solid var(--border-color);border-radius:10px;padding:16px;">
                <h3 style="font-size:15px;font-weight:600;margin:0 0 4px 0;">{w.title_zh || w.title}</h3>
                <p style="font-size:13px;color:var(--text-mute);margin:0;">{w.tool} - {w.steps.length} 步骤</p>
              </a>
            ))}
          </div>
        </section>
      )}

      <section style="margin-top:40px;">
        <h2 style="font-size:22px;font-weight:700;margin-bottom:16px;">常见问题</h2>
        <div style="display:grid;gap:16px;">
          {solution.faq.map(f => (
            <div style="background:var(--card-bg);border:1px solid var(--border-color);border-radius:10px;padding:16px;">
              <h3 style="font-size:15px;font-weight:600;margin-bottom:8px;">{f.q}</h3>
              <p style="font-size:14px;color:var(--text-soft);line-height:1.6;margin:0;">{f.a}</p>
            </div>
          ))}
        </div>
      </section>

      <p style="text-align:center;margin-top:32px;"><a href="/zh/solutions/" style="color:var(--accent-color);font-weight:600;">返回行业方案</a></p>
    </section>
  </div>
</BaseLayout>