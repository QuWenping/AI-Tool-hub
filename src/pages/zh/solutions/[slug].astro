---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import solutions from "../../../data/solutions.json";
import workflows from "../../../data/workflows.json";
export async function getStaticPaths() {
  return solutions.map(s => ({ params: { slug: s.slug }, props: { solution: s } }));
}
const { solution } = Astro.props;
const siteUrl = "https://thebestaitoolsreview.com";
const pageUrl = siteUrl + "/zh/solutions/" + solution.slug + "/";
const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","url":pageUrl,"mainEntity": (solution.faq || []).map(f => ({ "@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a} })) };
const articleSchema = { "@context":"https://schema.org","@type":"Article","headline":solution.title_zh || solution.title,"description":solution.desc_zh || solution.description,"author":{"@type":"Organization","name":"AI Tool Hub"},"publisher":{"@type":"Organization","name":"AI Tool Hub"},"mainEntityOfPage":pageUrl,"datePublished":"2026-07-13","dateModified":"2026-07-13" };
const breadcrumb = { "@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"首页","item":siteUrl+"/zh/"},{"@type":"ListItem","position":2,"name":"行业方案","item":siteUrl+"/zh/solutions/"},{"@type":"ListItem","position":3,"name":solution.title_zh || solution.title,"item":pageUrl}] };
const relatedWorkflows = workflows.filter(w => (solution.workflows || []).includes(w.slug));
---
<BaseLayout title={(solution.title_zh || solution.title) + " | AI 行业方案"} description={solution.desc_zh || solution.description} keywords={(solution.tools || []).join(", ")}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}></script>
  </Fragment>
  <div class="article">
    <nav class="breadcrumbs"><a href="/zh/">首页</a> &rsaquo; <a href="/zh/solutions/">行业方案</a> &rsaquo; <span>{solution.title_zh || solution.title}</span></nav>
    <header class="article-header">
      <span class="eyebrow">{solution.industry}</span>
      <h1>{solution.title_zh || solution.title}</h1>
    </header>
    <section class="article-body">
      <p>{solution.desc_zh || solution.description}</p>

      <div class="info-card">
        <h3>推荐 AI 工具</h3>
        <div class="tag-row">
          {(solution.tools || []).map(t => <span class="tool-pill">{t}</span>)}
        </div>
      </div>

      {(solution.sections || []).map(section => (
        <section class="section-mt">
          <h2>{section.heading}</h2>
          <p>{section.content}</p>
        </section>
      ))}

      {relatedWorkflows.length > 0 && (
        <section class="section-mt">
          <h2>相关工作流</h2>
          <div class="card-grid">
            {relatedWorkflows.map(w => (
              <a class="list-card" href={"/zh/workflows/" + w.slug + "/"}>
                <h3>{w.title_zh || w.title}</h3>
                <p class="card-desc">{w.tool} - {w.steps.length} 步骤</p>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="section-mt">
        <h2>常见问题</h2>
        <div class="card-grid">
          {(solution.faq || []).map(f => (
            <div class="info-card">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </div>
      </section>

      <p class="back-link"><a href="/zh/solutions/">返回行业方案</a></p>
    </section>
  </div>
</BaseLayout>