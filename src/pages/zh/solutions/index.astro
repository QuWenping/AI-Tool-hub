---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import solutions from "../../../data/solutions.json";
---
<BaseLayout title="AI 行业解决方案 | 开发者、营销、教育、企业、创意" description="行业 AI 工具指南：开发者、营销、教育、企业和创意设计。了解哪些 AI 工具适合你的行业。" keywords="AI 解决方案, 开发者 AI, 营销 AI, 教育 AI, 企业 AI, 创意 AI">
  <div class="container" style="max-width:900px;margin:0 auto;padding:48px 24px;">
    <nav class="breadcrumbs" style="margin-bottom:24px;"><a href="/zh/">首页</a> &rsaquo; <span>行业方案</span></nav>
    <h1 style="font-size:32px;font-weight:700;margin-bottom:8px;">AI 行业解决方案</h1>
    <p style="color:var(--text-mute);font-size:16px;margin-bottom:32px;">行业指南：该用哪些 AI 工具、如何组合成工作流、以及实际落地策略。</p>
    <div style="display:grid;gap:20px;">
      {solutions.map(s => (
        <a href={"/zh/solutions/" + s.slug + "/"} style="text-decoration:none;color:inherit;display:block;background:var(--card-bg);border:1px solid var(--border-color);border-radius:12px;padding:24px;transition:border-color 0.2s;" onmouseover="this.style.borderColor='var(--accent-color)'" onmouseout="this.style.borderColor='var(--border-color)'">
          <h2 style="font-size:18px;font-weight:600;margin:0 0 8px 0;">{s.title_zh || s.title}</h2>
          <p style="font-size:14px;color:var(--text-soft);margin:0 0 12px 0;line-height:1.5;">{s.desc_zh || s.description}</p>
          <div style="display:flex;gap:6px;flex-wrap:wrap;">
            {s.tools.slice(0, 5).map(t => <span style="font-size:12px;color:var(--text-mute);background:var(--bg-color);padding:3px 10px;border-radius:5px;">{t}</span>)}
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
