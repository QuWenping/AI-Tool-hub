---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import solutions from "../../../data/solutions.json";
---
<BaseLayout title="AI 行业解决方案 | 开发者、营销、教育、企业、创意" description="行业 AI 工具指南：开发者、营销、教育、企业和创意设计。了解哪些 AI 工具适合你的行业。" keywords="AI 解决方案, 开发者 AI, 营销 AI, 教育 AI, 企业 AI, 创意 AI">
  <div class="container" class="page-container">
    <nav class="breadcrumbs" class="section-mt"><a href="/zh/">首页</a> &rsaquo; <span>行业方案</span></nav>
    <h1 class="page-title">AI 行业解决方案</h1>
    <p class="page-lede">行业指南：该用哪些 AI 工具、如何组合成工作流、以及实际落地策略。</p>
    <div class="card-grid">
      {solutions.map(s => (
        <a href={"/zh/solutions/" + s.slug + "/"} class="list-card">
          <h2>{s.title_zh || s.title}</h2>
          <p class="card-desc">{s.desc_zh || s.description}</p>
          <div class="tag-row">
            {s.tools.slice(0, 5).map(t => <span class="tag-chip">{t}</span>)}
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
