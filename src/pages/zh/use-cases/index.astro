---
import BaseLayout from "../../../layouts/BaseLayout.astro";
const siteUrl = "https://thebestaitoolsreview.com";
const useCases = [
  { slug: "architecture-ai-tools", title: "2026 年建筑设计师最佳 AI 工具", desc: "面向真实项目的生成式设计、渲染与建筑可视化工具实测。" },
  { slug: "bim-ai-tools", title: "2026 年 BIM 工程师最佳 AI 工具", desc: "用于建筑信息建模、碰撞检测与模型自动化的 AI 工具。" },
  { slug: "construction-ai-tools", title: "2026 年施工项目 AI 工具", desc: "用于施工排期、安全、估算与项目管理的 AI 工具。" },
  { slug: "engineering-ai-tools", title: "2026 年工程师 AI 工具", desc: "面向机械与土木工程工作流的设计、分析与自动化工具。" },
];
const breadcrumb = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "首页", "item": siteUrl + "/zh/" },
    { "@type": "ListItem", "position": 2, "name": "使用场景", "item": siteUrl + "/zh/use-cases/" }
  ]
};
---
<BaseLayout title="按使用场景分类的 AI 工具 — 建筑、BIM、施工与工程" description="按使用场景浏览 AI 工具：建筑、BIM、施工与工程。精选清单，全部经过真实上手测试。" keywords="按使用场景分类的AI工具, 建筑AI工具, 施工AI工具, 工程师AI工具">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}></script>
  </Fragment>
  <div class="page-container">
    <nav class="breadcrumbs"><a href="/zh/">首页</a> &rsaquo; <span>使用场景</span></nav>
    <h1 class="page-title">按使用场景分类的 AI 工具</h1>
    <p class="page-lede">面向建筑、BIM、施工与工程工作流、经过真实上手测试的 AI 工具清单。</p>
    <div class="card-grid">
      {useCases.map(uc => (
        <a class="list-card" href={`/zh/use-cases/${uc.slug}/`}>
          <div class="card-head">
            <h3>{uc.title}</h3>
            <span class="tool-pill">使用场景</span>
          </div>
          <p class="card-desc">{uc.desc}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
