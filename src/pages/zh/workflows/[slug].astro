---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import workflows from "../../../data/workflows.json";
export async function getStaticPaths() {
  return workflows.map(w => ({ params: { slug: w.slug }, props: { workflow: w } }));
}
const { workflow } = Astro.props;
const siteUrl = "https://thebestaitoolsreview.com";
const pageUrl = siteUrl + "/zh/workflows/" + workflow.slug + "/";
const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","url":pageUrl,"mainEntity":[{ "@type":"Question","name":workflow.title_zh || workflow.title,"acceptedAnswer":{ "@type":"Answer","text":workflow.summary_zh || workflow.summary } }] };
const howToSchema = { "@context":"https://schema.org","@type":"HowTo","name":workflow.title_zh || workflow.title,"description":workflow.summary_zh || workflow.summary,"step":workflow.steps.map((s, i) => ({ "@type":"HowToStep","position":i+1,"name":s.title,"text":s.detail})) };
const breadcrumb = { "@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"首页","item":siteUrl+"/zh/"},{"@type":"ListItem","position":2,"name":"工作流教程","item":siteUrl+"/zh/workflows/"},{"@type":"ListItem","position":3,"name":workflow.title_zh || workflow.title,"item":pageUrl}] };
const diffColors = { "Beginner": "#22c55e", "Intermediate": "#f59e0b", "Advanced": "#ef4444" };
const diffLabels = { "Beginner": "入门", "Intermediate": "中级", "Advanced": "高级" };
---
<BaseLayout title={(workflow.title_zh || workflow.title) + " | AI 工作流教程"} description={workflow.summary_zh || workflow.summary} keywords={workflow.tags.join(", ")}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}></script>
  </Fragment>
  <div class="article" style="max-width:800px;margin:0 auto;padding:48px 0;">
    <nav class="breadcrumbs"><a href="/zh/">首页</a> &rsaquo; <a href="/zh/workflows/">工作流教程</a> &rsaquo; <span>{workflow.title_zh || workflow.title}</span></nav>
    <header class="article-header">
      <span class="eyebrow">{workflow.tool}</span>
      <h1>{workflow.title_zh || workflow.title}</h1>
      <div style="display:flex;gap:10px;align-items:center;margin-top:12px;flex-wrap:wrap;">
        <span style="font-size:13px;font-weight:600;color:#fff;background:{diffColors[workflow.difficulty] || '#6b7280'};padding:3px 12px;border-radius:999px;">{diffLabels[workflow.difficulty] || workflow.difficulty}</span>
        <span style="font-size:13px;color:var(--text-mute);">{workflow.steps.length} 步骤</span>
      </div>
    </header>
    <section class="article-body">
      <p style="font-size:16px;color:var(--text-soft);line-height:1.7;">{workflow.summary_zh || workflow.summary}</p>

      <div style="background:var(--card-bg);border:1px solid var(--border-color);border-radius:12px;padding:20px;margin:24px 0;">
        <h3 style="font-size:14px;font-weight:600;margin-bottom:12px;">适用场景</h3>
        <p style="font-size:14px;color:var(--text-soft);margin:0;">{workflow.useCase}</p>
      </div>

      <div style="background:rgba(245,158,11,0.05);border:1px solid rgba(245,158,11,0.2);border-radius:12px;padding:16px;margin:24px 0;">
        <h3 style="font-size:14px;font-weight:600;margin-bottom:8px;color:#f59e0b;">前提条件</h3>
        <p style="font-size:14px;color:var(--text-soft);margin:0;">{workflow.prerequisites}</p>
      </div>

      <h2 style="margin-top:32px;">分步指南</h2>
      <ol style="margin:0;padding-left:0;list-style:none;">
        {workflow.steps.map((step, i) => (
          <li style="margin-bottom:24px;padding-left:48px;position:relative;">
            <span style="position:absolute;left:0;top:0;width:32px;height:32px;background:var(--accent-color);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;">{i+1}</span>
            <h3 style="font-size:16px;font-weight:600;margin-bottom:6px;">{step.title}</h3>
            <p style="font-size:14px;color:var(--text-soft);line-height:1.6;margin:0;">{step.detail}</p>
          </li>
        ))}
      </ol>

      <h2 style="margin-top:32px;">标签</h2>
      <div style="display:flex;gap:6px;flex-wrap:wrap;">
        {workflow.tags.map(t => <span style="font-size:12px;color:var(--text-mute);background:var(--bg-color);padding:4px 10px;border-radius:5px;">#{t}</span>)}
      </div>

      <p style="text-align:center;margin-top:32px;"><a href="/zh/workflows/" style="color:var(--accent-color);font-weight:600;">返回工作流教程库</a></p>
    </section>
  </div>
</BaseLayout>