---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import workflows from "../../../data/workflows.json";
const cats = [...new Set(workflows.map(w => w.category))];
const catLabels = { "Automation": "自动化", "Agent": "AI Agent", "Image": "图像", "Data": "数据", "Video": "视频" };
const diffLabels = { "Beginner": "入门", "Intermediate": "中级", "Advanced": "高级" };
---
<BaseLayout title="AI 工作流教程库 | n8n、Dify、ComfyUI、MCP" description="AI 工作流教程：n8n、Dify、ComfyUI、MCP 的详细步骤指南。从入门到高级，涵盖自动化、Agent、图像、数据和视频。" keywords="AI 工作流, n8n 教程, Dify 教程, ComfyUI 教程, MCP 教程, 自动化">
  <div class="container" class="page-container">
    <nav class="breadcrumbs" class="section-mt"><a href="/zh/">首页</a> &rsaquo; <span>工作流教程</span></nav>
    <h1 class="page-title">AI 工作流教程库</h1>
    <p class="page-lede">{workflows.length} 个分步工作流教程，覆盖 n8n、Dify、ComfyUI 和 MCP。从入门到高级。</p>

    {cats.map(cat => (
      <section class="list-section">
        <h2 class="list-section-title">{catLabels[cat] || cat}</h2>
        <div class="card-grid">
          {workflows.filter(w => w.category === cat).map(w => (
            <a href={"/zh/workflows/" + w.slug + "/"} class="list-card">
              <div class="card-head">
                <h3>{w.title_zh || w.title}</h3>
                <span>{diffLabels[w.difficulty] || w.difficulty}</span>
              </div>
              <p class="card-desc">{w.summary_zh || w.summary}</p>
              <div class="tag-row">
                <span class="tool-pill">{w.tool}</span>
                <span class="meta-count">{w.steps.length} 步骤</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
