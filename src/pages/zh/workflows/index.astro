---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import workflows from "../../../data/workflows.json";
const cats = [...new Set(workflows.map(w => w.category))];
const catLabels = { "Automation": "自动化", "Agent": "AI Agent", "Image": "图像", "Data": "数据", "Video": "视频" };
const diffLabels = { "Beginner": "入门", "Intermediate": "中级", "Advanced": "高级" };
const diffColors = { "Beginner": "#22c55e", "Intermediate": "#f59e0b", "Advanced": "#ef4444" };
---
<BaseLayout title="AI 工作流教程库 | n8n、Dify、ComfyUI、MCP" description="AI 工作流教程：n8n、Dify、ComfyUI、MCP 的详细步骤指南。从入门到高级，涵盖自动化、Agent、图像、数据和视频。" keywords="AI 工作流, n8n 教程, Dify 教程, ComfyUI 教程, MCP 教程, 自动化">
  <div class="container" style="max-width:900px;margin:0 auto;padding:48px 24px;">
    <nav class="breadcrumbs" style="margin-bottom:24px;"><a href="/zh/">首页</a> &rsaquo; <span>工作流教程</span></nav>
    <h1 style="font-size:32px;font-weight:700;margin-bottom:8px;">AI 工作流教程库</h1>
    <p style="color:var(--text-mute);font-size:16px;margin-bottom:32px;">{workflows.length} 个分步工作流教程，覆盖 n8n、Dify、ComfyUI 和 MCP。从入门到高级。</p>

    {cats.map(cat => (
      <section style="margin-bottom:40px;">
        <h2 style="font-size:20px;font-weight:700;margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border-color);">{catLabels[cat] || cat}</h2>
        <div style="display:grid;gap:16px;">
          {workflows.filter(w => w.category === cat).map(w => (
            <a href={"/zh/workflows/" + w.slug + "/"} style="text-decoration:none;color:inherit;display:block;background:var(--card-bg);border:1px solid var(--border-color);border-radius:12px;padding:20px;transition:border-color 0.2s;" onmouseover="this.style.borderColor='var(--accent-color)'" onmouseout="this.style.borderColor='var(--border-color)'">
              <div style="display:flex;justify-content:space-between;align-items:start;gap:12px;margin-bottom:8px;">
                <h3 style="font-size:16px;font-weight:600;margin:0;">{w.title_zh || w.title}</h3>
                <span style="font-size:11px;font-weight:600;color:#fff;background:{diffColors[w.difficulty] || '#6b7280'};padding:2px 10px;border-radius:999px;white-space:nowrap;">{diffLabels[w.difficulty] || w.difficulty}</span>
              </div>
              <p style="font-size:14px;color:var(--text-soft);margin:0 0 12px 0;line-height:1.5;">{w.summary_zh || w.summary}</p>
              <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
                <span style="font-size:12px;color:var(--accent-color);background:rgba(59,130,246,0.1);padding:3px 10px;border-radius:6px;font-weight:600;">{w.tool}</span>
                <span style="font-size:12px;color:var(--text-mute);margin-left:auto;">{w.steps.length} 步骤</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
