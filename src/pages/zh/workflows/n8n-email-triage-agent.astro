---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const siteUrl = "https://thebestaitoolsreview.com";
const pageUrl = siteUrl + "/zh/workflows/n8n-email-triage-agent/";
const faqItems = [
  { q: "什么是 n8n 邮件分类智能体？", a: "一个基于 n8n 的自动化工作流，连接邮箱后自动读取新邮件，用 AI 分类优先级、提取关键信息、生成摘要并路由到对应处理队列或人员。" },
  { q: "需要编程基础吗？", a: "不需要。n8n 提供可视化节点编辑器。本模板导入后，只需配置邮箱凭证和 LLM API Key 即可运行。" }
];
const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","url":pageUrl,"mainEntity": faqItems.map(f => ({ "@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a} })) };
const articleSchema = { "@context":"https://schema.org","@type":"Article","headline":"n8n 邮件分类智能体工作流","description":"基于 n8n 的邮件自动分类工作流，用 AI 分类优先级、提取信息并路由到对应队列。","url":pageUrl,author:{"@type":"Organization","name":"AI Tool Hub"},publisher:{"@type":"Organization","name":"AI Tool Hub"},datePublished:"2026-07-26",dateModified:"2026-07-26" };
const breadcrumb = { "@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"首页","item":siteUrl+"/zh/"},{"@type":"ListItem","position":2,"name":"工作流","item":siteUrl+"/zh/workflows/"},{"@type":"ListItem","position":3,"name":"邮件分类智能体","item":pageUrl}] };
---

<BaseLayout title="n8n 邮件分类智能体工作流 | AI 工具中心" description="基于 n8n 的邮件自动分类工作流，用 AI 分类优先级、提取信息并路由到对应队列。" keywords="n8n, 邮件分类, 自动化, AI智能体, 工作流" lang="zh">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}></script>
  </Fragment>
  <div class="article">
    <nav class="breadcrumbs"><a href="/zh/">首页</a> &rsaquo; <a href="/zh/workflows/">工作流</a> &rsaquo; <span>邮件分类智能体</span></nav>
    <header class="article-header">
      <span class="eyebrow">工作流</span>
      <h1>n8n 邮件分类智能体</h1>
      <p>一个基于 n8n 的自动化工作流，连接邮箱后自动读取新邮件，用 AI 分类优先级、提取关键信息、生成摘要并路由到对应处理队列或人员。</p>
    </header>
    <section class="article-body">

      <h2>工作流节点</h2>
      <ol>
        <li><strong>触发器（IMAP/ Gmail）：</strong>监听新邮件到达</li>
        <li><strong>读取邮件内容：</strong>提取发件人、主题、正文、附件</li>
        <li><strong>AI 分类（LLM 节点）：</strong>标注优先级（高/中/低）与类别（销售/支持/账单/其他）</li>
        <li><strong>信息提取：</strong>从正文中抽取关键字段（订单号、截止日期、联系人）</li>
        <li><strong>条件路由：</strong>按类别分流到对应 Slack 频道或 CRM 队列</li>
        <li><strong>自动回复（可选）：</strong>对低优先级邮件发送确认回执</li>
        <li><strong>记录日志：</strong>写入 Google Sheets 或数据库供后续分析</li>
      </ol>

      <h2>配置步骤</h2>
      <ul>
        <li>导入本工作流 JSON 到 n8n</li>
        <li>配置邮箱凭证（IMAP 或 Gmail OAuth）</li>
        <li>填入 LLM API Key（OpenAI / Anthropic / 本地模型）</li>
        <li>设置 Slack/CRM 路由目标</li>
        <li>激活工作流并测试一封邮件</li>
      </ul>

      <h2>常见问题</h2>
      <div class="card-grid">
        {faqItems.map(f => (
          <div class="info-card"><h3>{f.q}</h3><p>{f.a}</p></div>
        ))}
      </div>
      <p class="back-link"><a href="/zh/workflows/">所有工作流</a></p>
    </section>
  </div>
</BaseLayout>
