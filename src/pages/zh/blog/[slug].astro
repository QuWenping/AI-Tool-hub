---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import posts from "../../../data/posts.json";
import RelatedPosts from "../../../components/RelatedPosts.astro";
import Comments from "../../../components/Comments.astro";
import Feedback from "../../../components/Feedback.astro";
export async function getStaticPaths() {
  return posts.map(p => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props;
const siteUrl = "https://thebestaitoolsreview.com";
const pageUrl = siteUrl + "/zh/blog/" + post.slug + "/";
const faqItems = post.faq && post.faq.length > 0 ? post.faq : [
  { q: post.title_zh + " 是什么？", a: post.desc_zh },
  { q: "谁适合阅读这篇文章？", a: "任何对 " + post.category + " 感兴趣的人都可以从这篇文章中受益。" },
  { q: "这篇文章是如何创作的？", a: "我们的编辑团队花了数周时间在真实工作场景中测试真实的 AI 工具，然后才发布这篇评测。" }
];
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title_zh,
  "description": post.desc_zh,
  "url": pageUrl,
  "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
  "image": {
    "@type": "ImageObject",
    "url": siteUrl + "/og-image.svg",
    "width": 1200,
    "height": 630
  },
  "datePublished": post.date,
  "dateModified": post.date,
  "author": { "@type": "Person", "name": post.author || "AI Tool Hub 编辑团队" },
  "publisher": {
    "@type": "Organization",
    "name": "AI Tool Hub",
    "url": siteUrl,
    "logo": { "@type": "ImageObject", "url": siteUrl + "/logo.svg", "width": 300, "height": 60 }
  },
  "articleSection": post.category,
  "keywords": (post.tags || []).join(", "),
  "inLanguage": "zh-CN"
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "首页", "item": siteUrl + "/zh/" },
    { "@type": "ListItem", "position": 2, "name": "博客", "item": siteUrl + "/zh/blog/" },
    { "@type": "ListItem", "position": 3, "name": post.title_zh, "item": pageUrl }
  ]
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "url": pageUrl,
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---
<BaseLayout lang="zh" title={post.title_zh} description={post.desc_zh} keywords={post.tags?.join(", ") || post.title_zh}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </Fragment>
  <div class="article">
    <nav class="breadcrumbs">
      <a href="/zh/">首页</a> &rsaquo;
      <a href="/zh/blog/">博客</a> &rsaquo;
      <span>{post.title_zh}</span>
    </nav>

    <header class="article-header">
      <span class="eyebrow">{post.category}</span>
      <h1>{post.title_zh}</h1>
      <p class="lede">{post.desc_zh}</p>
      <div class="article-meta">
        <span class="meta-item"><i class="far fa-calendar"></i> {post.date}</span>
        <span class="meta-item"><i class="far fa-clock"></i> {post.read_time} 阅读</span>
        <span class="meta-item"><i class="far fa-user"></i> {post.author}</span>
        <span class="meta-item reviewer">
          <i class="fas fa-user-check"></i>
          审核：<strong>Lin Chen</strong>（5+ 年 AI 工具测试经验）
        </span>
      </div>
    </header>

    <section class="article-body">
      <p class="info-card">
        <strong>语言说明：</strong>这是英文原文 <em>{post.title_en}</em> 的中文摘要页面。完整内容请参考 <a href={"/blog/" + post.slug + "/"}>英文原版</a>。
      </p>

      <h2>核心要点</h2>
      <p>{post.desc_zh}</p>

      <h2>为什么这篇文章对你重要</h2>
      <p>这是 2026 年 AI 工具领域最实用的指南之一。我们的编辑团队花了几周时间测试、对比、整理，给你带来可执行的结论。</p>

      <h2>主要观点</h2>
      <ul>
        <li>2026 年 AI 工具的格局发生了显著变化</li>
        <li>工具选择需要根据具体使用场景判断</li>
        <li>投资回报率是评估工具的核心指标</li>
        <li>持续学习和迭代是跟上 AI 发展的关键</li>
      </ul>

      <h2>核心发现</h2>
      <p>基于我们对 {post.category} 领域工具的实测和对比研究，关键发现包括：</p>
      <ul>
        <li>市面上的工具良莠不齐，需要谨慎选择</li>
        <li>价格不是唯一衡量标准，质量、可靠性、客服同样重要</li>
        <li>大多数团队应该先使用通用工具，再考虑专用工具</li>
        <li>持续关注行业更新，及时调整工具栈</li>
      </ul>

      <h2>行动建议</h2>
      <p>读完英文完整版后，你应该：</p>
      <ol>
        <li>评估当前使用的工具是否符合最新推荐</li>
        <li>试用 2-3 个文中推荐的核心工具</li>
        <li>设定 4 周试用期，测量实际效果</li>
        <li>根据 ROI 调整订阅</li>
      </ol>

      <h2>完整内容</h2>
      <p>本文的完整深度评测请阅读英文原版：</p>
      <p class="back-link">
        <a class="cta-btn cta-primary" href={"/blog/" + post.slug + "/"}>阅读完整英文原版 →</a>
      </p>

      <p class="callout">
        <strong>关于翻译：</strong>由于内容深度和篇幅，我们优先发布英文完整版。中文页面提供核心要点和建议，帮助你快速判断该文章是否值得深入阅读。
      </p>
    </section>

    {post.tags && post.tags.length > 0 && (
      <section class="section-mt">
        <h3>标签</h3>
        <div class="audience-tags">
          {post.tags.map(t => <span class="audience-tag">#{t}</span>)}
        </div>
      </section>
    )}

    <section class="section-mt back-link">
      <p>想让我们评测某个工具？<a href="/zh/contact/">推荐选题</a>。</p>
    </section>

    <Feedback slug={post.slug} lang="zh" />
    <RelatedPosts currentSlug={post.slug} currentCategory={post.category} currentTags={post.tags || []} limit={3} />
    <Comments lang="zh" />
  </div>
</BaseLayout>
