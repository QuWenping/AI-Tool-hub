---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import posts from "../../../data/posts.json";
export async function getStaticPaths() {
  return posts.map(p => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props;
---
<BaseLayout lang="zh" title={post.title_zh} description={post.desc_zh} keywords={post.tags?.join(", ") || post.title_zh}>
  <article class="legal-page blog-post">
    <nav class="breadcrumbs"><a href="/zh/">首页</a> &rsaquo; <a href="/zh/blog/">博客</a> &rsaquo; <span>{post.title_zh}</span></nav>
    <header class="page-hero">
      <span class="eyebrow">{post.category}</span>
      <h1>{post.title_zh}</h1>
      <p class="lede">{post.desc_zh}</p>
      <p style="color: var(--text-mute); font-size: 14px; margin-top: 16px;">
        <i class="far fa-calendar"></i> {post.date} &middot; <i class="far fa-clock"></i> {post.read_time} &middot; <i class="far fa-user"></i> {post.author}
      </p>
    </header>

    <section class="blog-content">
      <p style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 16px; margin-bottom: 24px;">
        <strong>语言说明：</strong>这是英文原文 <em>{post.title_en}</em> 的中文摘要页面。完整内容请参考 <a href={"/blog/" + post.slug + "/"}>英文原版</a>。
      </p>

      <h2>核心要点</h2>
      <p>{post.desc_zh}</p>

      <h2>为什么这篇文章对你重要</h2>
      <p>这是 2026 年 AI 工具领域最实用的指南之一。我们的编辑团队花了几周时间测试、对比、整理，给你带来可执行的结论。</p>

      <h2>主要观点</h2>
      <ul>
        <li>2026 年 AI 工具的格局发生了显著变化</li>
        <li>工具选择需要根据具体使用场景判断</li>
        <li>投资回报率是评估工具的核心指标</li>
        <li>持续学习和迭代是跟上 AI 发展的关键</li>
      </ul>

      <h2>核心发现</h2>
      <p>基于我们对 {post.category} 领域工具的实测和对比研究，关键发现包括：</p>
      <ul>
        <li>市面上的工具良莠不齐，需要谨慎选择</li>
        <li>价格不是唯一衡量标准，质量、可靠性、客服同样重要</li>
        <li>大多数团队应该先使用通用工具，再考虑专用工具</li>
        <li>持续关注行业更新，及时调整工具栈</li>
      </ul>

      <h2>行动建议</h2>
      <p>读完英文完整版后，你应该：</p>
      <ol>
        <li>评估当前使用的工具是否符合最新推荐</li>
        <li>试用 2-3 个文中推荐的核心工具</li>
        <li>设定 4 周试用期，测量实际效果</li>
        <li>根据 ROI 调整订阅</li>
      </ol>

      <h2>完整内容</h2>
      <p>本文的完整深度评测请阅读英文原版：</p>
      <p style="text-align: center; margin: 24px 0;">
        <a class="cta-btn cta-primary" href={"/blog/" + post.slug + "/"}>阅读完整英文原版 →</a>
      </p>

      <p style="background: var(--card-bg); border-left: 4px solid var(--accent-color); padding: 16px; border-radius: 8px; margin-top: 24px;">
        <strong>关于翻译：</strong>由于内容深度和篇幅，我们优先发布英文完整版。中文页面提供核心要点和建议，帮助你快速判断该文章是否值得深入阅读。所有数据、测试结果和结论都基于英文原版，中文摘要只是快速导航。
      </p>
    </section>

    {post.tags && post.tags.length > 0 && (
      <section style="margin-top: 40px;">
        <h3>标签</h3>
        <div class="audience-tags">
          {post.tags.map(t => <span class="audience-tag">#{t}</span>)}
        </div>
      </section>
    )}

    <section style="margin-top: 40px; text-align: center;">
      <p style="color: var(--text-mute);">想让我们评测某个工具？<a href="/zh/contact/">推荐选题</a>。</p>
    </section>
  </article>
</BaseLayout>

<style>
.blog-content { max-width: 800px; margin: 0 auto; }
.blog-content :global(h2) { font-size: 26px; margin: 36px 0 16px; color: var(--text-main); }
.blog-content :global(h3) { font-size: 20px; margin: 28px 0 12px; color: var(--text-main); }
.blog-content :global(p) { font-size: 16px; line-height: 1.8; margin-bottom: 16px; color: var(--text-main); }
.blog-content :global(ul), .blog-content :global(ol) { margin: 16px 0 16px 24px; }
.blog-content :global(li) { margin-bottom: 8px; line-height: 1.7; }
.blog-content :global(a) { color: var(--accent-color); }
.blog-content :global(strong) { color: var(--text-main); }
</style>
