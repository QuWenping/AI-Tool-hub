---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import posts from "../../../data/posts.json";
const sortedPosts = [...posts].sort((a, b) => b.date.localeCompare(a.date));
---
<BaseLayout lang="zh" title="博客 - AI Tool Hub" description="AI Tool Hub 编辑团队撰写的深度指南、排名榜和 AI 工具人工实测评测。">
  <article class="legal-page">
    <nav class="breadcrumbs"><a href="/zh/">首页</a> &rsaquo; <span>博客</span></nav>
    <header class="page-hero">
      <span class="eyebrow">深度指南</span>
      <h1>博客</h1>
      <p class="lede">来自 AI Tool Hub 编辑团队的深度指南、人工实测评测和精选榜单。每周更新。</p>
    </header>

    <section>
      <div class="related-grid">
        {sortedPosts.map(p => (
          <a class="related-card" href={"/zh/blog/" + p.slug + "/"}>
            <div class="related-icon"><i class="fas fa-newspaper"></i></div>
            <div>
              <h3>{p.title_zh}</h3>
              <p>{p.desc_zh}</p>
              <p style="font-size: 12px; color: var(--text-mute); margin-top: 6px;">
                <i class="far fa-calendar"></i> {p.date} &middot; <i class="far fa-clock"></i> {p.read_time}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section style="margin-top: 40px; text-align: center;">
      <p style="color: var(--text-mute);">更多文章即将推出。有选题建议？<a href="/zh/contact/">告诉我们</a>。</p>
    </section>
  </article>
</BaseLayout>
