---

import fs from "fs";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import toolsData from "../../../data/tools.json";
import matchupsData from "../../../data/matchups.json";
import categories from "../../../data/categories.json";
import editorialData from "../../../data/tool-editorial.json";
import { catLabel, hasZh } from "../../../utils/i18n";
import TLDR from "../../../components/ui/TLDR.astro";
import ProsCons from "../../../components/ui/ProsCons.astro";
import QuickFacts from "../../../components/ui/QuickFacts.astro";
import FeatureTable from "../../../components/ui/FeatureTable.astro";
import TestStatus from "../../../components/ui/TestStatus.astro";
import ToolFAQ from "../../../components/ui/ToolFAQ.astro";
import ScreenshotGallery from "../../../components/ui/ScreenshotGallery.astro";
import ScoreCard from "../../../components/ui/ScoreCard.astro";
import SaveButton from "../../../components/ui/SaveButton.astro";

import { getTranslations } from "../../../utils/i18n";
const pageLang = "zh";
const t = getTranslations("tool", pageLang);


export async function getStaticPaths() {
  return Object.entries(toolsData)
    .filter(([id]) => id !== "codewords" && editorialData[id]?.reviewed === true)
    .map(([id, tool]) => ({ params: { slug: id }, props: { id, tool } }));
}

const { id, tool } = Astro.props;
const editorial = editorialData[id] || null;
const isReviewed = !!(editorial && editorial.reviewed);

const tNameEn = tool?.name?.en || "AI Tool";
const tShortEn = tool?.short_desc?.en || "";
const tLongEn = tool?.long_desc?.en || "";
const tProsEn = tool?.pros?.en || [];
const tConsEn = tool?.cons?.en || [];
const tUseEn = tool?.use_cases?.en || [];
const tFeaturesEn = tool?.features?.en || [];
const tScenesEn = tool?.scenes?.en || [];
const tAudienceEn = tool?.target_audience?.en || [];
const tExampleEn = tool?.example?.en || "";
const tCat = tool?.cat || "productivity";
const tUrl = tool?.url || "#";
const tIcon = tool?.icon || "fa-robot";

// i18n: localized versions with en fallback
const tName = pageLang === "zh" ? (tool?.name?.zh || tNameEn) : tNameEn;
const tShort = pageLang === "zh" ? (tool?.short_desc?.zh || tShortEn) : tShortEn;
const tLong = pageLang === "zh" ? (tool?.long_desc?.zh || tLongEn) : tLongEn;
const zhAvailable = hasZh(tool, "name");

const categoryLabels = { text: "Writing", image: "Image", code: "Coding", video: "Video", audio: "Audio", productivity: "Productivity" };
const catLabelEn = categoryLabels[tCat] || tCat;

const relatedCategories = categories.filter(c => c.tools?.includes(id)).slice(0, 4);
const allTools = Object.entries(toolsData).filter(([k, v]) => k !== "codewords" && !v?.hidden);
const alternatives = allTools.filter(([k, t]) => k !== id && t.cat === tCat).slice(0, 6);
const directMatchups = matchupsData.filter(m => m.a === id || m.b === id).slice(0, 4);
const clusterFallbackMatchups = matchupsData.filter(m => m.cluster === tCat && m.a !== id && m.b !== id).slice(0, 4);
const toolMatchups = directMatchups.length > 0 ? directMatchups : clusterFallbackMatchups;

// Screenshot resolution: prefer WebP over JPG when same basename exists
const screenshotDir = `public/images/tools/${id}`;
const hasScreenshots = fs.existsSync(screenshotDir);
let screenshotFiles = [];
if (hasScreenshots) {
  const all = fs.readdirSync(screenshotDir).filter(f => /\.(jpg|jpeg|png|webp|avif)$/i.test(f));
  const map = new Map();
  for (const file of all) {
    const base = file.replace(/\.[^.]+$/, "");
    const ext = file.split(".").pop().toLowerCase();
    const rank = ext === "avif" ? 3 : ext === "webp" ? 2 : 1;
    const existing = map.get(base);
    if (!existing || rank > existing.rank) {
      map.set(base, { file, rank });
    }
  }
  screenshotFiles = [...map.values()].map(x => x.file).sort().slice(0, 4);
}
const screenshotImages = screenshotFiles.map((sf, i) => ({
  src: `/images/tools/${id}/${sf}`,
  alt: `${tNameEn} screenshot ${i + 1}`
}));

const siteUrl = "https://thebestaitoolsreview.com";
const pageUrl = siteUrl + "/tool/" + id + "/";
const appCategoryMap = { text: "WritingApplication", image: "MultimediaApplication", code: "DeveloperApplication", video: "MultimediaApplication", audio: "MultimediaApplication", productivity: "BusinessApplication" };
const appCategory = appCategoryMap[tCat] || "MultimediaApplication";

// Rating: prefer editorial score, fallback for reviewed tools
const editorialScore = editorial?.score;
const rating = editorialScore || null;
const scoreBreakdown = editorial?.scoreBreakdown || null;

// Pricing: prefer editorial pricingSummary, fall back to catalog pricing field
const pricingSummaryEn = editorial?.pricingSummary?.en
  || (typeof tool?.pricing === "object" && tool?.pricing?.en)
  || (typeof tool?.pricing === "string" ? tool.pricing : "")
  || "";

const quickFactsEn = [
  { label: "Category", value: catLabelEn },
  editorial?.testedVersion && { label: "Tested version", value: editorial.testedVersion },
  editorial?.quickFacts?.freeTier != null && { label: "Free tier", value: editorial.quickFacts.freeTier ? "Yes" : "No" },
  editorial?.quickFacts?.hasApi != null && { label: "API", value: editorial.quickFacts.hasApi ? "Available" : "Not available" },
  editorial?.quickFacts?.platforms?.length && { label: "Platforms", value: editorial.quickFacts.platforms.join(", ") },
  pricingSummaryEn && { label: "Pricing", value: pricingSummaryEn },
  { label: "Official site", value: tUrl.replace(/^https?:\/\//, "").split("/")[0] || "Visit", href: tUrl, rel: "nofollow noopener", external: true },
  editorial?.updatedAt && { label: "Updated", value: editorial.updatedAt },
  { label: "Editorial status", value: isReviewed ? "Editorially reviewed" : "AI-catalogued, pending review" }
].filter(Boolean);

const featureRowsEn = tFeaturesEn.map((f, i) => ({
  feature: f,
  description: tUseEn[i] || tScenesEn[i] || ""
}));

const faqItems = editorial?.faq || [];
// Default SEO FAQs for all tool pages (covers "is X free", "X alternatives", "X API" keywords)
const defaultFaqs = [
  { q_en: "Is " + tNameEn + " free to use?", a_en: (editorial?.quickFacts?.freeTier ? "Yes, " + tNameEn + " has a free tier. " + (pricingSummaryEn || "Check the official pricing page for details.") : "Check the official " + tNameEn + " pricing page for current plans and free trial availability.") },
  { q_en: "What is " + tNameEn + " best for?", a_en: tNameEn + " is best for " + (tUseEn[0] || tScenesEn[0] || "general " + catLabelEn.toLowerCase() + " tasks") + ". " + (tProsEn[0] ? "Its key strength is " + tProsEn[0].toLowerCase() + "." : "") },
  { q_en: "What are the best " + tNameEn + " alternatives?", a_en: "Top alternatives to " + tNameEn + " include " + (alternatives.length >= 3 ? alternatives.slice(0, 3).map(function(x) { return x[1].name?.en || x[0]; }).join(", ") : "other " + catLabelEn.toLowerCase() + " AI tools") + ". See our alternatives page for a full comparison." },
  { q_en: "Does " + tNameEn + " have an API?", a_en: (editorial?.quickFacts?.hasApi ? "Yes, " + tNameEn + " offers an API for developers. " : "Check the official " + tNameEn + " website for API availability and documentation.") }
];
// Use editorial FAQs if available, otherwise use defaults; merge if both exist
const allFaqs = faqItems.length > 0 ? faqItems : defaultFaqs;

// Editorial narrative (now sourced from tool-editorial.json)
const ourIntro = editorial?.editorialIntro || `${tNameEn}. ${tLongEn || tShortEn}`;
const ourVerdict = editorial?.editorialVerdict || {
  best: `${tNameEn} is a fit if you need a reliable ${catLabelEn.toLowerCase()} AI tool with ${tProsEn[0] ? tProsEn[0].toLowerCase() : "solid fundamentals"}.`,
  avoid: `${tNameEn} is not the right fit if you need capabilities outside ${catLabelEn.toLowerCase()} — look at the alternatives below.`
};

// Structured data
const seoTitle = pageLang === "zh"
  ? (isReviewed ? `${tName} 评测 2026：功能、价格、替代品与使用场景` : `${tName}：功能、价格、替代品与使用场景`)
  : (isReviewed ? `${tNameEn} Review 2026: Features, Pricing, Alternatives & Use Cases` : `${tNameEn}: Features, Pricing, Alternatives & Use Cases`);
const seoDescription = pageLang === "zh"
  ? `${tName}${isReviewed ? "评测" : "概览"} 2026 — ${tShortEn || `${catLabelEn.toLowerCase()} AI 工具`}。`.slice(0, 158)
  : `${tNameEn} ${isReviewed ? "review" : "overview"} for 2026 — ${tShortEn || `a ${catLabelEn.toLowerCase()} AI tool`}. Features, pricing, pros/cons, alternatives and FAQs.`.slice(0, 158);

const pageLangcode = pageLang === "zh" ? "zh" : "en";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: tName,
  description: tShortEn || tLongEn,
  url: pageUrl,
  image: siteUrl + "/og-image.svg",
  applicationCategory: appCategory,
  operatingSystem: "Web, iOS, Android",
  author: { "@type": "Organization", name: "AI Tool Hub Editorial", url: siteUrl },
  publisher: { "@type": "Organization", name: "AI Tool Hub", url: siteUrl },
  inLanguage: pageLangcode
};
if (isReviewed && rating) {
  softwareSchema.review = {
    "@type": "Review",
    author: { "@type": "Person", name: "AI Tool Hub Editorial Team", jobTitle: "Lead Reviewer", url: siteUrl + "/team/" },
    publisher: { "@type": "Organization", name: "AI Tool Hub", url: siteUrl },
    datePublished: editorial?.updatedAt || "2026-07-01",
    reviewRating: { "@type": "Rating", ratingValue: rating, bestRating: 10, worstRating: 1 }
  };
}
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl + "/" },
    { "@type": "ListItem", position: 2, name: "Best " + catLabelEn, item: siteUrl + "/best/" + tCat + "/" },
    { "@type": "ListItem", position: 3, name: tNameEn, item: pageUrl }
  ]
};

const tocSections = [
  { id: "overview", label: t("tocOverview", { name: tName }) },
  { id: "our-take", label: t("ourTakeHeading") },
  screenshotImages.length > 0 && { id: "screenshots", label: t("screenshotsHeading") },
  { id: "test-status-heading", label: t("tocTestData") },
  featureRowsEn.length > 0 && { id: "features", label: t("featuresHeading") },
  tUseEn.length > 0 && { id: "use-cases", label: t("useCasesCol") },
  tScenesEn.length > 0 && { id: "best-for", label: t("bestForHeading") },
  tAudienceEn.length > 0 && { id: "audience", label: t("audienceHeading") },
  { id: "pricing", label: t("pricingCol") },
  (tProsEn.length + tConsEn.length > 0) && { id: "pros-cons", label: t("tocProsCons") },
  tExampleEn && { id: "example", label: t("exampleHeading") },
  { id: "verdict", label: t("verdictHeading") },
  toolMatchups.length > 0 && { id: "comparisons", label: t("tocComparisons") },
  alternatives.length > 0 && { id: "alternatives", label: t("alternatives") },
  faqItems.length > 0 && { id: "tool-faq-heading", label: "FAQ" },
  relatedCategories.length > 0 && { id: "related", label: t("relatedHeading") }
].filter(Boolean);

---
<BaseLayout
  title={seoTitle}
  description={seoDescription}
  keywords={`${tName}, ${tNameEn} review, ${tNameEn} pricing, ${catLabelEn} AI tools`}
  lang={pageLang}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  </Fragment>
  <article class="tool-detail">
  <div class="article-grid">
    <div class="article-main">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">{t("home")}</a> &rsaquo;
      <a href={"/best/" + tCat + "/"}>Best {pageLang === "zh" ? catLabel(tCat, "zh") : catLabelEn}</a> &rsaquo;
      <span>{tName}</span>
    </nav>

    <header class="tool-detail-header">
      <div class="icon" aria-hidden="true"><i class={`fas ${tIcon}`}></i></div>
      <div class="title-group">
        <h1>{tName}</h1>
        <div class="tool-detail-meta">
          <span class="tag">{pageLang === "zh" ? catLabel(tCat, "zh") : catLabelEn}</span>
          {isReviewed && rating && (
            <span class="tool-rating-inline">
              <i class="fas fa-star" aria-hidden="true"></i>
              <strong>{rating.toFixed(1)}</strong><span>/10</span>
            </span>
          )}
          {isReviewed
            ? <span class="status-badge status-badge--reviewed"><i class="fas fa-check-circle" aria-hidden="true"></i> {t("editorReviewed")}</span>
            : <span class="status-badge status-badge--pending"><i class="fas fa-info-circle" aria-hidden="true"></i> {t("aiCatalogued")}</span>}
          {editorial?.updatedAt && (
            <span class="tool-detail-updated"><i class="fas fa-sync-alt" aria-hidden="true"></i> {t("updated")}{editorial.updatedAt}</span>
          )}
        </div>
      </div>
      <div class="actions">
        <a class="use" href={tUrl} rel="nofollow noopener" target="_blank">
          <i class="fas fa-external-link-alt" aria-hidden="true"></i> {t("visit")}{tName}
        </a>
        <a class="alt" href={"/alternatives/" + id + "/"}>{t("alternatives")}</a>
        <SaveButton toolId={id} toolName={tName} lang="zh" />
      </div>
    </header>

    <p class="lede">{tShort}</p>

    <QuickFacts items={quickFactsEn} />

    {isReviewed && rating && scoreBreakdown && (
      <ScoreCard score={rating} breakdown={scoreBreakdown} toolName={tNameEn} />
    )}

    <TLDR items={[
      `${tName} is a ${catLabelEn.toLowerCase()} AI tool: ${tShort || tLong || "an AI-powered helper"}.`,
      pricingSummaryEn ? `Pricing: ${pricingSummaryEn}` : "Pricing: see the official plan page for current pricing.",
      `Best for: ${tUseEn[0] || tScenesEn[0] || "general " + catLabelEn.toLowerCase() + " tasks"}.`,
      isReviewed
        ? `Editorially reviewed by AI Tool Hub${editorial?.testedVersion ? ` (tested version: ${editorial.testedVersion})` : ""}.`
        : "Catalogued by AI Tool Hub — full hands-on review pending."
    ]} />

    <section class="detail-section">
      <h2 id="overview"><i class="fas fa-info-circle" aria-hidden="true"></i> {t("overviewHeading", { name: tName })}</h2>
      <p>{tLong || tShort}</p>
    </section>

    <section class="detail-section">
      <h2 id="our-take"><i class="fas fa-user-edit" aria-hidden="true"></i> {t("ourTakeHeading")}</h2>
      <p>{ourIntro}</p>
    </section>

    {screenshotImages.length > 0 && (
      <section class="detail-section">
        <h2 id="screenshots"><i class="fas fa-images" aria-hidden="true"></i> {t("screenshotsHeading")}</h2>
        <ScreenshotGallery images={screenshotImages} columns={screenshotImages.length >= 3 ? 3 : 2} />
      </section>
    )}

    <TestStatus data={editorial?.realTest} toolName={tNameEn} reviewed={isReviewed} testedVersion={editorial?.testedVersion} />

    {featureRowsEn.length > 0 && (
      <section class="detail-section">
        <h2 id="features"><i class="fas fa-star" aria-hidden="true"></i> {t("featuresHeading")}</h2>
        <FeatureTable rows={featureRowsEn} />
      </section>
    )}

    {tUseEn.length > 0 && (
      <section class="detail-section">
        <h2 id="use-cases"><i class="fas fa-rocket" aria-hidden="true"></i> {t("useCasesHeading")}</h2>
        <ul class="pros-list">
          {tUseEn.map(u => <li>{u}</li>)}
        </ul>
      </section>
    )}

    {tScenesEn.length > 0 && (
      <section class="detail-section">
        <h2 id="best-for"><i class="fas fa-bullseye" aria-hidden="true"></i> {t("bestForHeading")}</h2>
        <ul class="pros-list">
          {tScenesEn.map(s => <li>{s}</li>)}
        </ul>
      </section>
    )}

    {tAudienceEn.length > 0 && (
      <section class="detail-section">
        <h2 id="audience"><i class="fas fa-users" aria-hidden="true"></i> {t("audienceHeading")}</h2>
        <div class="audience-tags">
          {tAudienceEn.map(a => <span class="audience-tag">{a}</span>)}
        </div>
      </section>
    )}

    <section class="detail-section pricing-section">
      <h2 id="pricing"><i class="fas fa-tag" aria-hidden="true"></i> {t("pricingCol")}</h2>
      {pricingSummaryEn
        ? <p>{pricingSummaryEn}</p>
        : <p><span class="status-badge status-badge--pending"><i class="fas fa-hourglass-half" aria-hidden="true"></i> {t("pricingPending")}</span> {t("pricingSeeOfficial")}</p>}
      <p class="pricing-note"><a href={tUrl} rel="nofollow noopener" target="_blank">{t("pricingVisit", { name: tName })}</a></p>
    </section>

    {tProsEn.length + tConsEn.length > 0 && (
      <section class="detail-section">
        <h2 id="pros-cons"><i class="fas fa-balance-scale" aria-hidden="true"></i> {t("prosConsHeading")}</h2>
        <ProsCons pros={tProsEn} cons={tConsEn} />
      </section>
    )}

    {tExampleEn && (
      <section class="detail-section">
        <h2 id="example"><i class="fas fa-terminal" aria-hidden="true"></i> {t("exampleHeading")}</h2>
        <div class="example-box">{tExampleEn}</div>
      </section>
    )}

    <section class="detail-section verdict-block">
      <h2 id="verdict"><i class="fas fa-gavel" aria-hidden="true"></i> {t("verdictHeading")}</h2>
      <p><strong>{t("verdictPick", { name: tName })}}</strong> {ourVerdict.best}</p>
      <p><strong>{t("verdictSkip", { name: tName })}}</strong> {ourVerdict.avoid}</p>
    </section>

    {toolMatchups.length > 0 && (
      <section class="detail-section">
        <h2 id="comparisons"><i class="fas fa-scale-balanced" aria-hidden="true"></i> {t("comparisonsHeading")}</h2>
        <div class="comparison-grid">
          {toolMatchups.map(m => {
            const otherId = m.a === id ? m.b : m.a;
            const otherTool = toolsData[otherId];
            if (!otherTool) return null;
            const otherName = otherTool.name?.en || otherId;
            return (
              <a class="comparison-card" href={"/vs/" + m.slug + "/"}>
                <strong>{tName}</strong> <span>{t("vs")}</span> <strong>{otherName}</strong>
              </a>
            );
          })}
        </div>
        <p class="section-followup"><a href={"/alternatives/" + id + "/"}>{t("alternativesSeeAll", { name: tName })}</a></p>
      </section>
    )}

    {alternatives.length > 0 && (
      <section class="detail-section">
        <h2 id="alternatives"><i class="fas fa-exchange-alt" aria-hidden="true"></i> {t("alternativesHeading", { name: tName })}</h2>
        <div class="tool-grid">
          {alternatives.map(([k, t]) => (
            <a class="tool-card" href={"/tool/" + k + "/"}>
              <div class="icon" aria-hidden="true"><i class={`fas ${t.icon || "fa-robot"}`}></i></div>
              <h3>{pageLang === "zh" ? (t.name?.zh || t.name?.en || k) : t.name?.en || k}</h3>
              <p>{pageLang === "zh" ? (t.short_desc?.zh || t.short_desc?.en || "") : t.short_desc?.en || ""}</p>
              <span class="tag">{pageLang === "zh" ? catLabel(t.cat || "", "zh") : (categoryLabels[t.cat] || t.cat)}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <ToolFAQ faqs={allFaqs} />

    {relatedCategories.length > 0 && (
      <section class="detail-section related">
        <h2 id="related"><i class="fas fa-folder-open" aria-hidden="true"></i> {t("relatedHeading")}</h2>
        <div class="related-grid">
          {tCat === "code" && (
            <a class="related-card" href="/solutions/ai-for-developers/">
              <div class="related-icon" aria-hidden="true"><i class="fas fa-layer-group"></i></div>
              <div>
                <h3>{t("aiForDevsTitle")}</h3>
                <p>{t("aiForDevsDesc")}</p>
              </div>
            </a>
          )}
          {relatedCategories.map(c => (
            <a class="related-card" href={"/best/" + c.slug + "/"}>
              <div class="related-icon" aria-hidden="true"><i class="fas fa-folder-open"></i></div>
              <div>
                <h3>{pageLang === "zh" ? (c.title_zh || c.title_en) : c.title_en}</h3>
                <p>{pageLang === "zh" ? (c.desc_zh || c.desc_en) : c.desc_en}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="detail-section editorial-disclosure">
      {isReviewed ? (
        <p>{pageLang === "zh"
          ? `由 AI Tool Hub 编辑团队编目${editorial?.updatedAt ? ` — 最后更新于 ${editorial.updatedAt}。` : "。"}我们仅在运行标准化测试套件后发布真实测试基准数据。`
          : `Curated by the AI Tool Hub editorial team${editorial?.updatedAt ? ` — last updated ${editorial.updatedAt}.` : "."} We publish real-test benchmark numbers only after running our standardized suite.`}</p>
      ) : (
<p>{t("cataloguedNote")}</p>
      )}
    </section>
    </div>
    <aside class="article-toc" aria-label="Table of contents">
      <div class="toc-title">{t("tocTitle")}</div>
      <ol>
        {tocSections.map(s => <li><a href={"#" + s.id}>{s.label}</a></li>)}
      </ol>
    </aside>
  </div>
</article>
</BaseLayout>
