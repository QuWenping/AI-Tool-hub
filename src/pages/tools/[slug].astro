---
import BaseLayout from "../../layouts/BaseLayout.astro";
import toolsData from "../../data/tools.json";
import { getTranslations } from "../../utils/i18n";

export async function getStaticPaths() {
  return Object.keys(toolsData)
    .filter(k => !k.startsWith("_"))
    .map(slug => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props;
const pageLang = Astro.currentLocale || "en";
const t = getTranslations("tools", pageLang);

const tool = toolsData[slug];
if (!tool || !tool.name) {
  return new Response("Tool not found", { status: 404 });
}

const siteUrl = "https://thebestaitoolsreview.com";
const pageUrl = siteUrl + "/tools/" + slug + "/";
const toolName = tool.name?.en || slug;
const toolNameZh = tool.name?.zh || toolName;
const displayName = pageLang === "zh" ? toolNameZh : toolName;
const shortDesc = pageLang === "zh" ? (tool.short_desc?.zh || tool.short_desc?.en || "") : (tool.short_desc?.en || "");
const longDesc = pageLang === "zh" ? (tool.long_desc?.zh || tool.long_desc?.en || "") : (tool.long_desc?.en || "");
const pricingLabel = pageLang === "zh" ? (tool.pricing?.zh || tool.pricing?.en || "多种") : (tool.pricing?.en || "Various");
const catLabels = { text: "Writing", image: "Image", code: "Coding", video: "Video", audio: "Audio", productivity: "Productivity" };
const catLabelZh = { text: "写作", image: "图像", code: "编程", video: "视频", audio: "音频", productivity: "效率" };
const catDisplay = pageLang === "zh" ? (catLabelZh[tool.cat] || tool.cat) : (catLabels[tool.cat] || tool.cat);

const seoTitle = pageLang === "zh"
  ? `${toolNameZh} 评测 — 功能、定价与真实体验（2026）`
  : `${toolName} Review — Features, Pricing & Real-World Testing (2026)`;
const seoDescription = pageLang === "zh"
  ? `深度评测 ${toolNameZh}：${shortDesc.slice(0, 120)}。真实优缺点、定价、适用场景与替代方案。`
  : `In-depth ${toolName} review: ${shortDesc.slice(0, 120)}. Real pros & cons, pricing, use cases, and alternatives.`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": pageUrl,
  "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
  "image": { "@type": "ImageObject", "url": siteUrl + "/og-image.svg", "width": 1200, "height": 630 },
  "datePublished": "2026-07-08",
  "dateModified": "2026-07-11",
  "author": { "@type": "Person", "name": "Lin Chen" },
  "publisher": { "@type": "Organization", "name": "AI Tool Hub", "url": siteUrl, "logo": { "@type": "ImageObject", "url": siteUrl + "/logo.svg", "width": 300, "height": 60 } },
  "articleSection": "AI Tools",
  "inLanguage": pageLang === "zh" ? "zh" : "en"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": pageLang === "zh" ? "首页" : "Home", "item": siteUrl + "/" },
    { "@type": "ListItem", "position": 2, "name": pageLang === "zh" ? "AI 工具" : "AI Tools", "item": siteUrl + "/category/" },
    { "@type": "ListItem", "position": 3, "name": displayName, "item": pageUrl }
  ]
};

const prosList = pageLang === "zh" ? (tool.pros?.zh || tool.pros?.en || []) : (tool.pros?.en || []);
const consList = pageLang === "zh" ? (tool.cons?.zh || tool.cons?.en || []) : (tool.cons?.en || []);
const featuresList = pageLang === "zh" ? (tool.features?.zh || tool.features?.en || []) : (tool.features?.en || []);
const useCasesList = pageLang === "zh" ? (tool.use_cases?.zh || tool.use_cases?.en || []) : (tool.use_cases?.en || []);
const audienceList = pageLang === "zh" ? (tool.target_audience?.zh || tool.target_audience?.en || []) : (tool.target_audience?.en || []);
const scenesList = pageLang === "zh" ? (tool.scenes?.zh || tool.scenes?.en || []) : (tool.scenes?.en || []);
const industryTags = tool.industry_tags || [];
---

<BaseLayout title={seoTitle} description={seoDescription} keywords={`${toolName} review, AI writing tools, ${slug}, ${tool.cat}`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  </Fragment>

  <article class="legal-page">
    <div class="article-grid">
      <div class="article-main">
        <nav class="breadcrumbs">
          <a href="/">{pageLang === "zh" ? "首页" : "Home"}</a> &rsaquo;
          <a href="/category/">{pageLang === "zh" ? "AI 工具" : "AI Tools"}</a> &rsaquo;
          <span>{displayName}</span>
        </nav>

        <header class="cat-hero">
          <div class="tool-review-icon" style="font-size:2.5rem;margin-bottom:1rem;">
            <i class={`fas ${tool.icon || "fa-robot"}`}></i>
          </div>
          <span class="eyebrow">{catDisplay}</span>
          <h1>{displayName}</h1>
          <p class="lede">{shortDesc}</p>
        </header>

        <section>
          <h2>{pageLang === "zh" ? "深度评测" : "Deep Dive Review"}</h2>
          <p>{longDesc}</p>
        </section>

        {tool.url && (
          <p style="margin:1.5rem 0;">
            <a href={tool.url} rel="noopener" target="_blank" class="cta-primary">
              {pageLang === "zh" ? `访问 ${displayName} 官网 →` : `Visit ${toolName} →`}
            </a>
          </p>
        )}

        <section>
          <h2>{pageLang === "zh" ? "优点与缺点" : "Pros & Cons"}</h2>
          <div class="pros-cons-box">
            <div class="pro-list">
              <strong>{pageLang === "zh" ? "优点" : "Pros"}</strong>
              <ul>
                {prosList.map(p => <li>{p}</li>)}
              </ul>
            </div>
            <div class="con-list">
              <strong>{pageLang === "zh" ? "缺点" : "Cons"}</strong>
              <ul>
                {consList.map(c => <li>{c}</li>)}
              </ul>
            </div>
          </div>
        </section>

        {featuresList.length > 0 && (
          <section>
            <h2>{pageLang === "zh" ? "核心功能" : "Key Features"}</h2>
            <ul>
              {featuresList.map(f => <li>{f}</li>)}
            </ul>
          </section>
        )}

        <section>
          <h2>{pageLang === "zh" ? "适用场景" : "Use Cases"}</h2>
          <ul>
            {useCasesList.map(u => <li>{u}</li>)}
          </ul>
        </section>

        {audienceList.length > 0 && (
          <section>
            <h2>{pageLang === "zh" ? "适合人群" : "Target Audience"}</h2>
            <ul>
              {audienceList.map(a => <li>{a}</li>)}
            </ul>
          </section>
        )}

        <section class="detail-section">
          <h2>{pageLang === "zh" ? "快速概览" : "Quick Overview"}</h2>
          <table>
            <tbody>
              <tr>
                <td><strong>{pageLang === "zh" ? "分类" : "Category"}</strong></td>
                <td>{catDisplay}</td>
              </tr>
              <tr>
                <td><strong>{pageLang === "zh" ? "定价" : "Pricing"}</strong></td>
                <td>{pricingLabel}</td>
              </tr>
              {scenesList.length > 0 && (
                <tr>
                  <td><strong>{pageLang === "zh" ? "标签" : "Tags"}</strong></td>
                  <td>{scenesList.join(", ")}</td>
                </tr>
              )}
              {industryTags.length > 0 && (
                <tr>
                  <td><strong>{pageLang === "zh" ? "行业" : "Industries"}</strong></td>
                  <td>{industryTags.join(", ")}</td>
                </tr>
              )}
            </tbody>
          </table>
        </section>

        {tool.url && (
          <p style="margin:2rem 0;">
            <a href={tool.url} rel="noopener" target="_blank" class="cta-primary">
              {pageLang === "zh" ? `前往 ${displayName} 官网 →` : `Go to ${toolName} Website →`}
            </a>
          </p>
        )}
      </div>
    </div>
  </article>
</BaseLayout>
