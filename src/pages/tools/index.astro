---
import BaseLayout from "../../layouts/BaseLayout.astro";
import toolsData from "../../data/tools.json";

const pageLang = Astro.currentLocale || "en";
const siteUrl = "https://thebestaitoolsreview.com";

const catLabels: Record<string, string> = {
  text: "Writing",
  image: "Image",
  code: "Coding",
  video: "Video",
  audio: "Audio",
  productivity: "Productivity",
};

const tools = Object.entries(toolsData)
  .filter(([k]) => !k.startsWith("_"))
  .map(([slug, tool]: [string, any]) => ({
    slug,
    name: tool.name?.en || slug,
    short_desc: tool.short_desc?.en || "",
    cat: catLabels[tool.cat] || tool.cat || "",
    pricing: tool.pricing?.en || "",
    logo: tool.logo || "",
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const seoTitle = "AI Tools Directory — Best AI Tools Reviewed & Compared (2026)";
const seoDesc = "Browse our comprehensive directory of the best AI tools. Honest reviews, pricing comparisons, and real-world testing for writing, coding, image, video, and audio AI tools.";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": seoTitle,
  "description": seoDesc,
  "url": siteUrl + "/tools/",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": tools.map((t, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": siteUrl + "/tools/" + t.slug + "/",
      "name": t.name,
    })),
  },
};
---

<BaseLayout title={seoTitle} description={seoDesc} lang={pageLang}>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)}></script>

  <div class="page-container">
    <header class="page-hero">
      <span class="eyebrow">AI Tools</span>
      <h1>Best AI Tools Directory (2026)</h1>
      <p class="lede">
        Browse {tools.length}+ AI tools across writing, coding, image, video, audio, and productivity. Honest reviews, pricing comparisons, and real-world testing.
      </p>
    </header>

    <div class="tool-grid">
      {tools.map(tool => (
        <a class="tool-card" href={`/tools/${tool.slug}/`}>
          <div class="tool-card-header">
            {tool.logo && <img src={tool.logo} alt={tool.name} class="tool-logo" loading="lazy" width="48" height="48" />}
            <div>
              <h3>{tool.name}</h3>
              {tool.cat && <span class="tag">{tool.cat}</span>}
            </div>
          </div>
          <p class="tool-card-desc">{tool.short_desc}</p>
          <div class="tool-card-footer">
            {tool.pricing && <span class="pricing">{tool.pricing}</span>}
            <span class="review-link">Read Review &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
.tool-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 24px;
  margin-top: 32px;
}
.tool-card {
  background: var(--bg-card, #fff);
  border: 1px solid var(--border, #e2e8f0);
  border-radius: 12px;
  padding: 24px;
  text-decoration: none;
  color: inherit;
  transition: box-shadow 0.2s, transform 0.2s;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.tool-card:hover {
  box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  transform: translateY(-2px);
}
.tool-card-header {
  display: flex;
  align-items: center;
  gap: 12px;
}
.tool-logo {
  border-radius: 8px;
  object-fit: contain;
}
.tool-card-header h3 {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 600;
}
.tool-card-desc {
  margin: 0;
  font-size: 0.9rem;
  color: var(--text-secondary, #64748b);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.tool-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}
.pricing {
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--accent, #2563eb);
  background: var(--accent-bg, #eff6ff);
  padding: 2px 10px;
  border-radius: 6px;
}
.review-link {
  font-size: 0.85rem;
  color: var(--accent, #2563eb);
  font-weight: 500;
}
.tag {
  font-size: 0.75rem;
  background: var(--tag-bg, #f1f5f9);
  color: var(--tag-color, #475569);
  padding: 2px 8px;
  border-radius: 4px;
}
.page-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 48px 24px;
}
.eyebrow {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--accent, #2563eb);
  font-weight: 600;
}
.page-hero h1 {
  font-size: 2.4rem;
  margin: 12px 0;
}
.lede {
  font-size: 1.1rem;
  color: var(--text-secondary, #475569);
  max-width: 700px;
}
</style>
