---
import BaseLayout from "../layouts/BaseLayout.astro";
const siteUrl = "https://thebestaitoolsreview.com";
const pageUrl = siteUrl + "/submit-prompt/";
---
<BaseLayout title="Submit a Prompt | AI Tool Hub Prompt Library" description="Share your AI prompts with the community. Submit a prompt to be featured in our Prompt Library. Free, attributed to you." keywords="submit prompt, AI prompt submission, prompt library, share prompt, prompt community">
  <div class="article">
    <nav class="breadcrumbs"><a href="/">Home</a> &rsaquo; <a href="/prompts/">Prompt Library</a> &rsaquo; <span>Submit</span></nav>
    <header class="article-header">
      <span class="eyebrow">Contribute</span>
      <h1>Submit a Prompt</h1>
    </header>
    <section class="article-body">
      <p>Share your best AI prompts with the community. Approved prompts will be added to our <a href="/prompts/">Prompt Library</a> with attribution to you. <strong>Free, no account needed.</strong></p>

      <div class="info-card blue">
        <h3>What makes a good prompt?</h3>
        <ul>
          <li>Uses [PLACEHOLDER] markers for customizable parts</li>
          <li>Clear instructions that work with the specified tool</li>
          <li>Produces consistent, high-quality results</li>
          <li>Not already in our library (check first!)</li>
        </ul>
      </div>

      <form id="prompt-form" class="form-grid">
        <div>
          <label class="form-label">Prompt Title *</label>
          <input type="text" id="p-title" required placeholder="e.g. ChatGPT Code Review Prompt" class="form-input" />
        </div>
        <div>
          <label class="form-label">Target Tool *</label>
          <input type="text" id="p-tool" required placeholder="e.g. ChatGPT, Claude, Midjourney..." class="form-input" />
        </div>
        <div>
          <label class="form-label">Category *</label>
          <select id="p-category" required class="form-input">
            <option value="">Select category...</option>
            <option>Coding</option>
            <option>Writing</option>
            <option>Image</option>
            <option>Video</option>
            <option>Audio</option>
            <option>Music</option>
            <option>Business</option>
            <option>Research</option>
            <option>Data</option>
            <option>Productivity</option>
            <option>AI</option>
          </select>
        </div>
        <div>
          <label class="form-label">The Prompt *</label>
          <textarea id="p-prompt" required rows="6" placeholder="Paste your prompt here. Use [PLACEHOLDER] for customizable parts." class="form-input mono"></textarea>
        </div>
        <div>
          <label class="form-label">Tags (comma-separated)</label>
          <input type="text" id="p-tags" placeholder="e.g. code, review, debug" class="form-input" />
        </div>
        <div>
          <label class="form-label">Your Name (for attribution) *</label>
          <input type="text" id="p-author" required placeholder="Your name or username" class="form-input" />
        </div>
        <div>
          <label class="form-label">Your Email *</label>
          <input type="email" id="p-email" required placeholder="your@email.com" class="form-input" />
        </div>
        <button type="submit" class="cta-primary">Submit Prompt</button>
      </form>
      <div id="prompt-msg" class="form-success">
        <p>Thank you! Your prompt has been submitted.</p>
        <p>We will review it within 2-3 business days and add it to the Prompt Library with attribution to you.</p>
      </div>

      <p class="back-link"><a href="/submit-tool/">Submit a Tool</a> &nbsp;|&nbsp; <a href="/prompts/">Browse Prompts</a></p>
    </section>
  </div>
</BaseLayout>
<script is:inline>
document.getElementById("prompt-form").addEventListener("submit",function(e){
  e.preventDefault();
  var form=e.target;
  var data={title:form.querySelector("#p-title").value,tool:form.querySelector("#p-tool").value,category:form.querySelector("#p-category").value,prompt:form.querySelector("#p-prompt").value,tags:form.querySelector("#p-tags").value,author:form.querySelector("#p-author").value,email:form.querySelector("#p-email").value};
  fetch("/api/submit-prompt",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(data)}).then(function(r){return r.json()}).then(function(d){
    if(d.success){document.getElementById("prompt-msg").style.display="block";form.style.display="none";}
  }).catch(function(){document.getElementById("prompt-msg").style.display="block";document.getElementById("prompt-msg").querySelector("p").textContent="Network error. Please try again.";});
});
</script>
