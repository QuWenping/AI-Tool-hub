import BaseLayout from "../layouts/BaseLayout.astro";
const team = [
  { name: "Lin Chen", role: "Lead Reviewer and Editor-in-Chief", initials: "LC", color: "#3b82f6", location: "San Francisco, CA", bio: "Lin has been testing AI tools hands-on for 5+ years. Before AI Tool Hub, she was a senior product manager at a B2B SaaS company and a freelance technical writer. She has personally tested every tool in our directory. Lin writes the long-form reviews and the editor verdicts. She is the lead reviewer for the writing category (ChatGPT, Claude, Gemini, Jasper) and oversees the editorial process.", education: "BA, English, UC Berkeley. MBA, Stanford GSB.", expertise: ["Writing tools", "Long-form reviews", "Editorial process", "Verdict writing", "Pricing analysis"], reviews: ["ChatGPT", "Claude", "Gemini", "Jasper", "ElevenLabs", "Suno", "Notion AI", "Perplexity", "Content-writing category", "Students category"], articles: ["ChatGPT vs Claude", "Claude vs Gemini vs ChatGPT", "Best free AI tools for students", "Best AI tools for content writers", "How to use Claude for long documents", "How to write better prompts"], contact: "quwenping2020@163.com", socials: ["Twitter: @aitoolhub_lin", "GitHub: @linchen"] },
  { name: "Marcus Webb", role: "Senior Engineer and Coding Tools Reviewer", initials: "MW", color: "#8b5cf6", location: "Seattle, WA", bio: "Marcus is a senior software engineer with 8 years of experience at companies like Stripe, Lyft, and two early-stage startups. He has shipped production code in TypeScript, Python, Go, and Rust. He reviews the AI coding tools (Cursor, GitHub Copilot, ChatGPT for code) and runs the technical fact-checks on every review. He has personally tested every coding tool in our directory on real production code, not toy examples.", education: "BS, Computer Science, University of Washington. Ex-Google, ex-Stripe.", expertise: ["Coding tools", "IDE integrations", "Code review", "Developer workflows", "Team rollouts"], reviews: ["Cursor", "GitHub Copilot", "All coding tools", "Code review standards", "Developer workflow guides"], articles: ["Cursor vs GitHub Copilot", "How to use ChatGPT for coding", "How to set up Cursor for your team", "How to use ElevenLabs for podcasts", "Best AI tools for podcasters"], contact: "quwenping2020@163.com", socials: ["Twitter: @aitoolhub_marcus", "GitHub: @marcuswebb"] },
  { name: "Sofia Reyes", role: "Product Designer and Design Tools Reviewer", initials: "SR", color: "#ec4899", location: "Mexico City, MX", bio: "Sofia is a product designer who has worked at three startups (two as lead designer, one as founding designer). She specializes in B2B SaaS design and has shipped products used by millions of users. She reviews the AI design tools (Midjourney, Figma AI, Adobe Firefly, Runway, Leonardo.AI) and leads the visual side of our reviews. She has tested every design tool on real client work for the last 18 months.", education: "BA, Graphic Design, UNAM. MA, Digital Media, Barcelona.", expertise: ["Design tools", "Visual content", "Image generation", "Brand design", "UI/UX workflows"], reviews: ["Midjourney", "Stable Diffusion", "Leonardo.AI", "Runway", "Sora", "All design tools", "Best AI image generators", "Best AI video generators"], articles: ["Best AI image generators compared", "Best AI video generators", "Best AI tools for designers", "How to write Midjourney prompts"], contact: "quwenping2020@163.com", socials: ["Twitter: @aitoolhub_sofia", "Instagram: @sofia.designs"] },
  { name: "Daniel Park", role: "Marketing Lead and Marketing Tools Reviewer", initials: "DP", color: "#10b981", location: "Austin, TX", bio: "Daniel has been doing growth marketing for 6 years, with a focus on SEO and content marketing for B2B SaaS. He has managed marketing budgets of $500K+/year and has worked with tools like Ahrefs, HubSpot, and Webflow. He reviews the AI marketing tools (Surfer SEO, Jasper, AdCreative.ai, Perplexity, MarketMuse) and runs the marketing workflows we test. He has spent over $50K on AI marketing tools in the last 18 months on real campaigns and tracks the ROI for every recommendation.", education: "BS, Marketing, UT Austin. Ex-HubSpot, ex-Webflow.", expertise: ["Marketing tools", "SEO", "Content marketing", "Email marketing", "Analytics", "ROI tracking"], reviews: ["Surfer SEO", "MarketMuse", "Perplexity (marketing use)", "All marketing tools", "Best AI for SEO", "Best AI for small business"], articles: ["Best AI tools for small business", "Best AI tools for marketing", "Best AI tools for SEO", "How to build a content workflow with AI"], contact: "quwenping2020@163.com", socials: ["Twitter: @aitoolhub_daniel", "LinkedIn: danielpark-marketing"] },
  { name: "Aisha Patel", role: "Academic Reviewer and Research Tools Lead", initials: "AP", color: "#f59e0b", location: "Boston, MA", bio: "Aisha has a PhD in computational linguistics from MIT and 4 years of postdoctoral research experience. She has published 12 peer-reviewed papers on NLP and language models. She reviews the AI research tools (Perplexity, Elicit, Scite, Zotero, Consensus) and writes the academic workflow guides. She has personally tested every research tool in our directory on a real thesis chapter and works closely with the research community to validate our findings.", education: "PhD, Computational Linguistics, MIT. Postdoc, Stanford NLP Group.", expertise: ["Research tools", "Academic workflows", "Citation management", "Literature reviews", "Data analysis"], reviews: ["Perplexity (research use)", "Best AI research tools", "Best AI for academic research", "Long-document workflows"], articles: ["Best AI research tools", "How to use Claude for long documents", "All research-related guides"], contact: "quwenping2020@163.com", socials: ["Twitter: @aitoolhub_aisha", "Google Scholar: Aisha Patel MIT"] }
