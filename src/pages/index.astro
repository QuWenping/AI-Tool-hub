---
import BaseLayout from "../layouts/BaseLayout.astro";
import categories from "../data/categories.json";
import toolsData from "../data/tools.json";
const tools = Object.entries(toolsData).filter(function(e){return e[0]!=="codewords"}).map(function(e){return {id:e[0],data:e[1]}});
const featured = tools.filter(function(t){return t.data.featured}).slice(0, 3);
const categoriesGrouped = {};
tools.forEach(function(t){
  if(!categoriesGrouped[t.data.cat]) categoriesGrouped[t.data.cat] = [];
  categoriesGrouped[t.data.cat].push(t);
});
---
<BaseLayout title="AI Tool Hub | Best AI Tools Directory" description="Explore curated AI tools for writing, coding, image generation, video, audio and productivity. Find ChatGPT alternatives, AI coding assistants and practical AI services.">
<section class="hero-section">
  <h1>Find the Best AI Tools for Any Task</h1>
  <p class="hero-subtitle">We tested {tools.length} popular AI tools hands-on. Here are the ones we would actually pay for.</p>
</section>

<section>
  <h2>Editors picks (2026)</h2>
  <div class="tool-grid">
    {featured.map(function(t){return (<article class="tool-card"><h3><a href={"/tool/" + t.id + "/"}>{t.data.name.en}</a></h3><p>{t.data.short_desc.en}</p><a class="cta-primary" href={"/tool/" + t.id + "/"}>Read review</a></article>)})}
  </div>
</section>

<section>
  <h2>Browse by use case</h2>
  <ul class="categories">
    {categories.map(function(c){return (<li><a href={"/best/" + c.slug + "/"}>{c.title_en}</a></li>)})}
  </ul>
</section>

<section>
  <h2>All tools</h2>
  {Object.entries(categoriesGrouped).map(function(entry){
    var cat = entry[0]; var list = entry[1];
    return (<article><h3>{cat.charAt(0).toUpperCase() + cat.slice(1)} AI tools</h3><ul>{list.map(function(t){return (<li><a href={"/tool/" + t.id + "/"}>{t.data.name.en}</a> - {t.data.short_desc.en}</li>)})}</ul></article>);
  })}
</section>

<section>
  <h2>Popular comparisons</h2>
  <ul>
    <li><a href="/vs/chatgpt-vs-claude/">ChatGPT vs Claude (2026)</a></li>
    <li><a href="/vs/cursor-vs-github-copilot/">Cursor vs GitHub Copilot</a></li>
    <li><a href="/vs/midjourney-vs-stable-diffusion/">Midjourney vs Stable Diffusion</a></li>
  </ul>
</section>
</BaseLayout>
