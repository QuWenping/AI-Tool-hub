---
import BaseLayout from "../layouts/BaseLayout.astro";
import categoriesData from "../data/categories.json";
import toolsData from "../data/tools.json";
import matchupsData from "../data/matchups.json";
import stackRecs from "../data/stack-recommendations.json";
import "../styles/home.css";

const visibleTools = Object.entries(toolsData).filter(([, tool]) => !tool.hidden);
const siteStats = {
  tools: visibleTools.length,
  categories: categoriesData.length,
  comparisons: matchupsData.length,
  testHours: "1,000+"
};

const stackCatalog = stackRecs.tools
  .filter(rec => toolsData[rec.toolId] && !toolsData[rec.toolId].hidden)
  .map(rec => {
    const tool = toolsData[rec.toolId];
    return {
      id: rec.toolId,
      name: tool.name?.en || rec.toolId,
      description: tool.short_desc?.en || "",
      icon: tool.icon || "fa-robot",
      cat: tool.cat || "productivity",
      href: `/tool/${rec.toolId}/`,
      roles: rec.roles || [],
      goals: rec.goals || [],
      monthlyCost: typeof rec.monthlyCost === "number" ? rec.monthlyCost : 0,
      freeTier: !!rec.freeTier,
      stackRole: rec.stackRole || { en: "AI Assistant" },
      hoursSaved: typeof rec.hoursSaved === "number" ? rec.hoursSaved : 4,
      priority: typeof rec.priority === "number" ? rec.priority : 0
    };
  });

const featuredToolMeta = [
  { id: "chatgpt", rating: "9.4", price: "$20/mo", tags: ["Writing", "Reasoning", "Research"] },
  { id: "claude", rating: "9.3", price: "$20/mo", tags: ["Analysis", "Long Context", "Writing"] },
  { id: "cursor", rating: "9.6", price: "$20/mo", tags: ["Coding", "Editor", "Developer"] },
  { id: "midjourney", rating: "9.5", price: "$10–96/mo", tags: ["Images", "Design", "Art"] },
  { id: "runway", rating: "9.1", price: "$12–76/mo", tags: ["Video", "Editing", "Effects"] },
  { id: "elevenlabs", rating: "9.4", price: "$5–330/mo", tags: ["Voice", "Audio", "TTS"] }
].map(meta => ({ ...meta, tool: toolsData[meta.id] })).filter(item => item.tool);

const popularComparisons = [
  { slug: "chatgpt-vs-claude", title_en: "ChatGPT vs Claude", desc_en: "Pick the right general assistant" },
  { slug: "midjourney-vs-stable-diffusion", title_en: "Midjourney vs Stable Diffusion", desc_en: "Paid polish vs open-source control" },
  { slug: "cursor-vs-github-copilot", title_en: "Cursor vs GitHub Copilot", desc_en: "AI-native editor vs IDE plugin" },
  { slug: "claude-vs-gemini", title_en: "Claude vs Gemini", desc_en: "Writing quality vs multimodal power" },
  { slug: "elevenlabs-vs-chatgpt", title_en: "ElevenLabs vs ChatGPT Voice", desc_en: "Professional voice AI vs integrated voice" },
  { slug: "sora-vs-runway", title_en: "Sora 2 vs Runway", desc_en: "Highest quality vs production tools" }
];

const popularGuides = [
  { slug: "best-free-ai-tools-for-students-2026", title_en: "10 Best Free AI Tools for Students", desc_en: "Tested for two weeks on real assignments" },
  { slug: "chatgpt-vs-claude-which-should-you-pick-2026", title_en: "ChatGPT vs Claude: Which to Pick?", desc_en: "Two weeks of side-by-side testing" },
  { slug: "best-ai-image-generators-compared-2026", title_en: "Best AI Image Generators (2026)", desc_en: "Midjourney vs SD vs DALL-E vs Flux" }
];

const editorialLog = [
  { date: "2026-07-15", title_en: "Added Gemini, Leonardo.AI, and Jasper", desc_en: "Three new tools passed our hands-on quality review." },
  { date: "2026-07-10", title_en: "Re-tested the top writing tools", desc_en: "We refreshed rankings after another round of practical tests." },
  { date: "2026-06-10", title_en: "Published our AI research tools guide", desc_en: "Twelve research tools tested on a real thesis workflow." }
];

const faq = [
  { q_en: "What are the best AI tools in 2026?", a_en: "Our top picks depend on the workflow you need — we recommend starting with our editor's picks (ChatGPT, Claude, Cursor, Midjourney, Runway, ElevenLabs) and then narrowing down via our tool finder. Every recommendation links to a hands-on review and the underlying test notes." },
  { q_en: "How do you review AI tools?", a_en: "We run each tool through a fixed methodology: a real-world task from our editorial workflow, a side-by-side comparison against its closest peer, and a pricing/value check. Reviews link to the underlying test notes — read our methodology page for the full checklist." },
  { q_en: "Are these AI tools tested before recommendation?", a_en: "Yes. No tool appears in our rankings without hands-on use. We keep a dated changelog of what we re-tested, what changed in the product, and how that changed our recommendation. Check the editorial log on this page for the latest runs." },
  { q_en: "Which AI tools are best for business?", a_en: "It depends on the team. For customer-facing content, ChatGPT or Claude. For engineering productivity, Cursor or GitHub Copilot. For operations automation, n8n or CrewAI. Each pick is based on a documented workflow test — see our business and productivity categories for full breakdowns." },
  { q_en: "What AI tools are free?", a_en: "Tools with a usable free tier or open-source distribution include ChatGPT, Claude, Gemini, Cursor (Hobby), Stable Diffusion, and Blender. Free tiers change frequently — we re-check them quarterly. See our free tools category for the current list with usage limits." },
  { q_en: "How do AI tools improve productivity?", a_en: "Productivity gains come from removing repetitive work — drafting, summarizing, scheduling, code boilerplate — not from replacing judgment. Our testing tracks time saved per task and quality retained, not just speed. See our workflows section for tested stacks you can replicate." }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(item => ({
    "@type": "Question",
    "name": item.q_en,
    "acceptedAnswer": { "@type": "Answer", "text": item.a_en }
  }))
};
---
<BaseLayout
  title="AI Tool Hub | Find Your Perfect AI Stack"
  description="Discover, compare, and build your ideal AI stack. Explore tested AI tools for writing, coding, images, video, audio, and productivity."
  fullWidth={true}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script></Fragment>
  <div class="home-page">
    <section class="home-hero">
      <div class="home-shell hero-layout">
        <div class="hero-copy">
          <div class="hero-badge" data-i18n-en="🚀 NEW: AI Benchmark Lab v2.0">🚀 NEW: AI Benchmark Lab v2.0</div>
          <h1><span class="title-prefix" data-i18n-en="Find Your Perfect">Find Your Perfect</span> <span class="title-highlight" data-i18n-en="AI Stack">AI Stack</span></h1>
          <p class="hero-subtitle" data-i18n-en="Practical, hands-on AI tool reviews. Every recommendation backed by documented testing.">Practical, hands-on AI tool reviews. Every recommendation backed by documented testing.</p>
          <div class="hero-actions">
            <a class="home-button primary" href="#finder"><i class="fas fa-wand-magic-sparkles"></i><span data-i18n-en="Find My AI Stack">Find My AI Stack</span></a>
            <a class="home-button secondary" href="#all-tools"><span data-i18n-en="Explore All Tools">Explore All Tools</span><i class="fas fa-arrow-right"></i></a>
          </div>
          <div class="hero-stats" aria-label="Site statistics">
            <div><strong>{siteStats.tools}+</strong><span data-i18n-en="AI Tools Reviewed">AI Tools Reviewed</span></div>
            <div><a href="/methodology/"><strong>{siteStats.testHours}+</strong><span data-i18n-en="Testing Hours">Testing Hours</span></a></div>
            <div><strong>{siteStats.comparisons}+</strong><span data-i18n-en="Comparisons">Comparisons</span></div>
          </div>
        </div>
        <div class="hero-visual" aria-label="Featured AI tools">
          {featuredToolMeta.slice(0, 4).map(({ id, tool }) => (
            <a class="visual-tool" href={`/tool/${id}/`}>
              <span class="visual-icon"><i class={`fas ${tool.icon || "fa-robot"}`}></i></span>
              <strong>{tool.name.en}</strong>
              <span>{tool.short_desc.en}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section value-section">
      <div class="home-shell">
        <div class="center-heading">
          <span class="section-kicker" data-i18n-en="Why AI Tool Hub">Why AI Tool Hub</span>
          <h2 data-i18n-en="Make confident AI decisions">Make confident AI decisions</h2>
          <p data-i18n-en="Practical research, clear comparisons, and workflows you can actually use.">Practical research, clear comparisons, and workflows you can actually use.</p>
        </div>
        <div class="value-grid">
          <article class="value-card"><i class="fas fa-check-circle"></i><h3 data-i18n-en="Real-World Testing">Real-World Testing</h3><p data-i18n-en="Every recommendation is based on practical tasks, not marketing claims.">Every recommendation is based on practical tasks, not marketing claims.</p></article>
          <article class="value-card"><i class="fas fa-chart-line"></i><h3 data-i18n-en="Clear Benchmarks">Clear Benchmarks</h3><p data-i18n-en="Compare quality, speed, cost, and usability with consistent criteria.">Compare quality, speed, cost, and usability with consistent criteria.</p></article>
          <article class="value-card"><i class="fas fa-layer-group"></i><h3 data-i18n-en="Stack Builder">Stack Builder</h3><p data-i18n-en="Combine complementary tools into a focused workflow for your goals.">Combine complementary tools into a focused workflow for your goals.</p></article>
          <article class="value-card"><i class="fas fa-arrows-rotate"></i><h3 data-i18n-en="Always Current">Always Current</h3><p data-i18n-en="We revisit leading tools as models, pricing, and features change.">We revisit leading tools as models, pricing, and features change.</p></article>
        </div>
      </div>
    </section>

    <section class="home-section finder-section" id="finder">
      <div class="home-shell">
        <div class="section-heading">
          <span class="section-kicker" data-i18n-en="AI Stack Finder">AI Stack Finder</span>
          <h2 data-i18n-en="Find your AI stack in 30 seconds">Find your AI stack in 30 seconds</h2>
          <p data-i18n-en="Choose one option in each group to get a personalized starting stack.">Choose one option in each group to get a personalized starting stack.</p>
        </div>
        <div class="finder-card" id="stack-builder">
          <script type="application/json" id="stack-catalog" set:html={JSON.stringify(stackCatalog)}></script>
          <div class="finder-steps">
            <fieldset class="finder-step">
              <legend><span>1</span><strong data-i18n-en="Who are you?">Who are you?</strong></legend>
              <div class="option-grid">
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="role" data-stack-value="founder" data-i18n-en="Founder">Founder</button>
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="role" data-stack-value="developer" data-i18n-en="Developer">Developer</button>
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="role" data-stack-value="designer" data-i18n-en="Designer">Designer</button>
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="role" data-stack-value="marketer" data-i18n-en="Marketer">Marketer</button>
              </div>
            </fieldset>
            <fieldset class="finder-step">
              <legend><span>2</span><strong data-i18n-en="What's your goal?">What's your goal?</strong></legend>
              <div class="option-grid">
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="goal" data-stack-value="save-time" data-i18n-en="Save time">Save time</button>
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="goal" data-stack-value="automate" data-i18n-en="Automate tasks">Automate tasks</button>
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="goal" data-stack-value="create-content" data-i18n-en="Create content">Create content</button>
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="goal" data-stack-value="generate-code" data-i18n-en="Generate code">Generate code</button>
              </div>
            </fieldset>
            <fieldset class="finder-step">
              <legend><span>3</span><strong data-i18n-en="What's your budget?">What's your budget?</strong></legend>
              <div class="option-grid">
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="budget" data-stack-value="free" data-i18n-en="Free">Free</button>
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="budget" data-stack-value="0-50">$0–50/mo</button>
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="budget" data-stack-value="50-200">$50–200/mo</button>
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="budget" data-stack-value="enterprise" data-i18n-en="Enterprise">Enterprise</button>
              </div>
            </fieldset>
            <div class="finder-progress" aria-live="polite">
              <div class="progress-track"><div class="progress-bar" data-stack-progress-bar></div></div>
              <span class="progress-label" data-stack-progress-label>0 of 3 answered — pick your role to start</span>
            </div>
          </div>
          <aside class="finder-result" aria-live="polite" data-stack-result data-status="pending">
            <div class="finder-result-pending" data-stack-pending>
              <span class="result-label" data-i18n-en="Your recommended stack">Your recommended stack</span>
              <h3 data-i18n-en="Answer three quick questions">Answer three quick questions</h3>
              <p data-i18n-en="Select role, goal and budget above. We'll match three complementary AI tools you can use immediately.">Select role, goal and budget above. We'll match three complementary AI tools you can use immediately.</p>
              <div class="pending-preview">
                <span><i class="fas fa-user-tie"></i><span data-i18n-en="1. Role">1. Role</span></span>
                <span><i class="fas fa-bullseye"></i><span data-i18n-en="2. Goal">2. Goal</span></span>
                <span><i class="fas fa-coins"></i><span data-i18n-en="3. Budget">3. Budget</span></span>
              </div>
            </div>
            <div class="finder-result-ready" data-stack-ready hidden>
              <span class="result-label" data-i18n-en="Your recommended stack">Your recommended stack</span>
              <h3 data-stack-title>A flexible stack for modern work</h3>
              <p data-stack-summary></p>
              <div class="stack-list" data-stack-list></div>
              <div class="stack-summary" data-stack-summary-block>
                <div class="summary-item">
                  <span class="summary-label" data-i18n-en="Monthly cost">Monthly cost</span>
                  <strong data-stack-cost>—</strong>
                </div>
                <div class="summary-item">
                  <span class="summary-label" data-i18n-en="Time saved">Time saved</span>
                  <strong data-stack-hours>—</strong>
                </div>
              </div>
              <div class="stack-actions">
                <a class="home-button primary result-button" data-stack-explore href="#all-tools" data-i18n-en="Explore matching tools">Explore matching tools</a>
                <button type="button" class="stack-action" data-stack-share>
                  <i class="fas fa-share-nodes"></i>
                  <span data-i18n-en="Copy share link">Copy share link</span>
                </button>
                <button type="button" class="stack-action" data-stack-reset>
                  <i class="fas fa-arrow-rotate-left"></i>
                  <span data-i18n-en="Reset">Reset</span>
                </button>
              </div>
              <p class="stack-disclaimer" data-i18n-en="Estimates are baselines from public plans. Your actual results depend on usage.">Estimates are baselines from public plans. Your actual results depend on usage.</p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="home-section featured-tools" id="featured-tools">
      <div class="home-shell">
        <div class="section-heading split-heading"><div><span class="section-kicker" data-i18n-en="Editor's Picks">Editor's Picks</span><h2 data-i18n-en="Featured AI tools">Featured AI tools</h2><p data-i18n-en="High-performing tools tested in real workflows.">High-performing tools tested in real workflows.</p></div><a href="#all-tools" data-i18n-en="View full directory →">View full directory →</a></div>
        <div class="featured-tool-grid">
          {featuredToolMeta.map(({ id, tool, rating, price, tags }) => (
            <article class="featured-tool-card">
              <div class="tool-card-top"><span class="featured-tool-icon"><i class={`fas ${tool.icon || "fa-robot"}`}></i></span><div class="featured-rating"><span>★★★★★</span><strong>{rating}</strong></div></div>
              <h3>{tool.name.en}</h3>
              <p>{tool.short_desc.en}</p>
              <div class="featured-tags">{tags.map(tag => <span>{tag}</span>)}</div>
              <div class="featured-tool-footer"><strong>{price}</strong><a href={`/tool/${id}/`} data-i18n-en="Learn more">Learn more</a></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section benchmark-section" id="benchmarks">
      <div class="home-shell">
        <div class="section-heading"><span class="section-kicker" data-i18n-en="Independent Benchmarks">Independent Benchmarks</span><h2 data-i18n-en="AI coding benchmark">AI coding benchmark</h2><p data-i18n-en="A practical snapshot based on accuracy, response speed, pricing, and daily usability.">A practical snapshot based on accuracy, response speed, pricing, and daily usability.</p></div>
        <div class="benchmark-card"><div class="table-scroll"><table><thead><tr><th data-i18n-en="Tool">Tool</th><th data-i18n-en="Accuracy">Accuracy</th><th data-i18n-en="Average speed">Average speed</th><th data-i18n-en="Entry price">Entry price</th><th data-i18n-en="Overall">Overall</th></tr></thead><tbody><tr><td><a href="/tool/cursor/"><i class="fas fa-code"></i><strong>Cursor</strong></a></td><td><span class="score high">96%</span></td><td>2.1s</td><td>$20/mo</td><td><b>9.6</b></td></tr><tr><td><a href="/tool/claude/"><i class="fas fa-feather-alt"></i><strong>Claude</strong></a></td><td><span class="score high">94%</span></td><td>3.2s</td><td>$20/mo</td><td><b>9.3</b></td></tr><tr><td><a href="/tool/github-copilot/"><i class="fab fa-github"></i><strong>GitHub Copilot</strong></a></td><td><span class="score medium">89%</span></td><td>1.8s</td><td>$10/mo</td><td><b>8.8</b></td></tr></tbody></table></div></div>
      </div>
    </section>

    <section class="home-section directory-section" id="all-tools">
      <div class="home-shell">
        <div class="section-heading center-heading"><span class="section-kicker" data-i18n-en="Complete Directory">Complete Directory</span><h2 data-i18n-en={`Explore ${siteStats.tools}+ AI tools`}>Explore {siteStats.tools}+ AI tools</h2><p data-i18n-en="Search by name or filter by category to find the right tool for your work.">Search by name or filter by category to find the right tool for your work.</p></div>
        <div class="directory-controls"><label class="search-box" for="search-input"><i class="fas fa-search"></i><input id="search-input" type="search" placeholder="Search AI tools..." data-i18n-placeholder-en="Search AI tools..."></label><div class="category-list" aria-label="Tool categories"><button class="cat-btn active" type="button" data-category="all" data-i18n-en="All">All</button><button class="cat-btn" type="button" data-category="text" data-i18n-en="Writing">Writing</button><button class="cat-btn" type="button" data-category="image" data-i18n-en="Images">Images</button><button class="cat-btn" type="button" data-category="code" data-i18n-en="Coding">Coding</button><button class="cat-btn" type="button" data-category="video" data-i18n-en="Video">Video</button><button class="cat-btn" type="button" data-category="audio" data-i18n-en="Audio">Audio</button><button class="cat-btn" type="button" data-category="productivity" data-i18n-en="Business">Business</button></div></div>
        <div id="tool-grid" class="directory-grid"></div>
        <div id="tool-grid-more" class="directory-more"></div>
      </div>
    </section>

    <section class="home-section discovery-section">
      <div class="home-shell discovery-grid">
        <div class="discovery-column"><div class="section-heading"><span class="section-kicker" data-i18n-en="Head-to-Head">Head-to-Head</span><h2 data-i18n-en="Popular comparisons">Popular comparisons</h2></div><div class="compact-link-grid">{popularComparisons.map(item => <a href={`/vs/${item.slug}/`}><span class="compact-icon"><i class="fas fa-scale-balanced"></i></span><div><h3 data-i18n-en={item.title_en} data-i18n-zh={item.title_zh}>{item.title_en}</h3><p data-i18n-en={item.desc_en} data-i18n-zh={item.desc_zh}>{item.desc_en}</p></div><i class="fas fa-arrow-right"></i></a>)}</div></div>
        <div class="discovery-column"><div class="section-heading"><span class="section-kicker" data-i18n-en="Practical Guides">Practical Guides</span><h2 data-i18n-en="From the blog">From the blog</h2></div><div class="compact-link-grid">{popularGuides.map(item => <a href={`/blog/${item.slug}/`}><span class="compact-icon"><i class="fas fa-newspaper"></i></span><div><h3 data-i18n-en={item.title_en} data-i18n-zh={item.title_zh}>{item.title_en}</h3><p data-i18n-en={item.desc_en} data-i18n-zh={item.desc_zh}>{item.desc_en}</p></div><i class="fas fa-arrow-right"></i></a>)}</div><a class="text-link" href="/blog/" data-i18n-en="Read all guides →">Read all guides →</a></div>
      </div>
    </section>

    <section class="home-section updates-section"><div class="home-shell"><div class="section-heading center-heading"><span class="section-kicker" data-i18n-en="Editorial Updates">Editorial Updates</span><h2 data-i18n-en="What we're testing now">What we're testing now</h2></div><div class="update-grid">{editorialLog.map(item => <article><time>{item.date}</time><h3 data-i18n-en={item.title_en} data-i18n-zh={item.title_zh}>{item.title_en}</h3><p data-i18n-en={item.desc_en} data-i18n-zh={item.desc_zh}>{item.desc_en}</p></article>)}</div></div></section>

    <section class="home-section faq-section home-faq"><div class="home-shell narrow-shell"><div class="section-heading center-heading"><span class="section-kicker">FAQ</span><h2 data-i18n-en="Frequently asked questions">Frequently asked questions</h2></div>{faq.map(item => <details><summary data-i18n-en={item.q_en} data-i18n-zh={item.q_zh}>{item.q_en}</summary><p data-i18n-en={item.a_en} data-i18n-zh={item.a_zh}>{item.a_en}</p></details>)}</div></section>


  </div>
</BaseLayout>
