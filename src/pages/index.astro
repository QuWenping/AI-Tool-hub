---
import BaseLayout from "../layouts/BaseLayout.astro";
import categoriesData from "../data/categories.json";
import toolsData from "../data/tools.json";
import matchupsData from "../data/matchups.json";
const tools = Object.entries(toolsData).map(([id, data]) => ({ id, data }));
const categoryLabels = { text: "Writing", image: "Image", code: "Code", video: "Video", audio: "Audio", productivity: "Business" };
const categoryLabelsZh = { text: "写作", image: "图像", code: "编程", video: "视频", audio: "音频", productivity: "商业" };
const catHero = [
  { cat: "text", icon: "fa-feather-alt", title_en: "Writing", title_zh: "文本创作", desc_en: "ChatGPT, Claude & more", desc_zh: "ChatGPT、Claude 等" },
  { cat: "image", icon: "fa-palette", title_en: "Images", title_zh: "图像生成", desc_en: "Midjourney, SD & more", desc_zh: "Midjourney、Stable Diffusion 等" },
  { cat: "code", icon: "fa-code", title_en: "Coding", title_zh: "编程助手", desc_en: "Cursor, Copilot & more", desc_zh: "Cursor、Copilot 等" },
  { cat: "video", icon: "fa-film", title_en: "Video", title_zh: "视频制作", desc_en: "Sora, Runway & more", desc_zh: "Sora、Runway 等" },
  { cat: "audio", icon: "fa-microphone-alt", title_en: "Audio", title_zh: "音频处理", desc_en: "ElevenLabs & more", desc_zh: "ElevenLabs 等" },
  { cat: "productivity", icon: "fa-bolt", title_en: "Business", title_zh: "商业效率", desc_en: "Perplexity, Notion & more", desc_zh: "Perplexity、Notion 等" }
];
const featuredMatchups = matchupsData.slice(0, 6);
const visibleTools = Object.entries(toolsData).filter(([id, t]) => !t.hidden);
const popularComparisons = [
  { slug: "chatgpt-vs-claude", title_en: "ChatGPT vs Claude", desc_en: "Pick the right general assistant" },
  { slug: "midjourney-vs-stable-diffusion", title_en: "Midjourney vs Stable Diffusion", desc_en: "Paid polish vs open-source control" },
  { slug: "cursor-vs-github-copilot", title_en: "Cursor vs GitHub Copilot", desc_en: "AI-native editor vs IDE plugin" },
  { slug: "sora-vs-runway", title_en: "Sora vs Runway", desc_en: "Closed cinematic vs open toolbox" }
];
const popularGuides = [
  { slug: "best-free-ai-tools-for-students-2026", title_en: "10 Best Free AI Tools for Students", desc_en: "Tested for 2 weeks on real assignments" },
  { slug: "chatgpt-vs-claude-which-should-you-pick-2026", title_en: "ChatGPT vs Claude: Which to Pick?", desc_en: "Two weeks of side-by-side testing" },
  { slug: "best-ai-image-generators-compared-2026", title_en: "Best AI Image Generators (2026)", desc_en: "Midjourney vs SD vs DALL-E vs Flux" }
];
const faq = [
  {
    q_en: "Is AI Tool Hub free to use?",
    q_zh: "AI Tool Hub 是免费的吗?",
    a_en: "Yes - browsing the directory, reading reviews, and using the search is 100% free. We make money through display advertising and a small number of clearly marked affiliate links, which never affect our rankings.",
    a_zh: "是的 - 浏览目录、阅读评测、使用搜索全部 100% 免费。我们通过展示广告和少量明确标注的联盟链接盈利，这永远不会影响我们的排名。"
  },
  {
    q_en: "How do you pick which AI tools to review?",
    q_zh: "你们如何挑选要评测的 AI 工具?",
    a_en: "We only list tools we would actually pay for. Every entry is tested hands-on for at least two weeks on real work, then scored on output quality, ease of use, pricing transparency, support, and privacy. Tools that score below 6.0 on any single dimension are excluded.",
    a_zh: "我们只列出我们真正愿意付费的工具。每个条目都在实际工作中经过至少两周的人工实测，然后按输出质量、易用性、价格透明度、客服和隐私维度评分。任何单项得分低于 6.0 的工具都会被排除。"
  },
  {
    q_en: "Do affiliate links influence your rankings?",
    q_zh: "联盟链接会影响你们的排名吗?",
    a_en: "Never. Our testing rubric is the only thing that determines what makes the list. Affiliate relationships are disclosed in our privacy policy and on the relevant tool pages.",
    a_zh: "绝不会。我们的评分标准是决定榜单的唯一因素。联盟合作关系会在隐私政策和相关工具页面披露。"
  },
  {
    q_en: "How often do you re-test the tools?",
    q_zh: "你们多久重新测试这些工具?",
    a_en: "We re-test our top picks every 6 months. AI tools change fast - a great tool today can be a mediocre one in a year. If a tool's quality drops or a much better alternative appears, we update the ranking immediately.",
    a_zh: "我们每 6 个月重新测试一次上榜工具。AI 工具发展很快 - 今天的优秀工具可能明年就平庸了。如果某工具质量下滑或出现更好的替代品，我们会立即更新排名。"
  },
  {
    q_en: "Can I suggest a tool you missed?",
    q_zh: "我可以推荐你们漏掉的工具吗?",
    a_en: "Absolutely. We read every message. If you know of an AI tool that should be on this list, send us a tip via the contact page and we will look into it.",
    a_zh: "当然可以。我们会阅读每一条消息。如果你知道一个应该上榜的 AI 工具，请通过联系页面告诉我们，我们会跟进。"
  }
];
---
<BaseLayout title="AI Tool Hub | Best AI Tools Directory (2026)" description="Find the best AI tools for writing, coding, image generation, video, audio, and productivity. Hand-tested by our editorial team. Updated weekly with 12+ in-depth reviews and 20+ curated categories.">

  <section class="hero">
    <h1>Find the <span>Best AI Tools</span> for Any Task</h1>
    <p data-i18n-en="Curated AI tools for writing, coding, design and business - hand-tested by our team." data-i18n-zh="为写作、编程、图像与商业精选的 AI 工具集">Curated AI tools for writing, coding, design and business - hand-tested by our team.</p>
    <div class="hero-cta">
      <a href="#tool-grid" id="cta-browse" class="cta-btn cta-primary" data-i18n-en="Browse Tools" data-i18n-zh="浏览工具">Browse Tools</a>
      <a href="/best/students/" class="cta-btn cta-secondary" data-i18n-en="Start Free" data-i18n-zh="免费开始">Start Free</a>
    </div>
    <div class="search-box">
      <i class="fas fa-search"></i>
      <input id="search-input" type="text" placeholder="Search AI tools..." data-i18n-placeholder-en="Search AI tools..." data-i18n-placeholder-zh="搜索 AI 工具...">
    </div>
  </section>

  <section class="categories">
    <div class="category-list">
      <button class="cat-btn active" data-category="all" data-i18n-en="All" data-i18n-zh="全部">All</button>
      <button class="cat-btn" data-category="text" data-i18n-en="Writing" data-i18n-zh="文本创作">Writing</button>
      <button class="cat-btn" data-category="image" data-i18n-en="Images" data-i18n-zh="图像生成">Images</button>
      <button class="cat-btn" data-category="code" data-i18n-en="Coding" data-i18n-zh="编程助手">Coding</button>
      <button class="cat-btn" data-category="video" data-i18n-en="Video" data-i18n-zh="视频制作">Video</button>
      <button class="cat-btn" data-category="audio" data-i18n-en="Audio" data-i18n-zh="音频处理">Audio</button>
      <button class="cat-btn" data-category="productivity" data-i18n-en="Business" data-i18n-zh="商业效率">Business</button>
    </div>
  </section>

  <section class="value-proposition">
    <h2 class="section-main-title" data-i18n-en="Why AI Tool Hub?" data-i18n-zh="为什么选择 AI Tool Hub?">Why AI Tool Hub?</h2>
    <div class="value-grid">
      <article class="value-card">
        <div class="value-icon"><i class="fas fa-gem"></i></div>
        <h3 data-i18n-en="Curated" data-i18n-zh="精挑细选">Curated</h3>
        <p data-i18n-en="No spam. Each tool is manually tested for quality." data-i18n-zh="拒绝垃圾信息，每款工具均经过人工实测。">No spam. Each tool is manually tested for quality.</p>
      </article>
      <article class="value-card">
        <div class="value-icon"><i class="fas fa-search-plus"></i></div>
        <h3 data-i18n-en="Deep Reviews" data-i18n-zh="深度评测">Deep Reviews</h3>
        <p data-i18n-en="More than links; providing real-world analysis and pros/cons." data-i18n-zh="不只是链接，提供真实的场景分析与优缺点对比。">More than links; providing real-world analysis and pros/cons.</p>
      </article>
      <article class="value-card">
        <div class="value-icon"><i class="fas fa-bolt"></i></div>
        <h3 data-i18n-en="Real-time" data-i18n-zh="实时更新">Real-time</h3>
        <p data-i18n-en="Catch the latest dynamics in AI and keep updated instantly." data-i18n-zh="捕捉 AI 领域最前沿的动态，第一时间同步更新。">Catch the latest dynamics in AI and keep updated instantly.</p>
      </article>
    </div>
  </section>

  <section class="category-hero">
    <div class="cat-hero-grid">
      {catHero.map(c => (
        <article class="cat-hero-card" data-category={c.cat}>
          <div class="cat-hero-icon"><i class={`fas ${c.icon}`}></i></div>
          <h3 data-i18n-en={c.title_en} data-i18n-zh={c.title_zh}>{c.title_en}</h3>
          <p data-i18n-en={c.desc_en} data-i18n-zh={c.desc_zh}>{c.desc_en}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="recommended-section">
    <div class="section-header">
      <h2 data-i18n-en="Recommended this Week" data-i18n-zh="本周推荐工具">Recommended this Week</h2>
      <p data-i18n-en="Top AI tools selected by community heat and utility." data-i18n-zh="根据社区热度和实用度筛选出的顶尖AI神器">Top AI tools selected by community heat and utility.</p>
    </div>
    <div id="rec-grid" class="rec-grid"></div>
  </section>

  <section class="recommended-section" id="all-tools">
    <div class="section-header">
      <h2 data-i18n-en="All " + visibleTools.length + " tools" data-i18n-zh={"全部 " + visibleTools.length + " 个 AI 工具"}>All {visibleTools.length} tools</h2>
      <p data-i18n-en="Filter by category or search by name to find the right AI tool." data-i18n-zh="按分类筛选或按名称搜索，找到最适合的 AI 工具。">Filter by category or search by name to find the right AI tool.</p>
    </div>
    <div id="tool-grid" class="tool-grid"></div>
  </section>

  <section class="related-section">
    <h2 class="section-main-title" data-i18n-en="Popular comparisons" data-i18n-zh="热门对比">Popular comparisons</h2>
    <div class="related-grid">
      {featuredMatchups.map(m => {
        const a = toolsData[m.a];
        const b = toolsData[m.b];
        return (
          <a class="related-card" href={"/vs/" + m.slug + "/"}>
            <div class="vs-pair">
              <div class="related-icon"><i class={`fas ${a?.icon || "fa-robot"}`}></i></div>
              <span class="vs-divider">VS</span>
              <div class="related-icon"><i class={`fas ${b?.icon || "fa-robot"}`}></i></div>
            </div>
            <div>
              <h3>{a?.name?.en || m.a} vs {b?.name?.en || m.b}</h3>
              <p>{m.title_en}</p>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <section class="related-section">
    <h2 class="section-main-title" data-i18n-en="Popular categories" data-i18n-zh="热门分类">Popular categories</h2>
    <div class="related-grid">
      {categoriesData.slice(0, 8).map(c => {
        const firstTool = toolsData[c.tools[0]];
        const catIcon = firstTool ? firstTool.icon : "fa-folder-open";
        return (
          <a class="related-card" href={"/best/" + c.slug + "/"}>
            <div class="related-icon"><i class={`fas ${catIcon}`}></i></div>
            <div>
              <h3>{c.title_en}</h3>
              <p>{c.desc_en}</p>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <section class="related-section">
    <h2 class="section-main-title" data-i18n-en="From the blog" data-i18n-zh="博客精选">From the blog</h2>
    <div class="related-grid">
      {popularGuides.map(g => (
        <a class="related-card" href={"/blog/" + g.slug + "/"}>
          <div class="related-icon"><i class="fas fa-newspaper"></i></div>
          <div>
            <h3>{g.title_en}</h3>
            <p>{g.desc_en}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="faq-section" style="margin: 40px 0;">
    <h2 class="section-main-title" style="text-align: center; margin-bottom: 32px;" data-i18n-en="Frequently asked questions" data-i18n-zh="常见问题">Frequently asked questions</h2>
    {faq.map(item => (
      <details>
        <summary data-i18n-en={item.q_en} data-i18n-zh={item.q_zh}>{item.q_en}</summary>
        <p data-i18n-en={item.a_en} data-i18n-zh={item.a_zh}>{item.a_en}</p>
      </details>
    ))}
  </section>

  <section class="related-section" style="text-align: center;">
    <h2 class="section-main-title" data-i18n-en="Get the directory in your inbox" data-i18n-zh="把目录收到你的邮箱">Get the directory in your inbox</h2>
    <p style="color: var(--text-mute); max-width: 560px; margin: 0 auto 16px;" data-i18n-en="We send a short, no-spam email every month with our top picks, hidden gems, and what is new in the AI tool world." data-i18n-zh="我们每月发送一封简短、无垃圾邮件的邮件，分享本月精选工具、隐藏神器以及 AI 工具世界的新动向。">We send a short, no-spam email every month with our top picks, hidden gems, and what is new in the AI tool world.</p>
    <a class="cta-btn cta-primary" href="/contact/" data-i18n-en="Subscribe" data-i18n-zh="订阅">Subscribe</a>
  </section>

</BaseLayout>
