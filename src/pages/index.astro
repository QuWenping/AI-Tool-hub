---
import BaseLayout from "../layouts/BaseLayout.astro";
import categories from "../data/categories.json";
import toolsData from "../data/tools.json";
const tools = Object.entries(toolsData).filter(function(e){return e[0]!=="codewords"}).map(function(e){return {id:e[0],data:e[1]}});
const featured = tools.filter(function(t){return t.data.featured}).slice(0, 3);
---
<BaseLayout title="AI Tool Hub | Best AI Tools Directory" lang="en">
<section>
<h1>Find the Best AI Tools for Any Task</h1>
<p>We tested {tools.length} popular AI tools hands-on. Here are the ones we would actually pay for.</p>
</section>
<section>
<h2>Editor picks</h2>
<ul>
{featured.map(function(t){return (<li><a href={"/tool/" + t.id + "/"}><strong>{t.data.name.en}</strong></a> - {t.data.short_desc.en}</li>)})}
</ul>
</section>
<section>
<h2>Browse by category</h2>
<ul>
{categories.map(function(c){return (<li><a href={"/best/" + c.slug + "/"}>{c.title_en}</a></li>)})}
</ul>
</section>
<section>
<h2>All tools</h2>
<ul>
{tools.map(function(t){return (<li><a href={"/tool/" + t.id + "/"}>{t.data.name.en}</a> - {t.data.short_desc.en}</li>)})}
</ul>
</section>
</BaseLayout>
