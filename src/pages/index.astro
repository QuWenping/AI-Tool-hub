---
import BaseLayout from "../layouts/BaseLayout.astro";
import categoriesData from "../data/categories.json";
import toolsData from "../data/tools.json";
import matchupsData from "../data/matchups.json";
import stackRecs from "../data/stack-recommendations.json";
import "../styles/home.css";

const visibleTools = Object.entries(toolsData).filter(([, tool]) => !tool.hidden);
const siteStats = {
  tools: visibleTools.length,
  categories: categoriesData.length,
  comparisons: matchupsData.length,
  testHours: 2000
};

const stackCatalog = stackRecs.tools
  .filter(rec => toolsData[rec.toolId] && !toolsData[rec.toolId].hidden)
  .map(rec => {
    const tool = toolsData[rec.toolId];
    return {
      id: rec.toolId,
      name: { en: tool.name?.en || rec.toolId, zh: tool.name?.zh || tool.name?.en || rec.toolId },
      description: { en: tool.short_desc?.en || "", zh: tool.short_desc?.zh || tool.short_desc?.en || "" },
      icon: tool.icon || "fa-robot",
      cat: tool.cat || "productivity",
      href: `/tool/${rec.toolId}/`,
      roles: rec.roles || [],
      goals: rec.goals || [],
      monthlyCost: typeof rec.monthlyCost === "number" ? rec.monthlyCost : 0,
      freeTier: !!rec.freeTier,
      stackRole: rec.stackRole || { en: "AI Assistant", zh: "AI 助手" },
      hoursSaved: typeof rec.hoursSaved === "number" ? rec.hoursSaved : 4,
      priority: typeof rec.priority === "number" ? rec.priority : 0
    };
  });

const featuredToolMeta = [
  { id: "chatgpt", rating: "9.4", price: "$20/mo", tags: ["Writing", "Reasoning", "Research"] },
  { id: "claude", rating: "9.3", price: "$20/mo", tags: ["Analysis", "Long Context", "Writing"] },
  { id: "cursor", rating: "9.6", price: "$20/mo", tags: ["Coding", "Editor", "Developer"] },
  { id: "midjourney", rating: "9.5", price: "$10–96/mo", tags: ["Images", "Design", "Art"] },
  { id: "runway", rating: "9.1", price: "$12–76/mo", tags: ["Video", "Editing", "Effects"] },
  { id: "elevenlabs", rating: "9.4", price: "$5–330/mo", tags: ["Voice", "Audio", "TTS"] }
].map(meta => ({ ...meta, tool: toolsData[meta.id] })).filter(item => item.tool);

const popularComparisons = [
  { slug: "chatgpt-vs-claude", title_en: "ChatGPT vs Claude", title_zh: "ChatGPT 对比 Claude", desc_en: "Pick the right general assistant", desc_zh: "选择更适合你的通用 AI 助手" },
  { slug: "midjourney-vs-stable-diffusion", title_en: "Midjourney vs Stable Diffusion", title_zh: "Midjourney 对比 Stable Diffusion", desc_en: "Paid polish vs open-source control", desc_zh: "商业品质与开源控制力的对比" },
  { slug: "cursor-vs-github-copilot", title_en: "Cursor vs GitHub Copilot", title_zh: "Cursor 对比 GitHub Copilot", desc_en: "AI-native editor vs IDE plugin", desc_zh: "AI 原生编辑器与 IDE 插件的对比" },
  { slug: "claude-vs-gemini", title_en: "Claude vs Gemini", title_zh: "Claude 对比 Gemini", desc_en: "Writing quality vs multimodal power", desc_zh: "写作质量与多模态能力的对比" },
  { slug: "elevenlabs-vs-chatgpt", title_en: "ElevenLabs vs ChatGPT Voice", title_zh: "ElevenLabs 对比 ChatGPT Voice", desc_en: "Professional voice AI vs integrated voice", desc_zh: "专业语音 AI 与集成语音的对比" },
  { slug: "sora-vs-runway", title_en: "Sora 2 vs Runway", title_zh: "Sora 2 对比 Runway", desc_en: "Highest quality vs production tools", desc_zh: "极致画质与成熟制作工具的对比" }
];

const popularGuides = [
  { slug: "best-free-ai-tools-for-students-2026", title_en: "10 Best Free AI Tools for Students", title_zh: "最适合学生的 10 款免费 AI 工具", desc_en: "Tested for two weeks on real assignments", desc_zh: "基于两周真实作业场景测试" },
  { slug: "chatgpt-vs-claude-which-should-you-pick-2026", title_en: "ChatGPT vs Claude: Which to Pick?", title_zh: "ChatGPT 和 Claude 应该选谁？", desc_en: "Two weeks of side-by-side testing", desc_zh: "两周并行实测结果" },
  { slug: "best-ai-image-generators-compared-2026", title_en: "Best AI Image Generators (2026)", title_zh: "2026 最佳 AI 图像生成器", desc_en: "Midjourney vs SD vs DALL-E vs Flux", desc_zh: "主流图像模型全面对比" }
];

const editorialLog = [
  { date: "2026-07-15", title_en: "Added Gemini, Leonardo.AI, and Jasper", title_zh: "新增 Gemini、Leonardo.AI 和 Jasper", desc_en: "Three new tools passed our hands-on quality review.", desc_zh: "三款新工具通过了我们的实际质量评测。" },
  { date: "2026-07-10", title_en: "Re-tested the top writing tools", title_zh: "重新测试主流写作工具", desc_en: "We refreshed rankings after another round of practical tests.", desc_zh: "经过新一轮实际测试后，我们更新了工具排名。" },
  { date: "2026-06-10", title_en: "Published our AI research tools guide", title_zh: "发布 AI 研究工具指南", desc_en: "Twelve research tools tested on a real thesis workflow.", desc_zh: "在真实论文工作流中测试了 12 款研究工具。" }
];

const faq = [
  { q_en: "Is AI Tool Hub free to use?", q_zh: "AI Tool Hub 是免费的吗？", a_en: "Yes. Browsing the directory, reading reviews, and using search are completely free.", a_zh: "是的。浏览工具目录、阅读评测和使用搜索功能完全免费。" },
  { q_en: "How do you choose which AI tools to review?", q_zh: "你们如何选择评测工具？", a_en: "We test tools on real work and evaluate output quality, usability, pricing transparency, support, and privacy.", a_zh: "我们在真实工作中测试工具，并评估输出质量、易用性、价格透明度、支持和隐私。" },
  { q_en: "Do affiliate links influence rankings?", q_zh: "联盟链接会影响排名吗？", a_en: "No. Commercial relationships never determine our scores or rankings.", a_zh: "不会。商业合作关系不会决定我们的评分或排名。" },
  { q_en: "How often do you re-test tools?", q_zh: "你们多久重新测试一次？", a_en: "Top picks are re-tested regularly and rankings are updated whenever product quality changes.", a_zh: "我们会定期重新测试重点工具，并在产品质量发生变化时更新排名。" }
];
---
<BaseLayout
  title="AI Tool Hub | Find Your Perfect AI Stack"
  description="Discover, compare, and build your ideal AI stack. Explore tested AI tools for writing, coding, images, video, audio, and productivity."
  fullWidth={true}
>
  <div class="home-page">
    <section class="home-hero">
      <div class="home-shell hero-layout">
        <div class="hero-copy">
          <div class="hero-badge" data-i18n-en="🚀 NEW: AI Benchmark Lab v2.0" data-i18n-zh="🚀 全新：AI 基准测试实验室 v2.0">🚀 NEW: AI Benchmark Lab v2.0</div>
          <h1><span class="title-prefix" data-i18n-en="Find Your Perfect" data-i18n-zh="找到你的完美">Find Your Perfect</span> <span class="title-highlight" data-i18n-en="AI Stack" data-i18n-zh="AI 工具栈">AI Stack</span></h1>
          <p class="hero-subtitle" data-i18n-en="Stop searching. Start building. We test hundreds of AI tools so you don't have to." data-i18n-zh="停止盲目搜索，开始高效创造。我们替你实测数百款 AI 工具。">Stop searching. Start building. We test hundreds of AI tools so you don't have to.</p>
          <div class="hero-actions">
            <a class="home-button primary" href="#finder"><i class="fas fa-wand-magic-sparkles"></i><span data-i18n-en="Find My AI Stack" data-i18n-zh="寻找我的 AI 工具栈">Find My AI Stack</span></a>
            <a class="home-button secondary" href="#all-tools"><span data-i18n-en="Explore All Tools" data-i18n-zh="浏览全部工具">Explore All Tools</span><i class="fas fa-arrow-right"></i></a>
          </div>
          <div class="hero-stats" aria-label="Site statistics">
            <div><strong>{siteStats.tools}+</strong><span data-i18n-en="AI Tools Reviewed" data-i18n-zh="AI 工具评测">AI Tools Reviewed</span></div>
            <div><strong>{siteStats.testHours}+</strong><span data-i18n-en="Testing Hours" data-i18n-zh="测试小时">Testing Hours</span></div>
            <div><strong>{siteStats.comparisons}+</strong><span data-i18n-en="Comparisons" data-i18n-zh="深度对比">Comparisons</span></div>
          </div>
        </div>
        <div class="hero-visual" aria-label="Featured AI tools">
          {featuredToolMeta.slice(0, 4).map(({ id, tool }) => (
            <a class="visual-tool" href={`/tool/${id}/`}>
              <span class="visual-icon"><i class={`fas ${tool.icon || "fa-robot"}`}></i></span>
              <strong>{tool.name.en}</strong>
              <span>{tool.short_desc.en}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section value-section">
      <div class="home-shell">
        <div class="center-heading">
          <span class="section-kicker" data-i18n-en="Why AI Tool Hub" data-i18n-zh="为什么选择 AI Tool Hub">Why AI Tool Hub</span>
          <h2 data-i18n-en="Make confident AI decisions" data-i18n-zh="更有把握地选择 AI 工具">Make confident AI decisions</h2>
          <p data-i18n-en="Practical research, clear comparisons, and workflows you can actually use." data-i18n-zh="真实评测、清晰对比，以及你真正用得上的工作流。">Practical research, clear comparisons, and workflows you can actually use.</p>
        </div>
        <div class="value-grid">
          <article class="value-card"><i class="fas fa-check-circle"></i><h3 data-i18n-en="Real-World Testing" data-i18n-zh="真实场景测试">Real-World Testing</h3><p data-i18n-en="Every recommendation is based on practical tasks, not marketing claims." data-i18n-zh="每项推荐都基于实际任务，而不是营销宣传。">Every recommendation is based on practical tasks, not marketing claims.</p></article>
          <article class="value-card"><i class="fas fa-chart-line"></i><h3 data-i18n-en="Clear Benchmarks" data-i18n-zh="清晰基准测试">Clear Benchmarks</h3><p data-i18n-en="Compare quality, speed, cost, and usability with consistent criteria." data-i18n-zh="用一致标准比较质量、速度、成本和易用性。">Compare quality, speed, cost, and usability with consistent criteria.</p></article>
          <article class="value-card"><i class="fas fa-layer-group"></i><h3 data-i18n-en="Stack Builder" data-i18n-zh="工具栈搭配">Stack Builder</h3><p data-i18n-en="Combine complementary tools into a focused workflow for your goals." data-i18n-zh="根据你的目标，将互补工具组合成高效工作流。">Combine complementary tools into a focused workflow for your goals.</p></article>
          <article class="value-card"><i class="fas fa-arrows-rotate"></i><h3 data-i18n-en="Always Current" data-i18n-zh="持续更新">Always Current</h3><p data-i18n-en="We revisit leading tools as models, pricing, and features change." data-i18n-zh="随着模型、价格和功能变化，我们会持续复测主流工具。">We revisit leading tools as models, pricing, and features change.</p></article>
        </div>
      </div>
    </section>

    <section class="home-section finder-section" id="finder">
      <div class="home-shell">
        <div class="section-heading">
          <span class="section-kicker" data-i18n-en="AI Stack Finder" data-i18n-zh="AI 工具栈推荐">AI Stack Finder</span>
          <h2 data-i18n-en="Find your AI stack in 30 seconds" data-i18n-zh="30 秒找到适合你的 AI 工具栈">Find your AI stack in 30 seconds</h2>
          <p data-i18n-en="Choose one option in each group to get a personalized starting stack." data-i18n-zh="每组选一项，即可获得为你量身推荐的起步工具栈。">Choose one option in each group to get a personalized starting stack.</p>
        </div>
        <div class="finder-card" id="stack-builder">
          <script type="application/json" id="stack-catalog" set:html={JSON.stringify(stackCatalog)}></script>
          <div class="finder-steps">
            <fieldset class="finder-step">
              <legend><span>1</span><strong data-i18n-en="Who are you?" data-i18n-zh="你的角色是？">Who are you?</strong></legend>
              <div class="option-grid">
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="role" data-stack-value="founder" data-i18n-en="Founder" data-i18n-zh="创业者">Founder</button>
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="role" data-stack-value="developer" data-i18n-en="Developer" data-i18n-zh="开发者">Developer</button>
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="role" data-stack-value="designer" data-i18n-en="Designer" data-i18n-zh="设计师">Designer</button>
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="role" data-stack-value="marketer" data-i18n-en="Marketer" data-i18n-zh="营销人员">Marketer</button>
              </div>
            </fieldset>
            <fieldset class="finder-step">
              <legend><span>2</span><strong data-i18n-en="What's your goal?" data-i18n-zh="你的目标是？">What's your goal?</strong></legend>
              <div class="option-grid">
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="goal" data-stack-value="save-time" data-i18n-en="Save time" data-i18n-zh="节省时间">Save time</button>
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="goal" data-stack-value="automate" data-i18n-en="Automate tasks" data-i18n-zh="自动化任务">Automate tasks</button>
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="goal" data-stack-value="create-content" data-i18n-en="Create content" data-i18n-zh="创作内容">Create content</button>
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="goal" data-stack-value="generate-code" data-i18n-en="Generate code" data-i18n-zh="生成代码">Generate code</button>
              </div>
            </fieldset>
            <fieldset class="finder-step">
              <legend><span>3</span><strong data-i18n-en="What's your budget?" data-i18n-zh="你的预算是？">What's your budget?</strong></legend>
              <div class="option-grid">
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="budget" data-stack-value="free" data-i18n-en="Free" data-i18n-zh="免费">Free</button>
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="budget" data-stack-value="0-50">$0–50/mo</button>
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="budget" data-stack-value="50-200">$50–200/mo</button>
                <button class="finder-option" type="button" aria-pressed="false" data-stack-group="budget" data-stack-value="enterprise" data-i18n-en="Enterprise" data-i18n-zh="企业级">Enterprise</button>
              </div>
            </fieldset>
            <div class="finder-progress" aria-live="polite">
              <div class="progress-track"><div class="progress-bar" data-stack-progress-bar></div></div>
              <span class="progress-label" data-stack-progress-label>0 of 3 answered — pick your role to start</span>
            </div>
          </div>
          <aside class="finder-result" aria-live="polite" data-stack-result data-status="pending">
            <div class="finder-result-pending" data-stack-pending>
              <span class="result-label" data-i18n-en="Your recommended stack" data-i18n-zh="推荐工具栈">Your recommended stack</span>
              <h3 data-i18n-en="Answer three quick questions" data-i18n-zh="回答三个简短问题">Answer three quick questions</h3>
              <p data-i18n-en="Select role, goal and budget above. We'll match three complementary AI tools you can use immediately." data-i18n-zh="选择上方角色、目标和预算，我们会为你搭配三款可立即使用的互补 AI 工具。">Select role, goal and budget above. We'll match three complementary AI tools you can use immediately.</p>
              <div class="pending-preview">
                <span><i class="fas fa-user-tie"></i><span data-i18n-en="1. Role" data-i18n-zh="1. 角色">1. Role</span></span>
                <span><i class="fas fa-bullseye"></i><span data-i18n-en="2. Goal" data-i18n-zh="2. 目标">2. Goal</span></span>
                <span><i class="fas fa-coins"></i><span data-i18n-en="3. Budget" data-i18n-zh="3. 预算">3. Budget</span></span>
              </div>
            </div>
            <div class="finder-result-ready" data-stack-ready hidden>
              <span class="result-label" data-i18n-en="Your recommended stack" data-i18n-zh="推荐工具栈">Your recommended stack</span>
              <h3 data-stack-title>A flexible stack for modern work</h3>
              <p data-stack-summary></p>
              <div class="stack-list" data-stack-list></div>
              <div class="stack-summary" data-stack-summary-block>
                <div class="summary-item">
                  <span class="summary-label" data-i18n-en="Monthly cost" data-i18n-zh="每月成本">Monthly cost</span>
                  <strong data-stack-cost>—</strong>
                </div>
                <div class="summary-item">
                  <span class="summary-label" data-i18n-en="Time saved" data-i18n-zh="每周节省">Time saved</span>
                  <strong data-stack-hours>—</strong>
                </div>
              </div>
              <div class="stack-actions">
                <a class="home-button primary result-button" data-stack-explore href="#all-tools" data-i18n-en="Explore matching tools" data-i18n-zh="浏览匹配工具">Explore matching tools</a>
                <button type="button" class="stack-action" data-stack-share>
                  <i class="fas fa-share-nodes"></i>
                  <span data-i18n-en="Copy share link" data-i18n-zh="复制分享链接">Copy share link</span>
                </button>
                <button type="button" class="stack-action" data-stack-reset>
                  <i class="fas fa-arrow-rotate-left"></i>
                  <span data-i18n-en="Reset" data-i18n-zh="重置">Reset</span>
                </button>
              </div>
              <p class="stack-disclaimer" data-i18n-en="Estimates are baselines from public plans. Your actual results depend on usage." data-i18n-zh="估算基于公开价格与常见用量。实际结果因人而异。">Estimates are baselines from public plans. Your actual results depend on usage.</p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="home-section featured-tools" id="featured-tools">
      <div class="home-shell">
        <div class="section-heading split-heading"><div><span class="section-kicker" data-i18n-en="Editor's Picks" data-i18n-zh="编辑精选">Editor's Picks</span><h2 data-i18n-en="Featured AI tools" data-i18n-zh="精选 AI 工具">Featured AI tools</h2><p data-i18n-en="High-performing tools tested in real workflows." data-i18n-zh="在真实工作流中表现出色的工具。">High-performing tools tested in real workflows.</p></div><a href="#all-tools" data-i18n-en="View full directory →" data-i18n-zh="查看完整目录 →">View full directory →</a></div>
        <div class="featured-tool-grid">
          {featuredToolMeta.map(({ id, tool, rating, price, tags }) => (
            <article class="featured-tool-card">
              <div class="tool-card-top"><span class="featured-tool-icon"><i class={`fas ${tool.icon || "fa-robot"}`}></i></span><div class="featured-rating"><span>★★★★★</span><strong>{rating}</strong></div></div>
              <h3>{tool.name.en}</h3>
              <p data-i18n-en={tool.short_desc.en} data-i18n-zh={tool.short_desc.zh}>{tool.short_desc.en}</p>
              <div class="featured-tags">{tags.map(tag => <span>{tag}</span>)}</div>
              <div class="featured-tool-footer"><strong>{price}</strong><a href={`/tool/${id}/`} data-i18n-en="Learn more" data-i18n-zh="查看详情">Learn more</a></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section benchmark-section" id="benchmarks">
      <div class="home-shell">
        <div class="section-heading"><span class="section-kicker" data-i18n-en="Independent Benchmarks" data-i18n-zh="独立基准测试">Independent Benchmarks</span><h2 data-i18n-en="AI coding benchmark" data-i18n-zh="AI 编程工具基准测试">AI coding benchmark</h2><p data-i18n-en="A practical snapshot based on accuracy, response speed, pricing, and daily usability." data-i18n-zh="基于准确率、响应速度、价格和日常易用性的实测概览。">A practical snapshot based on accuracy, response speed, pricing, and daily usability.</p></div>
        <div class="benchmark-card"><div class="table-scroll"><table><thead><tr><th data-i18n-en="Tool" data-i18n-zh="工具">Tool</th><th data-i18n-en="Accuracy" data-i18n-zh="准确率">Accuracy</th><th data-i18n-en="Average speed" data-i18n-zh="平均速度">Average speed</th><th data-i18n-en="Entry price" data-i18n-zh="起步价格">Entry price</th><th data-i18n-en="Overall" data-i18n-zh="综合评分">Overall</th></tr></thead><tbody><tr><td><a href="/tool/cursor/"><i class="fas fa-code"></i><strong>Cursor</strong></a></td><td><span class="score high">96%</span></td><td>2.1s</td><td>$20/mo</td><td><b>9.6</b></td></tr><tr><td><a href="/tool/claude/"><i class="fas fa-feather-alt"></i><strong>Claude</strong></a></td><td><span class="score high">94%</span></td><td>3.2s</td><td>$20/mo</td><td><b>9.3</b></td></tr><tr><td><a href="/tool/github-copilot/"><i class="fab fa-github"></i><strong>GitHub Copilot</strong></a></td><td><span class="score medium">89%</span></td><td>1.8s</td><td>$10/mo</td><td><b>8.8</b></td></tr></tbody></table></div></div>
      </div>
    </section>

    <section class="home-section directory-section" id="all-tools">
      <div class="home-shell">
        <div class="section-heading center-heading"><span class="section-kicker" data-i18n-en="Complete Directory" data-i18n-zh="完整工具目录">Complete Directory</span><h2 data-i18n-en={`Explore ${siteStats.tools}+ AI tools`} data-i18n-zh={`探索 ${siteStats.tools}+ 款 AI 工具`}>Explore {siteStats.tools}+ AI tools</h2><p data-i18n-en="Search by name or filter by category to find the right tool for your work." data-i18n-zh="按名称搜索或按分类筛选，找到适合你的工具。">Search by name or filter by category to find the right tool for your work.</p></div>
