---
import BaseLayout from "../../layouts/BaseLayout.astro";
import toolsData from "../../data/tools.json";
export async function getStaticPaths() {
  return Object.entries(toolsData).filter(function(e){return e[0]!=="codewords"}).map(function(e){return {params:{slug:e[0]},props:{id:e[0],tool:e[1]}}});
}
const { id, tool } = Astro.props;
const tName = (tool && tool.name && tool.name.en) || "Tool";
const tShort = (tool && tool.short_desc && tool.short_desc.en) || "";
const tLong = (tool && tool.long_desc && tool.long_desc.en) || "";
const tPros = (tool && tool.pros && tool.pros.en) || [];
const tCons = (tool && tool.cons && tool.cons.en) || [];
const tUse = (tool && tool.use_cases && tool.use_cases.en) || [];
const tFeatures = (tool && tool.features && tool.features.en) || [];
const tCat = (tool && tool.cat) || "ai";
---
<BaseLayout title={tName + " Review (2026) | AI Tool Hub"} description={tShort} keywords={tName + ", " + tName + " review, " + tName + " pricing, " + tCat + " AI tools"}>
<article class="tool-detail-container">
  <nav class="breadcrumbs"><a href="/">Home</a> &rsaquo; <a href={"/best/" + tCat + "/"}>Best {tCat} AI tools</a> &rsaquo; <span>{tName}</span></nav>
  <h1>{tName} Review (2026)</h1>
  <p class="lede">{tShort}</p>

  <section>
    <h2>What is {tName}?</h2>
    <p>{tLong}</p>
  </section>

  <section>
    <h2>Pros</h2>
    <ul class="pro-list">{tPros.map(function(p){return (<li>{p}</li>)})}</ul>
  </section>

  <section>
    <h2>Cons</h2>
    <ul class="con-list">{tCons.map(function(c){return (<li>{c}</li>)})}</ul>
  </section>

  <section>
    <h2>Use cases that actually work</h2>
    <ul>{tUse.map(function(u){return (<li>{u}</li>)})}</ul>
  </section>

  <section>
    <h2>Features</h2>
    <ul>{tFeatures.map(function(f){return (<li>{f}</li>)})}</ul>
  </section>

  <section class="related">
    <h2>Alternatives</h2>
    <ul>
      <li><a class="cta-primary" href={"/alternatives/" + id + "/"}>All {tName} alternatives</a></li>
    </ul>
  </section>

  <section class="related">
    <h2>Popular comparisons</h2>
    <ul>
      <li><a href="/vs/chatgpt-vs-claude/">ChatGPT vs Claude</a></li>
      <li><a href="/vs/cursor-vs-github-copilot/">Cursor vs GitHub Copilot</a></li>
      <li><a href="/vs/midjourney-vs-stable-diffusion/">Midjourney vs Stable Diffusion</a></li>
    </ul>
  </section>
</article>
</BaseLayout>
