---
import fs from "fs";
import BaseLayout from "../../layouts/BaseLayout.astro";
import toolsData from "../../data/tools.json";
import matchupsData from "../../data/matchups.json";
import categories from "../../data/categories.json";
import editorialData from "../../data/tool-editorial.json";
import TLDR from "../../components/ui/TLDR.astro";
import ProsCons from "../../components/ui/ProsCons.astro";
import AdSlot from "../../components/ui/AdSlot.astro";
import QuickFacts from "../../components/ui/QuickFacts.astro";
import FeatureTable from "../../components/ui/FeatureTable.astro";
import TestStatus from "../../components/ui/TestStatus.astro";
import ToolFAQ from "../../components/ui/ToolFAQ.astro";
import ScreenshotGallery from "../../components/ui/ScreenshotGallery.astro";
import ScoreCard from "../../components/ui/ScoreCard.astro";
import SaveButton from "../../components/ui/SaveButton.astro";

export async function getStaticPaths() {
  return Object.entries(toolsData)
    .filter(([id]) => id !== "codewords")
    .map(([id, tool]) => ({ params: { slug: id }, props: { id, tool } }));
}

const { id, tool } = Astro.props;
const editorial = editorialData[id] || null;
const isReviewed = !!(editorial && editorial.reviewed);

const tNameEn = tool?.name?.en || "AI Tool";
const tNameZh = tool?.name?.zh || tNameEn;
const tShortEn = tool?.short_desc?.en || "";
const tShortZh = tool?.short_desc?.zh || tShortEn;
const tLongEn = tool?.long_desc?.en || "";
const tLongZh = tool?.long_desc?.zh || tLongEn;
const tProsEn = tool?.pros?.en || [];
const tConsEn = tool?.cons?.en || [];
const tUseEn = tool?.use_cases?.en || [];
const tUseZh = tool?.use_cases?.zh || [];
const tFeaturesEn = tool?.features?.en || [];
const tFeaturesZh = tool?.features?.zh || [];
const tScenesEn = tool?.scenes?.en || [];
const tScenesZh = tool?.scenes?.zh || [];
const tAudienceEn = tool?.target_audience?.en || [];
const tAudienceZh = tool?.target_audience?.zh || [];
const tExampleEn = tool?.example?.en || "";
const tExampleZh = tool?.example?.zh || "";
const tCat = tool?.cat || "productivity";
const tUrl = tool?.url || "#";
const tIcon = tool?.icon || "fa-robot";

const categoryLabels = { text: "Writing", image: "Image", code: "Coding", video: "Video", audio: "Audio", productivity: "Productivity" };
const categoryLabelsZh = { text: "写作", image: "图像", code: "编程", video: "视频", audio: "音频", productivity: "商业" };
const catLabelEn = categoryLabels[tCat] || tCat;
const catLabelZh = categoryLabelsZh[tCat] || tCat;

const relatedCategories = categories.filter(c => c.tools?.includes(id)).slice(0, 4);
const allTools = Object.entries(toolsData).filter(([k, v]) => k !== "codewords" && !v?.hidden);
const alternatives = allTools.filter(([k, t]) => k !== id && t.cat === tCat).slice(0, 6);
const toolMatchups = matchupsData.filter(m => m.a === id || m.b === id).slice(0, 4);

// Screenshot resolution: prefer WebP over JPG when same basename exists
const screenshotDir = `public/images/tools/${id}`;
const hasScreenshots = fs.existsSync(screenshotDir);
let screenshotFiles = [];
if (hasScreenshots) {
  const all = fs.readdirSync(screenshotDir).filter(f => /\.(jpg|jpeg|png|webp|avif)$/i.test(f));
  const map = new Map();
  for (const file of all) {
    const base = file.replace(/\.[^.]+$/, "");
    const ext = file.split(".").pop().toLowerCase();
    const rank = ext === "avif" ? 3 : ext === "webp" ? 2 : 1;
    const existing = map.get(base);
    if (!existing || rank > existing.rank) {
      map.set(base, { file, rank });
    }
  }
  screenshotFiles = [...map.values()].map(x => x.file).sort().slice(0, 4);
}
const screenshotImages = screenshotFiles.map((sf, i) => ({
  src: `/images/tools/${id}/${sf}`,
  alt: `${tNameEn} screenshot ${i + 1}`
}));

const siteUrl = "https://thebestaitoolsreview.com";
const pageUrl = siteUrl + "/tool/" + id + "/";
const appCategoryMap = { text: "WritingApplication", image: "MultimediaApplication", code: "DeveloperApplication", video: "MultimediaApplication", audio: "MultimediaApplication", productivity: "BusinessApplication" };
const appCategory = appCategoryMap[tCat] || "MultimediaApplication";

// Rating: prefer editorial score, fallback for reviewed tools
const editorialScore = editorial?.score;
const rating = editorialScore || null;
const scoreBreakdown = editorial?.scoreBreakdown || null;

// Pricing: prefer editorial pricingSummary, fall back to catalog pricing field
const pricingSummaryEn = editorial?.pricingSummary?.en
  || (typeof tool?.pricing === "object" && tool?.pricing?.en)
  || (typeof tool?.pricing === "string" ? tool.pricing : "")
  || "";
const pricingSummaryZh = editorial?.pricingSummary?.zh
  || (typeof tool?.pricing === "object" && tool?.pricing?.zh)
  || pricingSummaryEn;

const quickFactsEn = [
  { label: "Category", value: catLabelEn },
  editorial?.testedVersion && { label: "Tested version", value: editorial.testedVersion },
  editorial?.quickFacts?.freeTier != null && { label: "Free tier", value: editorial.quickFacts.freeTier ? "Yes" : "No" },
  editorial?.quickFacts?.hasApi != null && { label: "API", value: editorial.quickFacts.hasApi ? "Available" : "Not available" },
  editorial?.quickFacts?.platforms?.length && { label: "Platforms", value: editorial.quickFacts.platforms.join(", ") },
  pricingSummaryEn && { label: "Pricing", value: pricingSummaryEn },
  { label: "Official site", value: tUrl.replace(/^https?:\/\//, "").split("/")[0] || "Visit", href: tUrl, rel: "nofollow noopener", external: true },
  editorial?.updatedAt && { label: "Updated", value: editorial.updatedAt },
  { label: "Editorial status", value: isReviewed ? "Editorially reviewed" : "AI-catalogued, pending review" }
].filter(Boolean);

const featureRowsEn = tFeaturesEn.map((f, i) => ({
  feature: f,
  description: tUseEn[i] || tScenesEn[i] || ""
}));

const faqItems = editorial?.faq || [];

// Editorial narrative
const ourIntros = {
  chatgpt: "ChatGPT is the AI assistant that started the generative AI boom in late 2022 and remains the most widely used AI product in 2026. The free tier ships GPT-4o mini, and the $20/month Plus plan unlocks GPT-5, image generation, voice mode, and Advanced Data Analysis.",
  claude: "Claude is Anthropic's answer to ChatGPT. In our long-form writing tests it produced the most natural English output among general assistants, and the 200K-token context window lets you paste 100+ pages in one prompt.",
  gemini: "Gemini 2.5 Pro is Google's flagship multimodal assistant. The 2M-token context window is the largest in the industry, the Google Search integration is the deepest, and Gemini Live delivers the most natural-sounding voice mode.",
  "github-copilot": "GitHub Copilot is still the gold standard for autocomplete inside your existing IDE. The free tier for verified students is one of the best deals in tech; the $10/month Individual or $19/month Business plan add chat, multi-file edits and enterprise controls.",
  cursor: "Cursor is a VS Code fork with GPT-4-level AI, codebase chat, and multi-file agent mode built in. It can refactor across dozens of files, generate whole features from a description, and chat about your entire codebase.",
  sora: "Sora 2 is OpenAI's text-to-video model and the current quality leader in 2026. Physics understanding, character consistency and 20-second clip length lead the category, though the price ceiling and safety filters are aggressive.",
  runway: "Runway is the veteran of AI video and still the most production-ready tool in the category. Gen-3 Alpha plus motion brush, inpainting, storyboard and Gen-3 upscale make it the default for creators who ship more than one-off clips.",
  midjourney: "Midjourney v7 has the highest aesthetic ceiling in image generation. Lighting, composition and color grading feel curated even on lazy prompts. Best for art, illustration and stylized brand assets.",
  "stable-diffusion": "Stable Diffusion 3.5 is the strongest open-source image model. Pick it when you need total control, custom styles, or zero per-image cost — and are comfortable with LoRAs, ControlNets and a decent GPU.",
  leonardo: "Leonardo.AI is the specialist for game art, character design and concept art. Alchemy mode maintains style consistency across generations, Canvas is the most polished in-app editor, and the free tier is generous.",
  elevenlabs: "ElevenLabs v3 delivers the most realistic text-to-speech in 2026. Voice cloning needs only 30 seconds of reference audio, 29 languages are supported natively, and emotional range is a genuine step up from prior versions.",
  suno: "Suno v4 can produce a complete song — vocals, lyrics, arrangement — from a short text description, and it is the only AI music tool in 2026 whose output we would publish. Chinese-language songs generate cleanly.",
  descript: "Descript works like a Word document for media: edit the transcript and the audio/video updates. AI filler-word removal, Studio Sound and Edit for Clarity cut editing time by 5–10× on interview-style content.",
  "notion-ai": "Notion AI is the writing/summarization layer inside Notion. If your team already runs on Notion, the $10/user/month add-on is the highest-value line item on this list because it happens where the work is.",
  perplexity: "Perplexity is the AI search engine that cites its sources. For research, market intelligence and product decisions it is dramatically faster than Google plus opening a dozen tabs.",
  jasper: "Jasper is the AI writing platform built specifically for marketing teams. Brand voice training, marketing templates and SEO mode become useful once you have three or more writers sharing a brand.",
  hostinger: "Hostinger is the low-cost hosting provider we recommend for small sites: cheapest tier in the category, easy hPanel control panel, WordPress one-click install. Traffic-heavy sites eventually outgrow the entry-level plans."
};
const ourVerdicts = {
  chatgpt: { best: "You want one assistant that does everything well — plugins, image generation, voice mode — for a fair $20/month.", avoid: "You publish long-form writing (Claude reads more naturally) or work primarily with video/audio input (Gemini's multimodal is stronger)." },
  claude: { best: "You write for a living. Long context, Artifacts and natural writing style are best-in-class at $20/month Pro.", avoid: "You rely on real-time web search (Perplexity or Gemini fit better) or need voice/image tools (ChatGPT Plus is more well-rounded)." },
  gemini: { best: "You work with multimodal content (video, audio, images) or live research; Google Search integration is deepest and Gemini Live is the best voice mode.", avoid: "Your main workload is long-form English writing — Claude reads more naturally." },
  "github-copilot": { best: "You want fast, accurate autocomplete inside the IDE you already use. Individual plan is $10/month; students are free.", avoid: "You regularly refactor across many files or want repo-wide agent workflows — Cursor is more capable." },
  cursor: { best: "You are a full-time developer refactoring code, debugging unfamiliar codebases and shipping features every week. The $20/month Pro plan pays back within days.", avoid: "You only code a few hours a week or you refuse to leave JetBrains — stick with Copilot." },
  sora: { best: "Quality is the priority and the budget exists — cinematic shots, character consistency and 20s clips beat the field.", avoid: "You need editing tools or 5–10s social clips — Runway or Pika are faster and cheaper." },
  runway: { best: "You are a creative professional shipping ads, music videos or short films. Motion brush, inpainting and storyboard are unmatched.", avoid: "You only need one-off social clips or the tightest budget — Kling free tier or Hailuo covers that." },
  midjourney: { best: "You want highest aesthetic ceiling with almost no prompt engineering. Standard plan at $30/month is the sweet spot.", avoid: "You need photorealism (Flux Pro), text in images (Ideogram) or total control (Stable Diffusion)." },
  "stable-diffusion": { best: "You want total control, custom styles or zero per-image cost, and you can handle LoRAs, ControlNets and a decent GPU.", avoid: "Command-line tools and GPU setup are a barrier — use Midjourney or DALL-E." },
  leonardo: { best: "You are a game artist, character designer or concept artist and value consistent style across generations.", avoid: "Your work is generic image generation for blogs/social — Midjourney or DALL-E is simpler." },
  elevenlabs: { best: "Voice quality matters — audiobooks, podcasts, YouTube narration. Starter $5/month is enough for hobbyists.", avoid: "You need production-scale TTS at the lowest per-character price — PlayHT is cheaper." },
  suno: { best: "You need custom music or jingles for videos, podcasts or personal projects. Free tier covers hobby use.", avoke: null, avoid: "You need a specific song by a specific artist — AI music tools cannot deliver that." },
  descript: { best: "You edit audio or video regularly and want transcript-based workflows plus Studio Sound.", avoid: "You edit rarely (learning curve is too high) or you do music production (use a traditional DAW)." },
  "notion-ai": { best: "Your team already runs on Notion — $10/user/month AI happens exactly where the work is.", avoid: "You do not use Notion — pay a general assistant instead." },
  perplexity: { best: "You do regular research, market intelligence or investment work and need cited sources.", avoid: "You need a general assistant with plugins or the deepest multimodal — pick ChatGPT Plus or Gemini." },
  jasper: { best: "You manage a marketing team of 3+ writers who need brand-voice consistency. Team plan starts at $125/month.", avoid: "You are an individual marketer — Claude Pro delivers similar output for less money." },
  hostinger: { best: "You are launching a small site or side project and want the lowest price on the market.", avoid: "You run high-traffic or mission-critical apps — Cloudways or Vercel are better fits." }
};
const ourIntro = ourIntros[id] || `${tNameEn}. ${tLongEn || tShortEn}`;
const ourVerdict = ourVerdicts[id] || {
  best: `${tNameEn} is a fit if you need a reliable ${catLabelEn.toLowerCase()} AI tool with ${tProsEn[0] ? tProsEn[0].toLowerCase() : "solid fundamentals"}.`,
  avoid: `${tNameEn} is not the right fit if you need capabilities outside ${catLabelEn.toLowerCase()} — look at the alternatives below.`
};

// Structured data
const seoTitle = isReviewed
  ? `${tNameEn} Review 2026: Features, Pricing, Alternatives & Use Cases`
  : `${tNameEn}: Features, Pricing, Alternatives & Use Cases`;
const seoDescription = `${tNameEn} ${isReviewed ? "review" : "overview"} for 2026 — ${tShortEn || `a ${catLabelEn.toLowerCase()} AI tool`}. Features, pricing, pros/cons, alternatives and FAQs.`.slice(0, 158);

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: tNameEn,
  description: tShortEn || tLongEn,
  url: pageUrl,
  image: siteUrl + "/og-image.svg",
  applicationCategory: appCategory,
  operatingSystem: "Web, iOS, Android",
  author: { "@type": "Organization", name: "AI Tool Hub Editorial", url: siteUrl },
  publisher: { "@type": "Organization", name: "AI Tool Hub", url: siteUrl }
};
if (isReviewed && rating) {
  softwareSchema.review = {
    "@type": "Review",
    author: { "@type": "Person", name: "AI Tool Hub Editorial Team", jobTitle: "Lead Reviewer", url: siteUrl + "/team/" },
    publisher: { "@type": "Organization", name: "AI Tool Hub", url: siteUrl },
    datePublished: editorial?.updatedAt || "2026-07-01",
    reviewRating: { "@type": "Rating", ratingValue: rating, bestRating: 10, worstRating: 1 }
  };
}
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl + "/" },
    { "@type": "ListItem", position: 2, name: "Best " + catLabelEn, item: siteUrl + "/best/" + tCat + "/" },
    { "@type": "ListItem", position: 3, name: tNameEn, item: pageUrl }
  ]
};

const tocSections = [
  { id: "overview", label: "What is " + tNameEn + "?" },
  { id: "our-take", label: "Our take" },
  screenshotImages.length > 0 && { id: "screenshots", label: "Screenshots" },
  { id: "test-status-heading", label: "Real test data" },
  featureRowsEn.length > 0 && { id: "features", label: "Key features" },
  tUseEn.length > 0 && { id: "use-cases", label: "Use cases" },
  tScenesEn.length > 0 && { id: "best-for", label: "Best for" },
  tAudienceEn.length > 0 && { id: "audience", label: "Target audience" },
  { id: "pricing", label: "Pricing" },
  (tProsEn.length + tConsEn.length > 0) && { id: "pros-cons", label: "Pros & Cons" },
  tExampleEn && { id: "example", label: "Example" },
  { id: "verdict", label: "Our verdict" },
  toolMatchups.length > 0 && { id: "comparisons", label: "Comparisons" },
  alternatives.length > 0 && { id: "alternatives", label: "Alternatives" },
  faqItems.length > 0 && { id: "tool-faq-heading", label: "FAQ" },
  relatedCategories.length > 0 && { id: "related", label: "Related categories" }
].filter(Boolean);
---
<BaseLayout
  title={seoTitle}
  description={seoDescription}
  keywords={`${tNameEn}, ${tNameEn} review, ${tNameEn} pricing, ${catLabelEn} AI tools`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  </Fragment>
  <article class="tool-detail">
  <div class="article-grid">
    <div class="article-main">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> &rsaquo;
      <a href={"/best/" + tCat + "/"}>Best {catLabelEn}</a> &rsaquo;
      <span>{tNameEn}</span>
    </nav>

    <header class="tool-detail-header">
      <div class="icon" aria-hidden="true"><i class={`fas ${tIcon}`}></i></div>
      <div class="title-group">
        <h1>{tNameEn}</h1>
        <div class="tool-detail-meta">
          <span class="tag">{catLabelEn}</span>
          {isReviewed && rating && (
            <span class="tool-rating-inline">
              <i class="fas fa-star" aria-hidden="true"></i>
              <strong>{rating.toFixed(1)}</strong><span>/10</span>
            </span>
          )}
          {isReviewed
            ? <span class="status-badge status-badge--reviewed"><i class="fas fa-check-circle" aria-hidden="true"></i> Editorially reviewed</span>
            : <span class="status-badge status-badge--pending"><i class="fas fa-info-circle" aria-hidden="true"></i> AI-catalogued, pending review</span>}
          {editorial?.updatedAt && (
            <span class="tool-detail-updated"><i class="fas fa-sync-alt" aria-hidden="true"></i> Updated {editorial.updatedAt}</span>
          )}
        </div>
      </div>
      <div class="actions">
        <a class="use" href={tUrl} rel="nofollow noopener" target="_blank">
          <i class="fas fa-external-link-alt" aria-hidden="true"></i> Visit {tNameEn}
        </a>
        <a class="alt" href={"/alternatives/" + id + "/"}>Alternatives</a>
        <SaveButton toolId={id} toolName={tNameEn} />
      </div>
    </header>

    <p class="lede">{tShortEn}</p>

    <QuickFacts items={quickFactsEn} />

    {isReviewed && rating && scoreBreakdown && (
      <ScoreCard score={rating} breakdown={scoreBreakdown} toolName={tNameEn} />
    )}

    <TLDR items={[
      `${tNameEn} is a ${catLabelEn.toLowerCase()} AI tool: ${tShortEn || tLongEn || "an AI-powered helper"}.`,
      pricingSummaryEn ? `Pricing: ${pricingSummaryEn}` : "Pricing: see the official plan page for current pricing.",
      `Best for: ${tUseEn[0] || tScenesEn[0] || "general " + catLabelEn.toLowerCase() + " tasks"}.`,
      isReviewed
        ? `Editorially reviewed by AI Tool Hub${editorial?.testedVersion ? ` (tested version: ${editorial.testedVersion})` : ""}.`
        : "Catalogued by AI Tool Hub — full hands-on review pending."
    ]} />

    <AdSlot format="banner" label="Advertisement" />

    <section class="detail-section">
      <h2 id="overview"><i class="fas fa-info-circle" aria-hidden="true"></i> What is {tNameEn}?</h2>
      <p data-i18n-en={tLongEn || tShortEn} data-i18n-zh={tLongZh || tShortZh}>{tLongEn || tShortEn}</p>
    </section>

    <section class="detail-section">
      <h2 id="our-take"><i class="fas fa-user-edit" aria-hidden="true"></i> Our take</h2>
      <p>{ourIntro}</p>
    </section>

    {screenshotImages.length > 0 && (
      <section class="detail-section">
        <h2 id="screenshots"><i class="fas fa-images" aria-hidden="true"></i> Screenshots</h2>
        <ScreenshotGallery images={screenshotImages} columns={screenshotImages.length >= 3 ? 3 : 2} />
      </section>
    )}

    <TestStatus data={editorial?.realTest} toolName={tNameEn} reviewed={isReviewed} testedVersion={editorial?.testedVersion} />

    {featureRowsEn.length > 0 && (
      <section class="detail-section">
        <h2 id="features"><i class="fas fa-star" aria-hidden="true"></i> Key features</h2>
        <FeatureTable rows={featureRowsEn} />
      </section>
    )}

    {tUseEn.length > 0 && (
      <section class="detail-section">
        <h2 id="use-cases"><i class="fas fa-rocket" aria-hidden="true"></i> Use cases that actually work</h2>
        <ul class="pros-list" data-i18n-en-rich={JSON.stringify(tUseEn)} data-i18n-zh-rich={JSON.stringify(tUseZh)}>
          {tUseEn.map(u => <li>{u}</li>)}
        </ul>
      </section>
    )}

    {tScenesEn.length > 0 && (
      <section class="detail-section">
        <h2 id="best-for"><i class="fas fa-bullseye" aria-hidden="true"></i> Best for</h2>
        <ul class="pros-list" data-i18n-en-rich={JSON.stringify(tScenesEn)} data-i18n-zh-rich={JSON.stringify(tScenesZh)}>
          {tScenesEn.map(s => <li>{s}</li>)}
        </ul>
      </section>
    )}

    {tAudienceEn.length > 0 && (
      <section class="detail-section">
        <h2 id="audience"><i class="fas fa-users" aria-hidden="true"></i> Target audience</h2>
        <div class="audience-tags" data-i18n-en-rich={JSON.stringify(tAudienceEn)} data-i18n-zh-rich={JSON.stringify(tAudienceZh)}>
          {tAudienceEn.map(a => <span class="audience-tag">{a}</span>)}
        </div>
      </section>
    )}

    <section class="detail-section pricing-section">
      <h2 id="pricing"><i class="fas fa-tag" aria-hidden="true"></i> Pricing</h2>
      {pricingSummaryEn
        ? <p data-i18n-en={pricingSummaryEn} data-i18n-zh={pricingSummaryZh}>{pricingSummaryEn}</p>
        : <p><span class="status-badge status-badge--pending"><i class="fas fa-hourglass-half" aria-hidden="true"></i> Pricing verified pending</span> See the official plan page for current pricing.</p>}
      <p class="pricing-note"><a href={tUrl} rel="nofollow noopener" target="_blank">Visit the official {tNameEn} pricing page →</a></p>
    </section>

    {tProsEn.length + tConsEn.length > 0 && (
      <section class="detail-section">
        <h2 id="pros-cons"><i class="fas fa-balance-scale" aria-hidden="true"></i> Pros &amp; Cons</h2>
        <ProsCons pros={tProsEn} cons={tConsEn} />
      </section>
    )}

    {tExampleEn && (
      <section class="detail-section">
        <h2 id="example"><i class="fas fa-terminal" aria-hidden="true"></i> Example</h2>
        <div class="example-box" data-i18n-en={tExampleEn} data-i18n-zh={tExampleZh}>{tExampleEn}</div>
      </section>
    )}

    <section class="detail-section verdict-block">
      <h2 id="verdict"><i class="fas fa-gavel" aria-hidden="true"></i> Our verdict</h2>
      <p><strong>Pick {tNameEn} if:</strong> {ourVerdict.best}</p>
      <p><strong>Skip {tNameEn} if:</strong> {ourVerdict.avoid}</p>
    </section>

    {toolMatchups.length > 0 && (
      <section class="detail-section">
        <h2 id="comparisons"><i class="fas fa-scale-balanced" aria-hidden="true"></i> Head-to-head comparisons</h2>
        <div class="comparison-grid">
          {toolMatchups.map(m => {
            const otherId = m.a === id ? m.b : m.a;
            const otherTool = toolsData[otherId];
            if (!otherTool) return null;
            const otherName = otherTool.name?.en || otherId;
            return (
              <a class="comparison-card" href={"/vs/" + m.slug + "/"}>
                <strong>{tNameEn}</strong> <span>vs</span> <strong>{otherName}</strong>
              </a>
            );
          })}
        </div>
        <p class="section-followup"><a href={"/alternatives/" + id + "/"}>See all {tNameEn} alternatives →</a></p>
      </section>
    )}

    {alternatives.length > 0 && (
      <section class="detail-section">
        <h2 id="alternatives"><i class="fas fa-exchange-alt" aria-hidden="true"></i> Alternatives to {tNameEn}</h2>
        <div class="tool-grid">
          {alternatives.map(([k, t]) => (
            <a class="tool-card" href={"/tool/" + k + "/"}>
              <div class="icon" aria-hidden="true"><i class={`fas ${t.icon || "fa-robot"}`}></i></div>
              <h3 data-i18n-en={t.name?.en || k} data-i18n-zh={t.name?.zh || t.name?.en || k}>{t.name?.en || k}</h3>
              <p data-i18n-en={t.short_desc?.en || ""} data-i18n-zh={t.short_desc?.zh || t.short_desc?.en || ""}>{t.short_desc?.en || ""}</p>
              <span class="tag">{categoryLabels[t.cat] || t.cat}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <ToolFAQ faqs={faqItems} />

    {relatedCategories.length > 0 && (
      <section class="detail-section related">
        <h2 id="related"><i class="fas fa-folder-open" aria-hidden="true"></i> Related categories</h2>
        <div class="related-grid">
          {relatedCategories.map(c => (
            <a class="related-card" href={"/best/" + c.slug + "/"}>
              <div class="related-icon" aria-hidden="true"><i class="fas fa-folder-open"></i></div>
              <div>
                <h3>{c.title_en}</h3>
                <p>{c.desc_en}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="detail-section editorial-disclosure">
      {isReviewed ? (
        <p>Curated by the AI Tool Hub editorial team{editorial?.updatedAt ? ` — last updated ${editorial.updatedAt}.` : "."} We publish real-test benchmark numbers only after running our standardized suite.</p>
      ) : (
        <p>This page is an AI-catalogued summary based on public information. Our editorial team has not yet completed a hands-on review; benchmark, pricing and verdict updates will be published after real testing.</p>
      )}
    </section>
    </div>
    <aside class="article-toc" aria-label="Table of contents">
      <div class="toc-title">On this page</div>
      <ol>
        {tocSections.map(s => <li><a href={"#" + s.id}>{s.label}</a></li>)}
      </ol>
    </aside>
  </div>
</article>
</BaseLayout>
