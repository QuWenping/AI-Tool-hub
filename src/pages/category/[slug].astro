---
import BaseLayout from "../../layouts/BaseLayout.astro";
import categories from "../../data/categories.json";
import toolsData from "../../data/tools.json";
export async function getStaticPaths() {
  return categories.map(cat => ({ params: { slug: cat.slug }, props: { cat } }));
}
const { cat } = Astro.props;
const categoryLabels = { text: "Writing", image: "Image", code: "Coding", video: "Video", audio: "Audio", productivity: "Productivity" };
const matchedTools = cat.tools
  .map(id => ({ id, ...toolsData[id] }))
  .filter(t => t && t.name);
const total = matchedTools.length;
const siteUrl = "https://thebestaitoolsreview.com";
const pageUrl = siteUrl + "/category/" + cat.slug + "/";
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": cat.title_en,
  "description": cat.desc_en,
  "url": pageUrl,
  "numberOfItems": total,
  "itemListElement": matchedTools.map((t, i) => ({
    "@type": "ListItem", "position": i + 1,
    "name": t.name?.en || t.id,
    "url": siteUrl + "/tool/" + t.id + "/"
  }))
};
const breadcrumb = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl + "/" },
    { "@type": "ListItem", "position": 2, "name": "Categories", "item": siteUrl + "/category/" },
    { "@type": "ListItem", "position": 3, "name": cat.title_en, "item": pageUrl }
  ]
};
const cleanTitle = cat.title_en.replace(/^Best\s+/i, "").replace(/\s+in\s+2026$/i, "");
---
<BaseLayout title={`${cleanTitle} — Complete Directory (${total} Tools)`} description={`${cat.desc_en} Browse all ${total} tools in this category.`} keywords={`${cleanTitle}, AI tools, ${cat.slug}`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}></script>
  </Fragment>
  <div class="page-container">
    <nav class="breadcrumbs"><a href="/">Home</a> &rsaquo; <a href="/category/">Categories</a> &rsaquo; <span>{cleanTitle}</span></nav>
    <h1 class="page-title">{cleanTitle}</h1>
    <p class="page-lede">{cat.desc_en} {total} tools listed below. For our ranked recommendations, see <a href={`/best/${cat.slug}/`}>Best {cleanTitle}</a>.</p>

    <div class="card-grid">
      {matchedTools.map(t => (
        <a class="list-card" href={`/tool/${t.id}/`}>
          <div class="card-head">
            <h3>{t.name?.en || t.id}</h3>
            <span class="tag-pill">{categoryLabels[t.cat] || t.cat || "AI"}</span>
          </div>
          <p class="card-desc">{t.short_desc?.en || ""}</p>
          <div class="tag-row">
            <span class="tool-pill">{t.pricing?.en || "Various"}</span>
            {(t.scenes?.en || []).slice(0, 2).map(s => <span class="tag-chip">{s}</span>)}
          </div>
        </a>
      ))}
    </div>

    <div class="list-footer">
      <p>Looking for our top picks? <a href={`/best/${cat.slug}/`}>See our ranked Best {cleanTitle} →</a></p>
    </div>
  </div>
</BaseLayout>
