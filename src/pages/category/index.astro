---
import BaseLayout from "../../layouts/BaseLayout.astro";
import categories from "../../data/categories.json";
import toolsData from "../../data/tools.json";
const siteUrl = "https://thebestaitoolsreview.com";
const breadcrumb = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl + "/" },
    { "@type": "ListItem", "position": 2, "name": "Categories", "item": siteUrl + "/category/" }
  ]
};
---
<BaseLayout title="AI Tool Categories — Browse All Categories" description="Browse all AI tool categories. Writing, coding, image, video, audio, productivity, and more. Find the right tools for your use case." keywords="AI tool categories, AI tools directory, browse AI tools">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}></script>
  </Fragment>
  <div class="page-container">
    <nav class="breadcrumbs"><a href="/">Home</a> &rsaquo; <span>Categories</span></nav>
    <h1 class="page-title">AI Tool Categories</h1>
    <p class="page-lede">{categories.length} categories covering {Object.keys(toolsData).length} AI tools. Browse by category, or see our <a href="/best/students/">ranked recommendations</a>.</p>

    <div class="card-grid">
      {categories.map(cat => {
        const count = cat.tools.filter(id => toolsData[id]).length;
        const cleanTitle = cat.title_en.replace(/^Best\s+/i, "").replace(/\s+in\s+2026$/i, "");
        return (
          <a class="list-card" href={`/category/${cat.slug}/`}>
            <div class="card-head">
              <h3>{cleanTitle}</h3>
              <span class="tool-pill">{count} tools</span>
            </div>
            <p class="card-desc">{cat.desc_en}</p>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
