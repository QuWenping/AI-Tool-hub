        columns: ["Option A", "Option B"],
        rows: [
          {label: "Ease of Use", values: [9, 7]},
          {label: "Price", values: [6, 9]},
          {label: "Features", values: [8, 6]},
          {label: "Support", values: [8, 7]}
        ]
      }} />


