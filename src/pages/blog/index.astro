---
import BaseLayout from "../../layouts/BaseLayout.astro";
import posts from "../../data/posts.json";
const sortedPosts = [...posts].sort((a, b) => b.date.localeCompare(a.date));
---
<BaseLayout title="Blog - AI Tool Hub" description="In-depth guides, rankings, and hands-on reviews of AI tools from the AI Tool Hub editorial team.">
  <article class="legal-page">
    <nav class="breadcrumbs"><a href="/">Home</a> &rsaquo; <span>Blog</span></nav>
    <header class="page-hero">
      <span class="eyebrow">Insights &amp; guides</span>
      <h1>Blog</h1>
      <p class="lede">In-depth guides, hands-on reviews, and curated rankings from the AI Tool Hub editorial team. Updated weekly.</p>
    </header>

    <section>
      <div class="related-grid">
        {sortedPosts.map(p => (
          <a class="related-card" href={"/blog/" + p.slug + "/"}>
            <div class="related-icon"><i class="fas fa-newspaper"></i></div>
            <div>
              <h3>{p.title_en}</h3>
              <p>{p.desc_en}</p>
              <p style="font-size: 12px; color: var(--text-mute); margin-top: 6px;">
                <i class="far fa-calendar"></i> {p.date} &middot; <i class="far fa-clock"></i> {p.read_time}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section style="margin-top: 40px; text-align: center;">
      <p style="color: var(--text-mute);">More articles coming soon. Have a topic suggestion? <a href="/contact/">Let us know</a>.</p>
    </section>
  </article>
</BaseLayout>
